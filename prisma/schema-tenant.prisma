// OneVity — TENANT schema (PostgreSQL, per-schema multi-tenant)
// Semua model domain HRIS. Tiap tenant = 1 PostgreSQL schema (tenant_<slug>).
// DDL di-generate ke prisma/tenant-ddl.sql lalu dieksekusi provisioning per tenant.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/tenant"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DB_URL")
}

// ============ ORGANIZATION DEFINITION ============

model Company {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  shortName String?
  taxId     String?
  address   String?
  city      String?
  phone     String?
  email     String?
  website   String?
  currency  String   @default("IDR")
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  orgUnits OrgUnit[]
  employees Employee[]
}

model OrgUnit {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  parentId   String?
  companyId  String
  level      Int      @default(1)
  headcountBudget Int @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  parent   OrgUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgTree")
  company  Company   @relation(fields: [companyId], references: [id])
  positions Position[]
  assignments EmployeeAssignment[]
}

// ============ POSITION DEFINITION ============

model Job {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  category    String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  positions Position[]
}

model Grade {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  minSalary Float    @default(0)
  maxSalary Float    @default(0)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)

  positions  Position[]
  assignments EmployeeAssignment[]
}

model Position {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  jobId       String?
  orgUnitId   String?
  gradeId     String?
  level       String?
  headcount   Int      @default(1)
  filled      Int      @default(0)
  reportsToId String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  job       Job?      @relation(fields: [jobId], references: [id])
  orgUnit   OrgUnit?  @relation(fields: [orgUnitId], references: [id])
  grade     Grade?    @relation(fields: [gradeId], references: [id])
  reportsTo Position? @relation("PositionTree", fields: [reportsToId], references: [id])
  directReports Position[] @relation("PositionTree")
  assignments EmployeeAssignment[]
}

// ============ EMPLOYEE INFORMATION ============

// Employee menyimpan data personal + lifecycle kepegawaan (joinDate/status).
// Seluruh data penempatan kerja (unit/posisi/grade/atasan/upah) disimpan di
// EmployeeAssignment sebagai riwayat berperiode — assignment aktif = validTo null.
model Employee {
  id            String   @id @default(cuid())
  employeeNo    String   @unique
  fullName      String
  gender        String   @default("M")
  birthPlace    String?
  birthDate     DateTime?
  nationalId    String? // NIK
  taxId         String? // NPWP
  bpjsHealth    String? // BPJS Kesehatan
  bpjsEmpSkill  String? // BPJS Ketenagakerjaan
  maritalStatus String?
  religion      String?
  bloodType     String?
  email         String?
  phone         String?
  address       String?
  city          String?
  photoUrl      String?
  bankName      String?
  bankAccount   String?

  // lifecycle kepegawaian (bukan riwayat penempatan)
  companyId     String
  joinDate      DateTime @default(now())
  endDate       DateTime?
  status        String   @default("Active") // Active|Resigned|Terminated|Blacklisted
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id])

  family       EmployeeFamily[]
  education    EmployeeEducation[]
  experiences  EmployeeExperience[]
  disciplinary DisciplinaryRecord[]
  actions      PersonnelAction[]
  activities   ActivityLog[]
  assignments  EmployeeAssignment[]
  managedAssignments EmployeeAssignment[] @relation("AssignmentManager")
  payrollProfile  EmployeePayrollProfile?
  loans          EmployeeLoan[]
  runLines       PayrollRunLine[]
  componentAssignments EmployeeComponentAssignment[]
  benefitClaims  BenefitClaim[]
}

// Riwayat penempatan kerja — setiap perubahan (mutasi/promosi/penyesuaian upah)
// menutup assignment lama (validTo) dan membuka assignment baru (validFrom).
model EmployeeAssignment {
  id              String    @id @default(cuid())
  employeeId      String
  orgUnitId       String?
  positionId      String?
  gradeId         String?
  managerId       String?
  employmentStatus String   @default("Permanent") // Permanent|Contract|Probation|Outsourcing
  workShift       String    @default("Regular")
  baseSalary      Float     @default(0)
  validFrom       DateTime  @default(now())
  validTo         DateTime? // null = penempatan aktif saat ini
  changeReason    String    @default("Initial") // Initial|Promotion|Demotion|Transfer|Mutation|SalaryAdjustment|ChangeStatus|ContractRenewal|ExtendProbation|ManualEdit
  sourceDocNo     String?   // PersonnelAction docNo (jika perubahan via PA)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  orgUnit  OrgUnit?  @relation(fields: [orgUnitId], references: [id])
  position Position? @relation(fields: [positionId], references: [id])
  grade    Grade?    @relation(fields: [gradeId], references: [id])
  manager  Employee? @relation("AssignmentManager", fields: [managerId], references: [id])

  @@index([employeeId, validTo])
  @@index([validTo])
}

model EmployeeFamily {
  id         String    @id @default(cuid())
  employeeId String
  relation   String // Spouse|Child|Parent|Sibling
  name       String
  gender     String    @default("M")
  birthDate  DateTime?
  occupation String?
  isDependent Boolean  @default(true)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeEducation {
  id          String   @id @default(cuid())
  employeeId  String
  level       String // SMA|D3|S1|S2|S3
  institution String
  major       String?
  startYear   Int?
  endYear     Int?
  gpa         Float?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeExperience {
  id         String   @id @default(cuid())
  employeeId String
  company    String
  position   String
  startDate  DateTime?
  endDate    DateTime?
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model DisciplinaryRecord {
  id          String    @id @default(cuid())
  employeeId  String
  warningLevel String   @default("Verbal") // Verbal|Written|Final
  violation   String
  sanction    String?
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime?
  notes       String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ============ PERSONNEL ACTION (workflow) ============

model PersonnelAction {
  id           String   @id @default(cuid())
  docNo        String   @unique
  employeeId   String
  type         String // Hire|Promotion|Demotion|Transfer|Mutation|SalaryAdjustment|ContractRenewal|ChangeStatus|ExtendProbation|Resignation|Termination|Retirement
  effectiveDate DateTime @default(now())
  reason       String?
  detailJson   String? // type-specific payload (new position, new salary, etc.)
  status       String   @default("Prepared") // Prepared|Submitted|Approved|Rejected|Processed|Cancelled
  currentLayer Int      @default(0)
  createdBy    String?
  createdAt    DateTime @default(now())
  submittedAt  DateTime?
  processedAt  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])
  layers   ApprovalLayer[]
  activities ActivityLog[]
}

model ApprovalLayer {
  id              String    @id @default(cuid())
  personnelActionId String
  layerNo         Int
  approverRole    String // e.g. "HR Manager", "Dept Head", "Director"
  approverId      String?  // AppUser id
  status          String    @default("Pending") // Pending|Approved|Rejected
  note            String?
  decidedAt       DateTime?

  personnelAction PersonnelAction @relation(fields: [personnelActionId], references: [id], onDelete: Cascade)
  approver        AppUser?       @relation(fields: [approverId], references: [id])
}

// ============ WAGE & ACCOUNTING RULES ============

// Master komponen upah — sejajar dengan "Salary Component" oranHR:
// klasifikasi wageType (13), incomeTaxMethod (8), formula, prorata, basis JAMSOSTEK,
// referensi SPT/natura, pasangan back-pay, dsb.
model WageComponent {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String   @default("Earning") // wageCategory: Earning|Deduction|Informational
  wageType    String   @default("Compensation") // BasicSalary|Compensation|CompensationNatura|Deduction|Overtime|Jamsostek|Loan|THPRounding|FinalTax|IncomeTax|Information|BackPay|ServiceCharge
  calcMethod  String   @default("Fixed") // Fixed|Formula|Percentage|Tax
  amount      Float    @default(0)
  formula     String? // ekspresi: BASE_SALARY*0.1, JHT_BASE*JHT_RATE_CO, dst.
  incomeTaxMethod String @default("Regular") // NonTaxable|Regular|Irregular|FixedRateFinal|SeveranceFinal|PensionFinal|PKP|Final2Years
  processMethod   String @default("GrossToNet") // GrossToNet|NetToGross
  roundingType    String @default("Nearest") // RoundingUp|RoundingDown|Nearest
  roundingValue   Int    @default(1)
  prorated    Boolean  @default(false)
  taxable     Boolean  @default(true)
  includeInBasicIncome Boolean @default(false)
  includeInTHP     Boolean @default(true)
  displayInPaySlip Boolean @default(true)
  applyThrRules    Boolean @default(false)
  jamsostekBasis   String? // JHT|JP|JKK|JKM|JPK — program JSTK yang jadi basis komponen ini
  sptReference     String? // kategori bukti potong 1721-A1
  naturaType       String? // kategori natura PP 68/2024
  wageCodeBackPay  String? // pasangan komponen back-pay
  accountDebitCode  String? // Salary Chart of Account: akun beban utk komponen Earning
  accountCreditCode String? // Salary Chart of Account: akun kewajiban utk komponen Deduction
  validFrom   DateTime @default(now())
  validTo     DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  templateItems   WageTemplateItem[]
  assignments     EmployeeComponentAssignment[]
  benefitTypes    BenefitType[]
}

// ============ PAYROLL MODULE ============

// Period payroll — multi jendela (payroll, TA/kehadiran) + atribut pajak bulan/tahun.
model PayrollPeriod {
  id          String   @id @default(cuid())
  code        String   @unique // 2026-09
  name        String // SEPTEMBER 2026
  payType     String   @default("Monthly") // Monthly|Weekly|BiWeekly
  startDate   DateTime
  endDate     DateTime
  taStartDate DateTime?
  taEndDate   DateTime?
  payPeriod   Int      @default(0) // urutan bulan (1-12)
  sptMonth    Int
  sptYear     Int
  processDate DateTime? // tanggal eksekusi payroll
  status      String   @default("Open") // Open|Processed|Closed|Locked
  notes       String?
  createdAt   DateTime @default(now())

  runs PayrollRun[]
  componentAssignments EmployeeComponentAssignment[]
  benefitClaims BenefitClaim[]
}

// Jenis proses payroll (multi-run per period): Salary, THR, Bonus, Termination, dst.
model ProcessType {
  id           String  @id @default(cuid())
  code         String  @unique // SALARY|THR|BONUS|...
  name         String
  sequence     Int     @default(0)
  calculateTax Boolean @default(true)
  active       Boolean @default(true)

  runs PayrollRun[]
  componentAssignments EmployeeComponentAssignment[]
}

// Paket komponen upah per karyawan (gaya "Wage Template" oranHR).
model WageTemplate {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())

  items    WageTemplateItem[]
  profiles EmployeePayrollProfile[]
}

model WageTemplateItem {
  id              String @id @default(cuid())
  wageTemplateId  String
  wageComponentId String
  sortOrder       Int    @default(0)

  wageTemplate  WageTemplate  @relation(fields: [wageTemplateId], references: [id], onDelete: Cascade)
  wageComponent WageComponent @relation(fields: [wageComponentId], references: [id])
}

// Data payroll per karyawan (NPWP, PTKP, metode proses, template) — 1-1 dengan Employee.
model EmployeePayrollProfile {
  id                      String   @id @default(cuid())
  employeeId              String   @unique
  npwp                    String?
  npwpSubmittedAt         DateTime?
  idtku                   String?
  hasNpwp                 Boolean  @default(true)
  processMethod           String   @default("GrossToNet") // GrossToNet|NetToGross
  paymentFrequency        String   @default("Monthly")
  wageTemplateId          String?
  taxStatus               String   @default("TK0") // TK0..TK3, K0..K3, KI0..KI3
  dependents              Int      @default(0)
  payrollDependentAllowed Boolean  @default(true)
  bankName                String?
  bankAccount             String?
  active                  Boolean  @default(true)

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  wageTemplate WageTemplate? @relation(fields: [wageTemplateId], references: [id])
}

// Bracket pajak progresif (UU HPP) + penalti non-NPWP — ber-dating.
model TaxBracket {
  id          String   @id @default(cuid())
  bracketType String   @default("Income") // Income|Severance|Pension
  lowerLimit  Float
  upperLimit  Float? // null = tanpa batas atas
  rateNpwp    Float    // 0.05
  rateNonNpwp Float    // 0.06
  validFrom   DateTime @default(now())
  validTo     DateTime?
}

// Tarif Efektif Rata-rata (PP 58/2023) — kategori A/B/C × rentang bruto bulanan.
model TerRate {
  id         String @id @default(cuid())
  category   String // A|B|C
  lowerLimit Float
  upperLimit Float?
  rate       Float // 0.0025
}

// Parameter regulasi payroll & BPJS per periode aturan.
model PayrollRegulation {
  id                   String   @id @default(cuid())
  code                 String   @unique
  name                 String
  validFrom            DateTime @default(now())
  validTo              DateTime?
  biayaJabatanRate     Float    @default(0.05)
  biayaJabatanCapMonthly Float  @default(500000)
  jhtEmployeeRate      Float    @default(0.02)
  jhtCompanyRate       Float    @default(0.037)
  jpEmployeeRate       Float    @default(0.01)
  jpCompanyRate        Float    @default(0.02)
  jpSalaryCap          Float    @default(10547400)
  jkkRate              Float    @default(0.0024)
  jkmRate              Float    @default(0.003)
  jpkCompanyRate       Float    @default(0.04)
  jpkEmployeeRate      Float    @default(0.01)
  jpkSalaryCap         Float    @default(12000000)
  nonNpwpSurcharge     Float    @default(0.2)
  useTer               Boolean  @default(false)
  active               Boolean  @default(true)
}

// Eksekusi payroll: 1 run = period × processType × sequence.
model PayrollRun {
  id             String    @id @default(cuid())
  runNo          String    @unique // PR-2026-09-SAL-01
  periodId       String
  processTypeId  String
  sequence       Int       @default(1)
  status         String    @default("Draft") // Draft|Calculated|Confirmed|Paid|Cancelled
  calculateTax   Boolean   @default(true)
  allEmployee    Boolean   @default(true)
  employeeCount  Int       @default(0)
  totalBruto     Float     @default(0)
  totalDeduction Float     @default(0)
  totalTax       Float     @default(0)
  totalNet       Float     @default(0)
  notes          String?
  calculatedAt   DateTime?
  confirmedAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  period      PayrollPeriod @relation(fields: [periodId], references: [id])
  processType ProcessType   @relation(fields: [processTypeId], references: [id])
  lines       PayrollRunLine[]
}

// Header hasil per karyawan per run — snapshot (seperti "Wage Transaction" oranHR):
// PTKP, bruto, potongan, pajak R/I, THP, identitas & penempatan saat proses.
model PayrollRunLine {
  id            String  @id @default(cuid())
  runId         String
  employeeId    String
  employeeNo    String // snapshot
  employeeName  String // snapshot
  orgUnitName   String?
  positionName  String?
  ptkpStatus    String
  ptkpValue     Float
  bruto         Float   @default(0)
  deduction     Float   @default(0)
  taxRegular    Float   @default(0)
  taxIrregular  Float   @default(0)
  net           Float   @default(0) // THP
  actualNetTax  Float?
  notes         String?

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])
  items    PayrollRunItem[]

  @@unique([runId, employeeId])
  @@index([employeeId])
}

// Rincian komponen upah per karyawan (snapshot kode/nama/klasifikasi/nilai).
model PayrollRunItem {
  id              String @id @default(cuid())
  lineId          String
  code            String
  name            String
  wageType        String
  type            String // wageCategory: Earning|Deduction|Informational
  incomeTaxMethod String
  amount          Float
  note            String?
  sortOrder       Int    @default(0)

  line PayrollRunLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
}

// Pinjaman karyawan — cicilan dipotong otomatis via komponen Loan.
model EmployeeLoan {
  id               String   @id @default(cuid())
  employeeId       String
  letterNo         String   @unique
  loanDate         DateTime @default(now())
  amount           Float
  installmentCount Int
  installmentAmount Float  @default(0)
  interestRate     Float    @default(0) // % per tahun (flat)
  startPaymentDate DateTime
  purpose          String?
  status           String   @default("Active") // Active|PaidOff|Cancelled
  paidAmount       Float    @default(0)
  outstanding      Float    @default(0)
  wageComponentCode String? // komponen potongan di payslip

  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  installments LoanInstallment[]
}

model LoanInstallment {
  id         String   @id @default(cuid())
  loanId     String
  sequence   Int
  periodCode String? // kode PayrollPeriod saat ditagih
  dueDate    DateTime
  amount     Float
  status     String   @default("Pending") // Pending|Deducted|Skipped
  deductedRunNo String?

  loan EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

// Komponen upah khusus per karyawan: Specific (one-off per period×processType)
// atau Periodic (nilai tetap tiap period).
model EmployeeComponentAssignment {
  id               String   @id @default(cuid())
  employeeId       String
  wageComponentId  String
  kind             String   @default("Specific") // Specific|Periodic
  amount           Float    @default(0)
  periodId         String?  // untuk Specific
  processTypeId    String?  // untuk Specific
  basedDate        DateTime?
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  wageComponent  WageComponent  @relation(fields: [wageComponentId], references: [id])
  period         PayrollPeriod? @relation(fields: [periodId], references: [id])
  processType    ProcessType?   @relation(fields: [processTypeId], references: [id])
}

// ============ PAYROLL JURNAL (P4 — Posting Otomatis) ============
// Jurnal payroll — di-generate otomatis saat run dikonfirmasi (pattern "Transfer to
// Accounting" oranHR: Journal No/Type/Date tercatat pada wage transaction).
model PayrollJournal {
  id          String   @id @default(cuid())
  journalNo   String   @unique // JV-2026-001
  journalDate DateTime
  runId       String?  @unique // 1-1 dengan PayrollRun
  runNo       String?
  description String?
  totalDebit  Float    @default(0)
  totalCredit Float    @default(0)
  status      String   @default("Posted") // Posted|Reversed
  createdAt   DateTime @default(now())

  lines PayrollJournalLine[]
}

// Baris jurnal — snapshot kode/nama akun & nominal saat posting.
model PayrollJournalLine {
  id          String   @id @default(cuid())
  journalId   String
  sequence    Int
  accountCode String
  accountName String
  position    String // Debit|Credit
  amount      Float
  memo        String?
  wageCode    String? // komponen asal (Salary Chart of Account)

  journal PayrollJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
}

model AccountGroup {
  id           String @id @default(cuid())
  code         String @unique
  name         String
  accountType  String @default("Expense") // Asset|Liability|Equity|Revenue|Expense
  accounts     Account[]
}

model Account {
  id            String @id @default(cuid())
  code          String @unique
  name          String
  accountGroupId String?
  balance       Float @default(0)

  accountGroup AccountGroup? @relation(fields: [accountGroupId], references: [id])
}

model PostingEvent {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  trigger   String   @default("PayrollRun") // event trigger
  debitAccountId  String?
  creditAccountId String?
  active    Boolean  @default(true)
}

// ============ EMPLOYEE BENEFIT (P5 — Benefit & Klaim) ============
// Jenis benefit (pola oranHR "BenefitType"): limit per siklus reset (bulanan/
// kuartalan/tahunan), auto-approve saat dalam limit, pay-in-payroll (dibayar via
// run payroll ProcessType BENEFIT) atau dibayar langsung dari kas.
model BenefitType {
  id            String   @id @default(cuid())
  code          String   @unique // MEDICAL|GLASSES|SPORT|WEDDING
  name          String
   category      String   @default("Umum") // Medical|Kesehatan|Transport|Rekreasi|Perayaan|Lainnya
  description   String?
  // Limit klaim per siklus reset (maxClaimAmount 0 + unlimited = tanpa limit).
  resetPeriod   String   @default("Monthly") // None|Monthly|Quarterly|Yearly
  maxClaimAmount Float   @default(0)
  unlimited     Boolean  @default(false)
  allowOverlimit Boolean @default(false) // klaim boleh melebihi limit (approval manual)
  needDocuments Boolean  @default(false)
  autoApproveInLimit Boolean @default(true)
  payInPayroll  Boolean  @default(true) // true → lewat run payroll; false → kas langsung
  wageComponentId String? // komponen upah di payslip saat pay-in-payroll
  entitleFor    String   @default("All") // All|Permanent|Contract|Probation
  validFrom     DateTime @default(now())
  validTo       DateTime?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  wageComponent WageComponent? @relation(fields: [wageComponentId], references: [id])
  claims        BenefitClaim[]
}

// Klaim benefit karyawan — lifecycle:
//   Pending →(approve)→ Approved →(schedule ke period)→ Scheduled →(run BENEFIT
//   dikonfirmasi)→ Paid  ·  payInPayroll=false: Approved →(kas)→ Paid
//   Pending →(reject)→ Rejected (dgn alasan); Pending/Approved/Scheduled → Cancelled.
// Snapshot audit limit (limitUsed/limitRemaining/inLimit) disimpan saat pengajuan.
model BenefitClaim {
  id            String   @id @default(cuid())
  claimNo       String   @unique // BC-2026-001
  benefitTypeId String
  employeeId    String
  claimDate     DateTime @default(now())
  amount        Float    // nilai diklaim
  approvedAmount Float   @default(0) // nilai disetujui (= amount saat approve)
  description   String?
  documentsNote String?  // daftar dokumen pendukung (bila needDocuments)
  status        String   @default("Pending") // Pending|Approved|Rejected|Scheduled|Paid|Cancelled
  limitUsed     Float    @default(0)
  limitRemaining Float   @default(0)
  inLimit       Boolean  @default(true)
  periodId      String?  // period payroll saat dibayar (pay-in-payroll)
  paidRunNo     String?
  approvedBy    String?
  approvedAt    DateTime?
  rejectedReason String?
  createdAt     DateTime @default(now())

  benefitType BenefitType    @relation(fields: [benefitTypeId], references: [id])
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period      PayrollPeriod? @relation(fields: [periodId], references: [id])
}

// ============ GENERAL SETTING (lookup) ============

model Lookup {
  id        String   @id @default(cuid())
  category  String // Religion|MaritalStatus|EmploymentStatus|BloodType|PAType|WarningLevel|Violation|EducationLevel
  code      String
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)

  @@unique([category, code])
}

// ============ SECURITY SETTING ============

model AppUser {
  id         String    @id @default(cuid())
  username   String    @unique
  fullName   String
  email      String?
  role       String    @default("HR Staff") // Admin|HR Manager|HR Staff|Approver|Viewer
  employeeId String?   // linked employee
  active     Boolean   @default(true)
  lastLogin  DateTime?

  accessGroups AccessGroupMember[]
  tempApprovals TemporaryApprover[] @relation("DelegationFrom")
  tempDelegations TemporaryApprover[] @relation("DelegationTo")
  approvalLayers ApprovalLayer[]
  activities  ActivityLog[]
}

model AccessGroup {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String?
  modulesJson String // JSON array of module permissions {module, view, create, edit, delete, approve}
  createdAt   DateTime @default(now())

  members AccessGroupMember[]
}

model AccessGroupMember {
  id            String @id @default(cuid())
  appUserId     String
  accessGroupId String
  isApprover    Boolean @default(false)

  appUser     AppUser     @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  accessGroup AccessGroup @relation(fields: [accessGroupId], references: [id], onDelete: Cascade)
}

// ============ MULTIPLE APPROVAL ============

model ApprovalTemplate {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  docType    String   @default("PersonnelAction")
  layersJson String   // [{layer:1, role:"Dept Head"},...]
  autoApprove Boolean @default(false) // auto approve when no approver found
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model TemporaryApprover {
  id          String   @id @default(cuid())
  approverId  String   // AppUser: original approver
  delegateId  String   // AppUser: delegate
  docType     String   @default("PersonnelAction")
  validFrom   DateTime
  validTo     DateTime
  reason      String?
  active      Boolean  @default(true)

  approver AppUser @relation("DelegationFrom", fields: [approverId], references: [id], onDelete: Cascade)
  delegate AppUser @relation("DelegationTo", fields: [delegateId], references: [id], onDelete: Cascade)
}

// ============ ACTIVITY TRAIL ============

model ActivityLog {
  id         String   @id @default(cuid())
  actorType  String   @default("user") // user|system
  appUserId  String?
  employeeId String?
  personnelActionId String?
  action     String // Created|Updated|Deleted|Submitted|Approved|Rejected|Processed|Cancelled
  entity     String // Employee|PersonnelAction|OrgUnit|...
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())

  appUser AppUser? @relation(fields: [appUserId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  personnelAction PersonnelAction? @relation(fields: [personnelActionId], references: [id])
}
