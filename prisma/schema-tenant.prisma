// RekanKerja — TENANT schema (PostgreSQL, per-schema multi-tenant)
// Semua model domain HRIS. Tiap tenant = 1 PostgreSQL schema (tenant_<slug>).
// DDL di-generate ke prisma/tenant-ddl.sql lalu dieksekusi provisioning per tenant.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/tenant"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DB_URL")
}

// ============ ORGANIZATION DEFINITION ============

model Company {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  shortName String?
  taxId     String?
  address   String?
  city      String?
  phone     String?
  email     String?
  website   String?
  currency  String   @default("IDR")
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  orgUnits       OrgUnit[]
  employees      Employee[]
  companyOffices CompanyOffice[]
  workLocations  WorkLocation[]
}

// Kantor perusahaan (branch office) — dimensi penempatan & kriteria approval.
model CompanyOffice {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  companyId String
  address   String?
  city      String?
  phone     String?
  npwp      String? // NPWP kantor — tiap kantor bisa berbeda utk pelaporan pajak (Jakarta ≠ Surabaya)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  company            Company              @relation(fields: [companyId], references: [id])
  workLocations      WorkLocation[]
  employees          Employee[]           @relation("EmployeeOffice")
  assignments        EmployeeAssignment[]
  approvalStructures ApprovalStructure[]  @relation("StructureOffice")
  accessRules        DataAccessRule[]     @relation("AccessRuleOffice")
  minimumWages       MinimumWage[]
  prs                PersonnelRequisition[] @relation("PrOffice")

  // F5-REC — baris rencana rekrutmen (RecruitmentPlan) per kantor
  recruitmentPlans   RecruitmentPlan[]  @relation("PlanOffice")

  // F4-REC — rekrutmen: penempatan kantor pada surat pengangkatan kandidat
  apptAppointments   CandidateAppointment[] @relation("ApptOffice")
}

// Lokasi kerja (site/plant) — dimensi penempatan & kriteria approval.
model WorkLocation {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  companyId    String
  officeId     String? // opsional: lokasi di bawah kantor tertentu
  address      String?
  city         String?
  active       Boolean  @default(true)
  // 27-a P0 — geofencing presensi: koordinat + radius lokasi kerja.
  // Dipakai mode Strict/Warn saat clock ESS (jarak haversine vs koordinat HP).
  latitude     Float? // lintang kantor (null = lokasi tak berpartisipasi geofence)
  longitude    Float? // bujur kantor
  radiusMeters Int? // radius absen sah (meter; null = 200 default)
  createdAt    DateTime @default(now())

  company            Company              @relation(fields: [companyId], references: [id])
  office             CompanyOffice?       @relation(fields: [officeId], references: [id])
  employees          Employee[]           @relation("EmployeeLocation")
  assignments        EmployeeAssignment[]
  approvalStructures ApprovalStructure[]  @relation("StructureLocation")
  accessRules        DataAccessRule[]     @relation("AccessRuleLocation")
  // F2-REC — slot lowongan rekrutmen (JobOpening.workLocation)
  openings           JobOpening[]         @relation("OpeningLocation")

  // F4-REC — rekrutmen: penempatan lokasi kerja pada pengangkatan kandidat
  apptAppointments   CandidateAppointment[] @relation("ApptLocation")
}

// Level jabatan (Staff/Supervisor/Manager/Director…) — master terpisah dari Grade.
model PositionLevel {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  positions          Position[]
  employees          Employee[]          @relation("EmployeePositionLevel")
  approvalStructures ApprovalStructure[] @relation("StructurePositionLevel")
  accessRules        DataAccessRule[]    @relation("AccessRulePositionLevel")
}

model OrgUnit {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  parentId        String?
  companyId       String
  level           Int      @default(1)
  headcountBudget Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  parent             OrgUnit?             @relation("OrgTree", fields: [parentId], references: [id])
  children           OrgUnit[]            @relation("OrgTree")
  company            Company              @relation(fields: [companyId], references: [id])
  positions          Position[]
  assignments        EmployeeAssignment[]
  employees          Employee[]           @relation("EmployeeOrgUnit")
  approvalStructures ApprovalStructure[]  @relation("StructureOrgUnit")
  accessRules        DataAccessRule[]     @relation("AccessRuleOrgUnit")
  prs                PersonnelRequisition[] @relation("PrOrgUnit")

  // F4-REC — rekrutmen: unit kerja pada surat pengangkatan kandidat
  apptAppointments   CandidateAppointment[] @relation("ApptOrgUnit")
}

// ============ POSITION DEFINITION ============

model Job {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  category    String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  positions Position[]

  // F1-REC — PR rekrutmen (dimensi diminta)
  prs PersonnelRequisition[] @relation("PrJob")
}

model Grade {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  minSalary Float   @default(0)
  maxSalary Float   @default(0)
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  positions          Position[]
  assignments        EmployeeAssignment[]
  employees          Employee[]           @relation("EmployeeGrade")
  approvalStructures ApprovalStructure[]  @relation("StructureGrade")
  accessRules        DataAccessRule[]     @relation("AccessRuleGrade")
}

model Position {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  jobId       String?
  orgUnitId   String?
  gradeId     String?
  level       String?
  headcount   Int      @default(1)
  filled      Int      @default(0)
  reportsToId String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  job             Job?                 @relation(fields: [jobId], references: [id])
  orgUnit         OrgUnit?             @relation(fields: [orgUnitId], references: [id])
  grade           Grade?               @relation(fields: [gradeId], references: [id])
  positionLevelId String?
  reportsTo       Position?            @relation("PositionTree", fields: [reportsToId], references: [id])
  directReports   Position[]           @relation("PositionTree")
  assignments     EmployeeAssignment[]

  positionLevel             PositionLevel?           @relation(fields: [positionLevelId], references: [id])
  employees                 Employee[]               @relation("EmployeePosition")
  approvalStructures        ApprovalStructure[]      @relation("StructurePosition")
  accessRules               DataAccessRule[]         @relation("AccessRulePosition")
  structureLevelsAsApprover ApprovalStructureLevel[] @relation("LevelApproverPosition")

  // F1-REC — PR rekrutmen (posisi yang diminta)
  prs PersonnelRequisition[] @relation("PrPosition")

  // F4-REC — rekrutmen: posisi penempatan pada pengangkatan kandidat
  apptAppointments CandidateAppointment[] @relation("ApptPosition")

  // F5-REC — baris rencana rekrutmen (RecruitmentPlan) untuk posisi ini
  recruitmentPlans RecruitmentPlan[] @relation("PlanPosition")

  // B4-BL — succession planning: register peran kritis pada posisi ini
  successionPosition SuccessionPosition? @relation("SuccessionPosition")
  // B5-BL — benchmark gaji pasar berkunci posisi ini (D-BL16/D-BL17)
  salaryBenchmarks SalaryBenchmark[] @relation("SalaryBenchmarkPosition")
}

// ============ EMPLOYEE INFORMATION ============

// Employee menyimpan data personal + lifecycle kepegawaan (joinDate/status).
// Seluruh data penempatan kerja (unit/posisi/grade/atasan/upah) disimpan di
// EmployeeAssignment sebagai riwayat berperiode — assignment aktif = validTo null.
model Employee {
  id            String    @id @default(cuid())
  employeeNo    String    @unique
  fullName      String
  gender        String    @default("M")
  birthPlace    String?
  birthDate     DateTime?
  // 28-c: NIK/NPWP/rekening DIENKRIPSI di DB (enc:v1:t:… — AES-256-GCM
  // per-tenant, field-crypto). Kolom tetap String? — nilai jadi enc:v1:t:….
  nationalId    String? // NIK
  taxId         String? // NPWP
  bpjsHealth    String? // BPJS Kesehatan
  bpjsEmpSkill  String? // BPJS Ketenagakerjaan
  maritalStatus String?
  religion      String?
  bloodType     String?
  email         String?
  phone         String?
  address       String?
  city          String?
  photoUrl      String?
  bankName      String?
  bankAccount   String? // no. rekening — terenkripsi (enc:v1:t:…)
  // Task 100 F1 (G30): foto referensi verifikasi wajah saat clock ESS — path
  // relatif storage (uploads/{slug}/…); foto PERTAMA kali dipakai sebagai
  // referensi bila karyawan belum punya.
  selfieRefUrl  String?

  // lifecycle kepegawaian (bukan riwayat penempatan)
  companyId String
  joinDate  DateTime  @default(now())
  endDate   DateTime?
  status    String    @default("Active") // Active|Resigned|Terminated|Blacklisted

  // ===== kontrak PKWT (PP 35/2021) — pelacakan jangka & perpanjangan =====
  contractStart DateTime? // mulai PKWT aktif
  contractEnd   DateTime? // akhir PKWT aktif (null = tanpa batas / PKS)
  renewalCount  Int       @default(0) // jumlah perpanjangan PKWT (generasi kontrak - 1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  // ===== parameter penempatan aktif (snapshot — parameter matching approval) =====
  // Didorong otomatis dari EmployeeAssignment aktif oleh service assignment;
  // menjadi dimensi pencocokan ApprovalStructure berjenjang.
  orgUnitId       String?
  positionId      String?
  gradeId         String?
  positionLevelId String?
  companyOfficeId String?
  workLocationId  String?

  orgUnit       OrgUnit?       @relation("EmployeeOrgUnit", fields: [orgUnitId], references: [id])
  position      Position?      @relation("EmployeePosition", fields: [positionId], references: [id])
  grade         Grade?         @relation("EmployeeGrade", fields: [gradeId], references: [id])
  positionLevel PositionLevel? @relation("EmployeePositionLevel", fields: [positionLevelId], references: [id])
  companyOffice CompanyOffice? @relation("EmployeeOffice", fields: [companyOfficeId], references: [id])
  workLocation  WorkLocation?  @relation("EmployeeLocation", fields: [workLocationId], references: [id])

  family               EmployeeFamily[]
  education            EmployeeEducation[]
  experiences          EmployeeExperience[]
  disciplinary         DisciplinaryRecord[]
  actions              PersonnelAction[]
  activities           ActivityLog[]
  assignments          EmployeeAssignment[]
  managedAssignments   EmployeeAssignment[]          @relation("AssignmentManager")
  payrollProfile       EmployeePayrollProfile?
  wageTemplateHistory  EmployeeWageTemplateHistory[]
  loans                EmployeeLoan[]
  runLines             PayrollRunLine[]
  componentAssignments EmployeeComponentAssignment[]
  benefitClaims        BenefitClaim[]
  scheduleAssignments  ScheduleAssignment[]
  clockLogs            AttendanceClockLog[]
  attendanceDailies    AttendanceDaily[]
  overtimeOrders       OvertimeOrder[]
  workoffPermissions   WorkOffPermission[]
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]
  leaveEncashments     LeaveEncashment[]
  travelRequests       TravelRequest[]
  travelClaims         TravelClaim[]
  medicalBalances      MedicalBalance[]
  medicalClaims        MedicalClaim[]
  medicalAdjustments   MedicalAdjustment[]
  documents            EmployeeDocument[]
  letters              LetterDocument[]
  letterRequests       LetterRequest[]
  offboardings         Offboarding[]
  onboardings          Onboarding[]

  // ===== wave 27: aset / pengumuman / tukar shift =====
  assetAssignments        AssetAssignment[]
  announcementReads       AnnouncementRead[]
  swapRequestsAsRequester ShiftSwapRequest[] @relation("SwapRequester")
  swapRequestsAsTarget    ShiftSwapRequest[] @relation("SwapTarget")

  // Task 100 F1 (G26): klaim open shift yang diajukan karyawan
  openShiftClaims OpenShiftClaim[]

  // relasi approval berjenjang
  structureLevelsAsApprover ApprovalStructureLevel[] @relation("LevelApproverEmployee")
  approvalStepsAsApprover   ApprovalStep[]           @relation("StepApproverEmployee")

  // F1-REC — modul Rekrutmen: PR yang diajukan / diampu officer / penggantian
  prsRequested       PersonnelRequisition[] @relation("PrRequester")
  prsAsOfficer       PersonnelRequisition[] @relation("PrOfficer")
  prsAsReplacement   PersonnelRequisition[] @relation("PrReplacement")

  // F2-REC — rekrutmen: penyusun JobOpportunity / perujuk pelamar / verifikator
  // lamaran publik staging.
  josPrepared        JobOpportunity[]       @relation("JoPreparer")
  applicantsReferred Applicant[]            @relation("ApplicantReferrer")
  publicAppsVerified PublicApplication[]    @relation("PaVerifier")

  // F3-REC — seleksi: pencatat nominasi kandidat / kandidat internal /
  // evaluator tahap / pengisi scorecard.
  candidatesNominated  JobCandidate[]           @relation("CandidateNominator")
  candidatesAsInternal  JobCandidate[]           @relation("CandidateInternalEmployee")
  stepsPerformed        CandidateSelectionStep[] @relation("StepPerformer")
  scorecardsEvaluated   CandidateScorecard[]     @relation("ScorecardEvaluator")

  // F4-REC — pengangkatan: atasan kandidat yang diangkat / karyawan hasil
  // rekrutmen (backlink Employee dari continueToOnboarding).
  apptSupervised      CandidateAppointment[]    @relation("ApptSupervisor")
  apptEmployees       CandidateAppointment[]    @relation("ApptEmployee")

  // F4-REC — offer yang dibuat karyawan ini (jejak pembuat)
  offersCreated       CandidateOffer[]          @relation("OfferCreator")

  // F5-REC — lamaran lowongan internal via ESS (MyJobOpportunity §2.10)
  empJobApplications  EmpJobApplication[]       @relation("EmpJobApplied")

  // F6-REC — AI: verifikator hasil parsing CV / pemicu skor AI kandidat
  cvParsesVerified   CvParseResult[]          @relation("CvParseVerifier")
  aiScoresGenerated  CandidateAiScore[]       @relation("AiScoreGenerator")

  // F7-REC — e-sign: peminta tanda tangan kandidat / preferensi notifikasi
  esignRequested     EsignRequest[]           @relation("EsignRequester")
  notificationPref   NotificationPref?         @relation("NotificationPrefEmployee")

  // F8-REC — analitik: tampilan laporan tersimpan milik karyawan ini
  savedReportViews   SavedReportView[]         @relation("SavedReportViewOwner")

  // F9-REC — compliance: penangan DSR pelamar
  dsrHandled       DataSubjectRequest[]      @relation("DsrHandler")

  // P9-PERF — compliance: DSR karyawan (data kinerja §7.3 UU PDP)
  dsrRequests      DataSubjectRequest[]      @relation("EmployeeDsr")

  // P0-PERF — modul Performance (DEVELOPMENT-PLAN-PERFORMANCE.md §15):
  // peserta penilaian / atasan penilai / reviewer 360 / pembina PIP / subjek
  // evaluasi masa percobaan.
  perfAppraisals       AppraisalRecord[]     @relation("PerfEmployee")
  perfManaged          AppraisalRecord[]     @relation("PerfManager")
  perf360Reviews       Feedback360[]         @relation("PerfReviewer")
  pipSubjected         PipPlan[]             @relation("PipEmployee")
  pipReviewed          PipPlan[]             @relation("PipReviewer")
  probEvaluations      ProbationEvaluation[] @relation("ProbEmployee")
  // B1-BL — OKR kuartalan: pemilik objective / pencatat progres KR terakhir.
  okrObjectives        OkrObjective[]        @relation("OkrOwner")
  okrKeyResults        OkrKeyResult[]        @relation("OkrUpdater")

  // B4-BL — succession planning: kandidat penerus (bisa di beberapa peran).
  successorCandidacies SuccessorCandidate[]  @relation("SuccessorEmployee")

  // AUD-DEPLOY (3-a H-3): hampir semua query modul memfilter status
  // ("Active" utk daftar payroll/attendance/leave) — seq scan per query.
  @@index([status])
}

// Riwayat penempatan kerja — setiap perubahan (mutasi/promosi/penyesuaian upah)
// menutup assignment lama (validTo) dan membuka assignment baru (validFrom).
model EmployeeAssignment {
  id               String    @id @default(cuid())
  employeeId       String
  orgUnitId        String?
  positionId       String?
  gradeId          String?
  managerId        String?
  employmentStatus String    @default("Permanent") // Permanent|Contract|Probation|Outsourcing
  workShift        String    @default("Regular")
  // 28-c: gaji pokok DIENKRIPSI (enc:v1:n:… — AES-256-GCM per-tenant).
  // Baca/tulis via field-crypto (encryptMoney/decryptMoney); plaintext
  // numerik pra-migrasi masih terbaca (decryptMoney legacy parse).
  baseSalary       String?
  validFrom        DateTime  @default(now())
  validTo          DateTime? // null = penempatan aktif saat ini
  changeReason     String    @default("Initial") // Initial|Promotion|Demotion|Transfer|Mutation|SalaryAdjustment|ChangeStatus|ContractRenewal|ExtendProbation|ManualEdit
  sourceDocNo      String? // PersonnelAction docNo (jika perubahan via PA)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  orgUnit         OrgUnit?       @relation(fields: [orgUnitId], references: [id])
  position        Position?      @relation(fields: [positionId], references: [id])
  grade           Grade?         @relation(fields: [gradeId], references: [id])
  companyOfficeId String?
  workLocationId  String?
  manager         Employee?      @relation("AssignmentManager", fields: [managerId], references: [id])
  companyOffice   CompanyOffice? @relation(fields: [companyOfficeId], references: [id])
  workLocation    WorkLocation?  @relation(fields: [workLocationId], references: [id])

  @@index([employeeId, validTo])
  @@index([validTo])
}

model EmployeeFamily {
  id          String    @id @default(cuid())
  employeeId  String
  relation    String // Spouse|Child|Parent|Sibling
  name        String
  gender      String    @default("M")
  birthDate   DateTime?
  occupation  String?
  isDependent Boolean   @default(true)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // AUD-DEPLOY (3-a M-13): include family per karyawan (profil payroll,
  // derivasi PTKP) tanpa seq scan.
  @@index([employeeId])
}

model EmployeeEducation {
  id          String  @id @default(cuid())
  employeeId  String
  level       String // SMA|D3|S1|S2|S3
  institution String
  major       String?
  startYear   Int?
  endYear     Int?
  gpa         Float?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeExperience {
  id         String    @id @default(cuid())
  employeeId String
  company    String
  position   String
  startDate  DateTime?
  endDate    DateTime?
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model DisciplinaryRecord {
  id           String    @id @default(cuid())
  employeeId   String
  warningLevel String    @default("Verbal") // Verbal|Written|Final
  violation    String
  sanction     String?
  issuedAt     DateTime  @default(now())
  expiresAt    DateTime?
  notes        String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ============ PERSONNEL ACTION (workflow) ============

model PersonnelAction {
  id            String    @id @default(cuid())
  docNo         String    @unique
  employeeId    String
  type          String // Hire|Promotion|Demotion|Transfer|Mutation|SalaryAdjustment|ContractRenewal|ChangeStatus|ExtendProbation|Resignation|Termination|Retirement
  effectiveDate DateTime  @default(now())
  reason        String?
  detailJson    String? // type-specific payload (new position, new salary, etc.)
  status        String    @default("Prepared") // Prepared|Submitted|Approved|Rejected|Processed|Cancelled
  currentLayer  Int       @default(0)
  createdBy     String?
  createdAt     DateTime  @default(now())
  submittedAt   DateTime?
  processedAt   DateTime?

  employee   Employee        @relation(fields: [employeeId], references: [id])
  layers     ApprovalLayer[]
  activities ActivityLog[]
}

model ApprovalLayer {
  id                String    @id @default(cuid())
  personnelActionId String
  layerNo           Int
  approverRole      String // e.g. "HR Manager", "Dept Head", "Director"
  approverId        String? // AppUser id
  status            String    @default("Pending") // Pending|Approved|Rejected
  note              String?
  decidedAt         DateTime?

  personnelAction PersonnelAction @relation(fields: [personnelActionId], references: [id], onDelete: Cascade)
  approver        AppUser?        @relation(fields: [approverId], references: [id])
}

// ============ APPROVAL STRUKTUR BERJENJANG (Task 25) ============
// Template alur persetujuan multi-level. Struktur dicocokkan ke KARYAWAN PEMOHON
// berdasarkan 6 dimensi penempatan (kantor, lokasi kerja, unit organisasi, posisi,
// grade, level jabatan) — null = cocok untuk semua. Bila beberapa struktur cocok,
// yang paling spesifik (kriteria terbanyak) dipakai.
// Khusus docType Loan/Medical/Travel, tiap level dapat memakai syarat nominal
// (minAmount/maxAmount) — level tambahan aktif hanya bila nominal masuk rentang.
model ApprovalStructure {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  docType         String // Leave|Travel|Medical|Loan|WorkOff
  companyOfficeId String?
  workLocationId  String?
  orgUnitId       String?
  positionId      String?
  gradeId         String?
  positionLevelId String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companyOffice CompanyOffice? @relation("StructureOffice", fields: [companyOfficeId], references: [id])
  workLocation  WorkLocation?  @relation("StructureLocation", fields: [workLocationId], references: [id])
  orgUnit       OrgUnit?       @relation("StructureOrgUnit", fields: [orgUnitId], references: [id])
  position      Position?      @relation("StructurePosition", fields: [positionId], references: [id])
  grade         Grade?         @relation("StructureGrade", fields: [gradeId], references: [id])
  positionLevel PositionLevel? @relation("StructurePositionLevel", fields: [positionLevelId], references: [id])

  levels ApprovalStructureLevel[]
  chains ApprovalChain[]

  @@index([docType, active])
}

// Satu jenjang dalam struktur. approverType:
//   ATASAN_LANGSUNG   — atasan langsung pemohon (EmployeeAssignment.managerId)
//   ATASAN_BERJENJANG — naik N tingkat dari pemohon (superiorLevel)
//   POSISI            — pemegang posisi tertentu (approverPositionId)
//   KARYAWAN          — karyawan tetap (approverEmployeeId)
//   HR_ADMIN          — petugas HR/admin workspace (siapa pun role ADMIN/OWNER/HR)
model ApprovalStructureLevel {
  id                 String  @id @default(cuid())
  structureId        String
  levelNo            Int // 1..n berjenjang
  approverType       String
  approverPositionId String?
  approverEmployeeId String?
  superiorLevel      Int? // ATASAN_BERJENJANG: jumlah tingkat naik (1 = atasan langsung)
  minAmount          Float? // level aktif bila nominal >= minAmount (Loan/Medical/Travel)
  maxAmount          Float? // level aktif bila nominal <= maxAmount (null = tanpa batas)
  note               String?

  structure        ApprovalStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  approverPosition Position?         @relation("LevelApproverPosition", fields: [approverPositionId], references: [id])
  approverEmployee Employee?         @relation("LevelApproverEmployee", fields: [approverEmployeeId], references: [id])

  @@index([structureId, levelNo])
}

// ============ APPROVAL CHAIN (runtime) ============
// Instance jalur persetujuan untuk satu dokumen (Leave/Travel/Medical/Loan).
// Dibuat saat dokumen diajukan; step = jenjang tersimpan (approver direkam sebagai
// label + id saat chain dibuat). currentLevel = jenjang yang menunggu keputusan.
model ApprovalChain {
  id           String    @id @default(cuid())
  docType      String
  docId        String
  structureId  String?
  employeeId   String // pemohon
  amount       Float?
  status       String    @default("InProgress") // InProgress|Approved|Rejected|Cancelled
  currentLevel Int       @default(1)
  totalLevels  Int       @default(0)
  createdBy    String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  structure ApprovalStructure? @relation(fields: [structureId], references: [id])
  steps     ApprovalStep[]

  @@unique([docType, docId])
  @@index([docType, status])
}

model ApprovalStep {
  id                   String    @id @default(cuid())
  chainId              String
  levelNo              Int
  approverType         String
  approverLabel        String // nama tampilan saat chain dibuat (mis. "Sri Wahyuni — HR Manager")
  approverEmployeeId   String?
  approverPositionCode String?
  minAmount            Float?
  maxAmount            Float?
  status               String    @default("Waiting") // Waiting|Current|Approved|Rejected|Skipped
  note                 String?
  decidedBy            String? // nama aktor keputusan
  decidedAt            DateTime?

  chain            ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  approverEmployee Employee?     @relation("StepApproverEmployee", fields: [approverEmployeeId], references: [id], onDelete: SetNull)

  @@index([chainId, levelNo])
}

// ============ WAGE & ACCOUNTING RULES ============

// Master komponen upah — sejajar dengan "Salary Component":
// klasifikasi wageType (13), incomeTaxMethod (8), formula, prorata, basis JAMSOSTEK,
// referensi SPT/natura, pasangan back-pay, dsb.
model WageComponent {
  id                   String    @id @default(cuid())
  code                 String    @unique
  name                 String
  type                 String    @default("Earning") // wageCategory: Earning|Deduction|Informational
  wageType             String    @default("Compensation") // BasicSalary|Compensation|CompensationNatura|Deduction|Overtime|Jamsostek|Loan|THPRounding|FinalTax|IncomeTax|Information|BackPay|ServiceCharge
  calcMethod           String    @default("Fixed") // Fixed|Formula|Percentage|Tax
  amount               Float     @default(0)
  formula              String? // ekspresi: BASE_SALARY*0.1, JHT_BASE*JHT_RATE_CO, dst.
  incomeTaxMethod      String    @default("Regular") // NonTaxable|Regular|Irregular|FixedRateFinal|SeveranceFinal|PensionFinal|PKP|Final2Years
  processMethod        String    @default("GrossToNet") // GrossToNet|NetToGross
  roundingType         String    @default("Nearest") // RoundingUp|RoundingDown|Nearest
  roundingValue        Int       @default(1)
  prorated             Boolean   @default(false)
  prorateBasis         String? // Task 64b — null/"Calendar" = hari kalender; "WorkingDays" = hari kerja jadwal (WorkSchedule + libur; fallback Sen–Jum)
  taxable              Boolean   @default(true)
  includeInBasicIncome Boolean   @default(false)
  includeInTHP         Boolean   @default(true)
  displayInPaySlip     Boolean   @default(true)
  applyThrRules        Boolean   @default(false)
  jamsostekBasis       String? // JHT|JP|JKK|JKM|JPK — program JSTK yang jadi basis komponen ini
  sptReference         String? // kategori bukti potong 1721-A1
  naturaType           String? // kategori natura PP 68/2024
  wageCodeBackPay      String? // pasangan komponen back-pay
  accountDebitCode     String? // Salary Chart of Account: akun beban utk komponen Earning
  accountCreditCode    String? // Salary Chart of Account: akun kewajiban utk komponen Deduction
  validFrom            DateTime  @default(now())
  validTo              DateTime?
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())

  templateItems WageTemplateItem[]
  assignments   EmployeeComponentAssignment[]
  benefitTypes  BenefitType[]
  rules         WageComponentRule[]
}

// Task 32 — ATURAN DIFERENSIASI BESARAN KOMPONEN UPAH.
// Rule menilai kondisi parameter karyawan (pekerjaan & personal) lalu
// mengubah besaran komponen utk karyawan yang cocok. Evaluasi: rule aktif
// diurut priority ASC (tie-break createdAt) — rule PERTAMA yang cocok
// menang; tanpa kecocokan → besaran dasar komponen. Presedensi penuh:
// assignment spesifik karyawan (Specific/Periodic) > rule > besaran dasar.
//   · conditions = JSON array [{ param, op, values }] — AND antar kondisi.
//     param: orgUnit|position|grade|positionLevel|office|workLocation|company|
//     employmentStatus|workShift|gender|religion|maritalStatus|bloodType|city|
//     ageYears|tenureYears|taxStatus|dependents|hasNpwp|employeeStatus
//     op: in|not_in|gt|gte|lt|lte|is_empty|not_empty
//   · actionType: SetAmount (jadi X) | AddAmount (+/- X) | Multiply (× X).
//     Rule diterapkan SEBELUM prorata & rounding (besaran rule = nominal penuh).
model WageComponentRule {
  id              String    @id @default(cuid())
  wageComponentId String
  name            String
  priority        Int       @default(100)
  conditions      String    @default("[]") // JSON array kondisi (AND)
  actionType      String    @default("SetAmount") // SetAmount|AddAmount|Multiply
  amount          Float     @default(0)
  notes           String?
  active          Boolean   @default(true)
  validFrom       DateTime  @default(now())
  validTo         DateTime?
  createdAt       DateTime  @default(now())

  wageComponent WageComponent @relation(fields: [wageComponentId], references: [id], onDelete: Cascade)
}

// ============ PAYROLL MODULE ============

// Period payroll — multi jendela (payroll, TA/kehadiran) + atribut pajak bulan/tahun.
model PayrollPeriod {
  id          String    @id @default(cuid())
  code        String    @unique // 2026-09
  name        String // SEPTEMBER 2026
  payType     String    @default("Monthly") // Monthly|Weekly|BiWeekly
  startDate   DateTime
  endDate     DateTime
  taStartDate DateTime?
  taEndDate   DateTime?
  payPeriod   Int       @default(0) // urutan bulan (1-12)
  sptMonth    Int
  sptYear     Int
  processDate DateTime? // tanggal eksekusi payroll
  status      String    @default("Open") // Open|Processed|Closed|Locked
  notes       String?
  createdAt   DateTime  @default(now())

  runs                 PayrollRun[]
  componentAssignments EmployeeComponentAssignment[]
  benefitClaims        BenefitClaim[]
}

// Jenis proses payroll (multi-run per period): Salary, THR, Bonus, Termination, dst.
model ProcessType {
  id           String  @id @default(cuid())
  code         String  @unique // SALARY|THR|BONUS|...
  name         String
  sequence     Int     @default(0)
  calculateTax Boolean @default(true)
  active       Boolean @default(true)

  runs                 PayrollRun[]
  componentAssignments EmployeeComponentAssignment[]
}

// Paket komponen upah per karyawan (gaya "Wage Template").
model WageTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  items    WageTemplateItem[]
  profiles EmployeePayrollProfile[]
  history  EmployeeWageTemplateHistory[]
}

model WageTemplateItem {
  id              String @id @default(cuid())
  wageTemplateId  String
  wageComponentId String
  sortOrder       Int    @default(0)

  wageTemplate  WageTemplate  @relation(fields: [wageTemplateId], references: [id], onDelete: Cascade)
  wageComponent WageComponent @relation(fields: [wageComponentId], references: [id])
}

// Data payroll per karyawan (NPWP, PTKP, metode proses, template) — 1-1 dengan Employee.
model EmployeePayrollProfile {
  id                      String    @id @default(cuid())
  employeeId              String    @unique
  // 28-c: NPWP & rekening profil payroll DIENKRIPSI di DB (enc:v1:t:…).
  npwp                    String?
  npwpSubmittedAt         DateTime?
  idtku                   String?
  hasNpwp                 Boolean   @default(true)
  processMethod           String    @default("GrossToNet") // GrossToNet|NetToGross
  paymentFrequency        String    @default("Monthly")
  wageTemplateId          String?
  taxStatus               String    @default("TK0") // TK0..TK3, K0..K3, KI0..KI3
  dependents              Int       @default(0)
  // Task 49: sumber status PTKP — "auto" = diturunkan dari data keluarga
  // (EmployeeFamily; pasangan → K, tanggungan Child/Parent max 3), disinkronkan
  // saat data keluarga berubah + refresh tahunan tiap 1 Januari; "manual" =
  // ditetapkan admin (mis. K/I — penghasilan pasangan digabung, tak dapat
  // diturunkan otomatis dari data keluarga).
  ptkpSource              String    @default("manual") // auto|manual
  payrollDependentAllowed Boolean   @default(true)
  bankName                String?
  bankAccount             String? // terenkripsi (enc:v1:t:…)
  active                  Boolean   @default(true)

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  wageTemplate WageTemplate? @relation(fields: [wageTemplateId], references: [id])
}

// Task 64 — riwayat template upah per karyawan (effective-dated, pola sama
// dengan EmployeeAssignment utk gaji): setiap pergantian template (Profil
// Payroll / PA promosi-mutasi) menutup baris lama (validTo = efektif − 1 µs)
// dan membuka baris baru (validFrom = efektif). Run payroll membaca versi
// BERLAKU pada period — kenaikan jabatan di tengah tahun tidak merusak run
// bulan sebelumnya. Baris dgn validTo null = versi aktif sekarang.
model EmployeeWageTemplateHistory {
  id             String    @id @default(cuid())
  employeeId     String
  wageTemplateId String?
  validFrom      DateTime  @default(now())
  validTo        DateTime?
  changeReason   String    @default("Initial") // Initial|Promotion|Demotion|Transfer|Mutation|ChangeStatus|ManualEdit|PersonnelAction
  sourceDocNo    String? // PersonnelAction docNo (jika via PA)
  notes          String?
  createdAt      DateTime  @default(now())

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  wageTemplate WageTemplate? @relation(fields: [wageTemplateId], references: [id])

  @@index([employeeId, validFrom])
}

// Bracket pajak progresif (UU HPP) + penalti non-NPWP — ber-dating.
model TaxBracket {
  id          String    @id @default(cuid())
  bracketType String    @default("Income") // Income|Severance|Pension
  lowerLimit  Float
  upperLimit  Float? // null = tanpa batas atas
  rateNpwp    Float // 0.05
  rateNonNpwp Float // 0.06
  validFrom   DateTime  @default(now())
  validTo     DateTime?
}

// Tarif Efektif Rata-rata (PP 58/2023) — kategori A/B/C × rentang bruto bulanan.
model TerRate {
  id         String @id @default(cuid())
  category   String // A|B|C
  lowerLimit Float
  upperLimit Float?
  rate       Float // 0.0025
}

// Parameter regulasi payroll & BPJS per periode aturan.
model PayrollRegulation {
  id                     String    @id @default(cuid())
  code                   String    @unique
  name                   String
  validFrom              DateTime  @default(now())
  validTo                DateTime?
  biayaJabatanRate       Float     @default(0.05)
  biayaJabatanCapMonthly Float     @default(500000)
  jhtEmployeeRate        Float     @default(0.02)
  jhtCompanyRate         Float     @default(0.037)
  jpEmployeeRate         Float     @default(0.01)
  jpCompanyRate          Float     @default(0.02)
  jpSalaryCap            Float     @default(10547400)
  jkkRate                Float     @default(0.0024)
  jkmRate                Float     @default(0.003)
  jpkCompanyRate         Float     @default(0.04)
  jpkEmployeeRate        Float     @default(0.01)
  jpkSalaryCap           Float     @default(12000000)
  // Task 52-c — JKP (Jaminan Kehilangan Pekerjaan, PP 6/2025): manfaat
  // diklaim pekerja saat PHK — checklist offboarding + surat keterangan.
  // F-01 BPA-AUDIT-53 — JKP PP 6/2025 Ps.11: TANPA iuran pekerja (0);
  // jkpCompanyRate 0,0014 = porsi rekomposisi JKK (informatif laporan BPJS,
  // bukan beban iuran baru).
  jkpEmployeeRate        Float     @default(0)
  jkpCompanyRate         Float     @default(0.0014)
  jkpSalaryCap           Float     @default(5000000)
  nonNpwpSurcharge       Float     @default(0.2)
  useTer                 Boolean   @default(false)
  active                 Boolean   @default(true)
}

// ============ UMP/UMK PER KANTOR ============
// Upah minimum per tahun per CompanyOffice (provinsi/kabupaten) — dipakai
// payroll engine memvalidasi gaji pokok karyawan yang ditempatkan di kantor
// tsb (PP 36/2021). companyOfficeId null = kebijakan default tenant.
model MinimumWage {
  id              String   @id @default(cuid())
  year            Int
  companyOfficeId String?
  label           String
  monthlyAmount   Float
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companyOffice CompanyOffice? @relation(fields: [companyOfficeId], references: [id])

  @@unique([year, companyOfficeId])
}

// Eksekusi payroll: 1 run = period × processType × sequence.
model PayrollRun {
  id             String    @id @default(cuid())
  runNo          String    @unique // PR-2026-09-SAL-01
  periodId       String
  processTypeId  String
  sequence       Int       @default(1)
  status         String    @default("Draft") // Draft|Calculated|Confirmed|Paid|Cancelled
  slipPassword   Boolean   @default(false) // slip email terkirim berpassword (default NIK)
  calculateTax   Boolean   @default(true)
  allEmployee    Boolean   @default(true)
  employeeCount  Int       @default(0)
  // 28-c: total uang run DIENKRIPSI (enc:v1:n:… — AES-256-GCM per-tenant).
  totalBruto     String?
  totalDeduction String?
  totalTax       String?
  totalNet       String?
  notes          String?
  calculatedAt   DateTime?
  confirmedAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  period      PayrollPeriod    @relation(fields: [periodId], references: [id])
  processType ProcessType      @relation(fields: [processTypeId], references: [id])
  lines       PayrollRunLine[]
  logs        PayrollRunLog[]

  // M-15 (audit 42): index period×processType — query terberat: dup-check run
  // aktif (payroll-runs.ts POST), GET runs?periodId=, markOvertimePaidForRun,
  // component-assignments POST (run final period+type) — dulu Seq Scan.
  @@index([periodId, processTypeId])
}

// M-20 (audit 42): keunikan run AKTIF per (period × jenis proses) —
// "partial unique index" PostgreSQL, TIDAK ter-ekspresi di Prisma schema:
//   CREATE UNIQUE INDEX uniq_payrollrun_active
//   ON "PayrollRun"("processTypeId","periodId") WHERE "status" <> 'Cancelled'
// DDL hidup di scripts/migrate-task43-indexes.ts (tenant existing) +
// provisioning.ts (tenant baru). Setelah cancel (status=Cancelled) run baru
// period+type sama boleh dibuat — index partial tidak menghalanginya.

// Header hasil per karyawan per run — snapshot (seperti "Wage Transaction"):
// PTKP, bruto, potongan, pajak R/I, THP, identitas & penempatan saat proses.
// Task 63 — log kejadian selama run payroll: parameter kurang (tanpa template
// upah / profil payroll / gaji), anomali data, atau info proses per karyawan.
// Satu baris per kejadian; dibaca tab Log di detail run (API payroll-run).
model PayrollRunLog {
  id           String   @id @default(cuid())
  runId        String
  employeeId   String?
  employeeNo   String? // snapshot (bisa null utk kejadian run-level)
  employeeName String?
  level        String   @default("warning") // warning|error|info
  code         String // NO_WAGE_TEMPLATE | NO_PAYROLL_PROFILE | NO_BASE_SALARY | NO_ACTIVE_ASSIGNMENT | SKIPPED | INFO
  message      String
  createdAt    DateTime @default(now())

  run PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model PayrollRunLine {
  id           String  @id @default(cuid())
  runId        String
  employeeId   String
  employeeNo   String // snapshot
  employeeName String // snapshot
  orgUnitName  String?
  positionName String?
  ptkpStatus   String
  ptkpValue    Float
  // 28-c: nilai uang line DIENKRIPSI (enc:v1:n:… — AES-256-GCM per-tenant;
  // engine tetap memakai number — de/enkripsi terjadi di service/API).
  bruto        String?
  deduction    String?
  taxRegular   String?
  taxIrregular String?
  net          String? // THP
  actualNetTax String?
  notes        String?
  // 26-b P0 — validasi UMP/UMK (PP 36/2021): gaji pokok < upah minimum
  // kantor penempatan. Warning edukatif NON-BLOKING — hitungan tetap sah.
  umkWarning   Boolean @default(false)
  umkJson      String? // {umk:{label,amount}, office, base, gap} — snapshot saat kalkulasi

  run      PayrollRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id])
  items    PayrollRunItem[]

  @@unique([runId, employeeId])
  @@index([employeeId])
}

// Rincian komponen upah per karyawan (snapshot kode/nama/klasifikasi/nilai).
model PayrollRunItem {
  id              String  @id @default(cuid())
  lineId          String
  code            String
  name            String
  wageType        String
  type            String // wageCategory: Earning|Deduction|Informational
  incomeTaxMethod String
  // 28-c: nilai komponen DIENKRIPSI (enc:v1:n:… — AES-256-GCM per-tenant).
  amount          String?
  note            String?
  sortOrder       Int     @default(0)

  line PayrollRunLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  // AUD-DEPLOY (3-a H-4): include items orderBy sortOrder per payslip/view/
  // email batch — tabel tumbuh ~20 item × karyawan × run/tahun.
  @@index([lineId])
}

// Pinjaman karyawan — cicilan dipotong otomatis via komponen Loan.
model EmployeeLoan {
  id                String   @id @default(cuid())
  employeeId        String
  letterNo          String   @unique
  loanDate          DateTime @default(now())
  amount            String // M-8 (44): uang terenkripsi enc:v1:n di rest
  installmentCount  Int
  installmentAmount String   @default("0") // M-8
  interestRate      Float    @default(0) // % per tahun (flat)
  startPaymentDate  DateTime
  purpose           String?
  status            String   @default("Active") // Active|PaidOff|Cancelled
  paidAmount        String   @default("0") // M-8
  outstanding       String   @default("0") // M-8
  wageComponentCode String? // komponen potongan di payslip

  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  installments LoanInstallment[]

  // AUD-DEPLOY (3-a M-13): engine payroll ambil pinjaman aktif per karyawan
  // (buildRunRows) + riwayat pinjaman per karyawan (UI transaksi).
  @@index([employeeId, status])
}

model LoanInstallment {
  id            String   @id @default(cuid())
  loanId        String
  sequence      Int
  periodCode    String? // kode PayrollPeriod saat ditagih
  dueDate       DateTime
  amount        String // M-8
  status        String   @default("Pending") // Pending|Deducted|Skipped
  deductedRunNo String?

  loan EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

// Komponen upah khusus per karyawan: Specific (one-off per period×processType)
// atau Periodic (nilai tetap tiap period).
model EmployeeComponentAssignment {
  id              String    @id @default(cuid())
  employeeId      String
  wageComponentId String
  kind            String    @default("Specific") // Specific|Periodic
  // 28-c: nilai komponen khusus DIENKRIPSI (enc:v1:n:… per-tenant).
  amount          String?
  periodId        String? // untuk Specific
  processTypeId   String? // untuk Specific
  basedDate       DateTime?
  notes           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  wageComponent WageComponent  @relation(fields: [wageComponentId], references: [id])
  period        PayrollPeriod? @relation(fields: [periodId], references: [id])
  processType   ProcessType?   @relation(fields: [processTypeId], references: [id])

  // M-15 (audit 42): composite dipilih dari query TERBERAT — buildRunRows
  // (payroll-service: active+kind Specific+periodId+processTypeId, tiap
  // kalkulasi run) dan transferToPayroll/leave/medical/travel deleteMany
  // (kind+periodId+processTypeId[+wageComponentId]) — dulu Seq Scan penuh.
  @@index([periodId, processTypeId, kind])
}

// ============ PAYROLL JURNAL (P4 — Posting Otomatis) ============
// Jurnal payroll — di-generate otomatis saat run dikonfirmasi (pattern "Transfer to
// Accounting": Journal No/Type/Date tercatat pada wage transaction).
model PayrollJournal {
  id          String   @id @default(cuid())
  journalNo   String   @unique // JV-2026-001
  journalDate DateTime
  runId       String?  @unique // 1-1 dengan PayrollRun
  runNo       String?
  description String?
  // 28-c: total jurnal DIENKRIPSI (enc:v1:n:… — AES-256-GCM per-tenant).
  totalDebit  String?
  totalCredit String?
  status      String   @default("Posted") // Posted|Reversed
  createdAt   DateTime @default(now())

  lines PayrollJournalLine[]
}

// Baris jurnal — snapshot kode/nama akun & nominal saat posting.
model PayrollJournalLine {
  id          String  @id @default(cuid())
  journalId   String
  sequence    Int
  accountCode String
  accountName String
  position    String // Debit|Credit
  // 28-c: nominal baris jurnal DIENKRIPSI (enc:v1:n:… — AES-256-GCM per-tenant).
  amount      String?
  memo        String?
  wageCode    String? // komponen asal (Salary Chart of Account)

  journal PayrollJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  // AUD-DEPLOY (3-a M-13): include lines orderBy sequence per jurnal.
  @@index([journalId])
}

model AccountGroup {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  accountType String    @default("Expense") // Asset|Liability|Equity|Revenue|Expense
  accounts    Account[]
}

model Account {
  id             String  @id @default(cuid())
  code           String  @unique
  name           String
  accountGroupId String?
  balance        Float   @default(0)

  accountGroup AccountGroup? @relation(fields: [accountGroupId], references: [id])
}

model PostingEvent {
  id              String  @id @default(cuid())
  code            String  @unique
  name            String
  trigger         String  @default("PayrollRun") // event trigger
  debitAccountId  String?
  creditAccountId String?
  active          Boolean @default(true)
}

// ============ EMPLOYEE BENEFIT (P5 — Benefit & Klaim) ============
// Jenis benefit (pola "BenefitType"): limit per siklus reset (bulanan/
// kuartalan/tahunan), auto-approve saat dalam limit, pay-in-payroll (dibayar via
// run payroll ProcessType BENEFIT) atau dibayar langsung dari kas.
model BenefitType {
  id                 String    @id @default(cuid())
  code               String    @unique // MEDICAL|GLASSES|SPORT|WEDDING
  name               String
  category           String    @default("Umum") // Medical|Kesehatan|Transport|Rekreasi|Perayaan|Lainnya
  description        String?
  // Limit klaim per siklus reset (maxClaimAmount 0 + unlimited = tanpa limit).
  resetPeriod        String    @default("Monthly") // None|Monthly|Quarterly|Yearly
  maxClaimAmount     Float     @default(0)
  unlimited          Boolean   @default(false)
  allowOverlimit     Boolean   @default(false) // klaim boleh melebihi limit (approval manual)
  needDocuments      Boolean   @default(false)
  autoApproveInLimit Boolean   @default(true)
  payInPayroll       Boolean   @default(true) // true → lewat run payroll; false → kas langsung
  wageComponentId    String? // komponen upah di payslip saat pay-in-payroll
  entitleFor         String    @default("All") // All|Permanent|Contract|Probation
  validFrom          DateTime  @default(now())
  validTo            DateTime?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())

  wageComponent WageComponent?    @relation(fields: [wageComponentId], references: [id])
  claims        BenefitClaim[]
  rules         BenefitTypeRule[]
}

// Task 33 — ATURAN DIFERENSIASI LIMIT KLAIM BENEFIT (P5) per parameter
// karyawan (cth. reimburse medis lebih besar utk level jabatan tertentu).
//   · actionType: SetLimit | AddLimit | Multiply terhadap maxClaimAmount.
model BenefitTypeRule {
  id            String    @id @default(cuid())
  benefitTypeId String
  name          String
  priority      Int       @default(100)
  conditions    String    @default("[]")
  actionType    String    @default("SetLimit") // SetLimit|AddLimit|Multiply
  amount        Float     @default(0)
  notes         String?
  active        Boolean   @default(true)
  validFrom     DateTime  @default(now())
  validTo       DateTime?
  createdAt     DateTime  @default(now())

  benefitType BenefitType @relation(fields: [benefitTypeId], references: [id], onDelete: Cascade)
}

// Klaim benefit karyawan — lifecycle:
//   Pending →(approve)→ Approved →(schedule ke period)→ Scheduled →(run BENEFIT
//   dikonfirmasi)→ Paid  ·  payInPayroll=false: Approved →(kas)→ Paid
//   Pending →(reject)→ Rejected (dgn alasan); Pending/Approved/Scheduled → Cancelled.
// Snapshot audit limit (limitUsed/limitRemaining/inLimit) disimpan saat pengajuan.
model BenefitClaim {
  id             String    @id @default(cuid())
  claimNo        String    @unique // BC-2026-001
  benefitTypeId  String
  employeeId     String
  claimDate      DateTime  @default(now())
  amount         String // nilai diklaim (M-8)
  approvedAmount String    @default("0") // nilai disetujui (= amount saat approve) (M-8)
  description    String?
  documentsNote  String? // daftar dokumen pendukung (bila needDocuments)
  status         String    @default("Pending") // Pending|Approved|Rejected|Scheduled|Paid|Cancelled
  limitUsed      String    @default("0") // M-8
  limitRemaining String    @default("0") // M-8
  inLimit        Boolean   @default(true)
  periodId       String? // period payroll saat dibayar (pay-in-payroll)
  paidRunNo      String?
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime  @default(now())

  benefitType BenefitType    @relation(fields: [benefitTypeId], references: [id])
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period      PayrollPeriod? @relation(fields: [periodId], references: [id])

  // AUD-DEPLOY (3-a M-13): daftar per status (UI klaim), histori per
  // karyawan, dan penjadwalan pay-in-payroll per period.
  @@index([status])
  @@index([employeeId])
  @@index([periodId])
}

// ============ GENERAL SETTING (lookup) ============

model Lookup {
  id        String  @id @default(cuid())
  category  String // Religion|MaritalStatus|EmploymentStatus|BloodType|PAType|WarningLevel|Violation|EducationLevel
  code      String
  label     String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  @@unique([category, code])
}

// T16-ATTACH — lampiran generik (kwitansi klaim travel/medical, dokumen
// karyawan, dst.). File fisik disimpan di {projectRoot}/uploads/{tenantSlug}/
// {yyyy}/{id}{ext}; baris ini menyimpan metadata + path relatif storage.
// entityType = TravelClaim | MedicalClaim | EmployeeDocument | …;
// entityId = id entitas pemilik (klaim/dokumen); saat upload pra-submit,
// entityId sementara berprefix "draft:" lalu di-rebind route submit klaim.
model Attachment {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  uploadedBy  String?
  createdAt   DateTime @default(now())

  employeeDocuments EmployeeDocument[]
  // F2-REC — dokumen pelamar (ApplicantDocument.attachment)
  applicantDocuments ApplicantDocument[] @relation("ApplicantDocAttachment")

  @@index([entityType, entityId])
}

// T16-ATTACH — dokumen kepegawaian (KTP/Paspor/SIM/KK/NPWP/Ijazah/…) milik
// karyawan; kedaluwarsa (SIM/Paspor) dipantau via filter ?expiring=n hari.
model EmployeeDocument {
  id           String    @id @default(cuid())
  employeeId   String
  docType      String // KTP|Paspor|SIM|KK|NPWP|Ijazah|Sertifikat|Kontrak|Lainnya
  docNumber    String?
  issuedAt     DateTime?
  expiresAt    DateTime?
  notes        String?
  attachmentId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attachment Attachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([expiresAt])
}

// ============ SECURITY SETTING ============

model AppUser {
  id                String    @id @default(cuid())
  username          String    @unique
  fullName          String
  email             String?
  role              String    @default("HR Staff") // Admin|HR Manager|HR Staff|Approver|Viewer
  employeeId        String? // linked employee
  active            Boolean   @default(true)
  lastLogin         DateTime?
  // Umur kata sandi (Task 33): kapan terakhir disetel/reset — dasar hitungan
  // kedaluwarsa (PasswordPolicy.lifetimeDays). Hash sandi tetap di platform User.
  passwordChangedAt DateTime?

  accessGroups    AccessGroupMember[]
  accessRules     DataAccessRule[]    @relation("AccessRuleUser")
  tempApprovals   TemporaryApprover[] @relation("DelegationFrom")
  tempDelegations TemporaryApprover[] @relation("DelegationTo")
  approvalLayers  ApprovalLayer[]
  activities      ActivityLog[]
  menuAccess      UserMenuAccess?     @relation("UserMenuAccess")
  passwordHistory PasswordHistory[]   @relation("PasswordHistory")
  notifications   Notification[]

  // AUD-DEPLOY (3-a H-3): AppUser.email dicari findFirst(by email) di SETIAP
  // request yang memakai guard menu/sesi (resolveMenuPerms, resolveMe,
  // requireMutator) — tanpa index ini = seq scan per request.
  @@index([email])
}

// Pusat notifikasi per AppUser (T7-ESS) — diisi lintas modul via helper
// pushNotification() (src/rekankerja/shared/services/notification-service.ts,
// fire-and-forget). kind = kategori emisi (mis. leave/travel/payroll),
// link = tujuan navigasi UI bila dibuka (opsional).
model Notification {
  id        String    @id @default(cuid())
  appUserId String
  title     String
  body      String?
  kind      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, createdAt])
}

// Kebijakan kata sandi per tenant (Task 33) — aturan validasi SANDI BARU saat
// admin menambah pengguna / reset / pengguna mengganti sendiri + umur &
// riwayat + lockout login. Singleton: satu baris aktif (active=true).
model PasswordPolicy {
  id     String  @id @default(cuid())
  active Boolean @default(true)

  // ---- kompleksitas ----
  minLength        Int     @default(8)
  maxLength        Int     @default(64)
  requireUppercase Boolean @default(true)
  requireLowercase Boolean @default(true)
  requireNumber    Boolean @default(true)
  requireSpecial   Boolean @default(true)
  minUniqueChars   Int     @default(4) // jumlah karakter unik minimum
  maxRepeated      Int     @default(3) // maksimum karakter sama berturut-turut (aaa)
  maxSequential    Int     @default(3) // maksimum urutan naik/turun (abc / 321)
  blockUsername    Boolean @default(true) // sandi tidak boleh mengandung username
  blockName        Boolean @default(true) // ... nama depan/belakang (>=3 huruf)
  blockCommon      Boolean @default(true) // daftar kata sandi umum + brand

  // ---- umur (lifetime) ----
  lifetimeDays Int @default(90) // 0 = tidak pernah kedaluwarsa
  warnDays     Int @default(7) // mulai peringatan N hari sebelum kedaluwarsa

  // ---- riwayat ----
  historyCount Int @default(6) // sandi baru tidak boleh sama dengan N terakhir

  // ---- percobaan login gagal ----
  maxFailedAttempts Int @default(5)
  lockoutMinutes    Int @default(15)

  // ---- sesi (Task 64k): batas idle sebelum sesi dimatikan client ----
  idleTimeoutMinutes Int @default(0) // 0 = nonaktif

  updatedById String? // AppUser admin terakhir menyimpan
  updatedAt   DateTime @updatedAt
}

// Riwayat kata sandi per pengguna aplikasi (Task 33) — hash N terakhir untuk
// larangan pakai ulang ("tidak boleh sama dengan 6 password terakhir").
// Baris = setiap kali sandi disetel (create/reset/change); dipangkas ke
// policy.historyCount terbaru.
model PasswordHistory {
  id        String   @id @default(cuid())
  appUserId String
  hash      String // scrypt salt+hash — sama format platform User.passwordHash
  setAt     DateTime @default(now())
  setById   String? // AppUser admin yang mereset (null = ganti sendiri)

  appUser AppUser @relation("PasswordHistory", fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, setAt])
}

// ================= EMAIL CONFIG (Task 34) =================
// Konfigurasi SMTP per tenant — sistem mengirim email otomatis saat ada
// pengajuan / persetujuan. Singleton: satu baris aktif.

model EmailConfig {
  id     String  @id @default(cuid())
  active Boolean @default(true) // master switch pengiriman otomatis

  // ---- SMTP ----
  smtpHost     String  @default("")
  smtpPort     Int     @default(587)
  smtpSecure   Boolean @default(false) // true = TLS implicit (port 465)
  smtpUser     String  @default("")
  smtpPassword String  @default("") // TIDAK pernah dikirim ke klien (masked)
  fromEmail    String  @default("")
  fromName     String  @default("RekanKerja HRIS")

  // status tes terakhir (tombol "Tes Kirim")
  lastTestOk      Boolean?
  lastTestAt      DateTime?
  lastTestMessage String?

  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Template email per EVENT pengajuan/approval — subject & body berisi
// placeholder {{nama}} {{docNo}} dst. Self-heal seed default bila belum ada.
model EmailTemplate {
  id     String  @id @default(cuid())
  event  String  @unique // leave.submitted | leave.approved | travel.claim.approved | ...
  label  String // "Cuti — Pengajuan Baru"
  active Boolean @default(true)

  // penerima default (bisa dimatikan per template)
  notifyEmployee Boolean @default(true) // pengaju / karyawan terkait
  notifyApprover Boolean @default(true) // atasan / approver jenjang
  notifyHrd      Boolean @default(false) // CC HRD (role HR Manager/Admin)

  subject String // "Persetujuan Cuti {{docNo}} — {{nama}}"
  body    String // teks multi-baris dengan placeholder

  updatedAt DateTime @updatedAt
}

// Audit trail pengiriman — muncul di tab "Riwayat Kirim".
model EmailLog {
  id        String   @id @default(cuid())
  event     String
  toEmail   String
  subject   String
  status    String // Sent | Failed | Skipped
  error     String?
  body      String? // preview hasil render
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event])
}

model AccessGroup {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  modulesJson String // JSON array of module permissions {module, view, create, edit, delete, approve}
  createdAt   DateTime @default(now())

  members     AccessGroupMember[]
  accessRules DataAccessRule[]    @relation("AccessRuleGroup")
}

// Skema akses data karyawan berbasis parameter (Task 30) — selaras pola
// ApprovalStructure berjenjang. Rule mendefinisikan SIAPA (subjek) boleh
// mengakses karyawan DENGAN penempatan tertentu (kriteria AND; semua kosong
// = akses penuh). Akses efektif = union semua rule cocok + otomatis:
// super admin (role Admin / platform OWNER|ADMIN) akses semua, atasan
// langsung akses bawahan aktif, dan setiap user akses data dirinya.
model DataAccessRule {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  // subjek pemegang hak akses
  subjectType   String // ROLE | USER | ACCESS_GROUP
  appUserId     String?
  accessGroupId String?
  role          String? // utk subjectType ROLE: Admin|HR Manager|HR Staff|Approver|Viewer

  // kriteria penempatan karyawan sasaran (semua terisi = AND)
  companyOfficeId  String?
  workLocationId   String?
  orgUnitId        String?
  positionId       String?
  gradeId          String?
  positionLevelId  String?
  employmentStatus String? // Permanent|Contract|Probation|Outsourcing

  priority  Int      @default(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appUser       AppUser?       @relation("AccessRuleUser", fields: [appUserId], references: [id])
  accessGroup   AccessGroup?   @relation("AccessRuleGroup", fields: [accessGroupId], references: [id])
  companyOffice CompanyOffice? @relation("AccessRuleOffice", fields: [companyOfficeId], references: [id])
  workLocation  WorkLocation?  @relation("AccessRuleLocation", fields: [workLocationId], references: [id])
  orgUnit       OrgUnit?       @relation("AccessRuleOrgUnit", fields: [orgUnitId], references: [id])
  position      Position?      @relation("AccessRulePosition", fields: [positionId], references: [id])
  grade         Grade?         @relation("AccessRuleGrade", fields: [gradeId], references: [id])
  positionLevel PositionLevel? @relation("AccessRulePositionLevel", fields: [positionLevelId], references: [id])

  @@index([subjectType, active])
}

// Hak akses MENU per pengguna (Task 31) — konfigurasi INDIVIDUAL, bukan per
// grup/role: tiap pengguna bisa berbeda hak meski level/role sama.
// mode "ALL" = semua menu (default bila baris tidak ada); mode "CUSTOM" =
// hanya menu dengan key di menusJson ("module:view", mis. "hr:directory",
// "payroll:runs", "settings:security"). Super admin (role Admin / platform
// OWNER|ADMIN) otomatis semua menu — tanpa baris konfigurasi.
model UserMenuAccess {
  id        String   @id @default(cuid())
  appUserId String   @unique
  mode      String   @default("ALL") // ALL | CUSTOM
  menusJson String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appUser AppUser @relation("UserMenuAccess", fields: [appUserId], references: [id], onDelete: Cascade)
}

model AccessGroupMember {
  id            String  @id @default(cuid())
  appUserId     String
  accessGroupId String
  isApprover    Boolean @default(false)

  appUser     AppUser     @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  accessGroup AccessGroup @relation(fields: [accessGroupId], references: [id], onDelete: Cascade)
}

// ============ MULTIPLE APPROVAL ============

model ApprovalTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  docType     String   @default("PersonnelAction")
  layersJson  String // [{layer:1, role:"Dept Head"},...]
  autoApprove Boolean  @default(false) // auto approve when no approver found
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model TemporaryApprover {
  id         String   @id @default(cuid())
  approverId String // AppUser: original approver
  delegateId String // AppUser: delegate
  docType    String   @default("PersonnelAction")
  validFrom  DateTime
  validTo    DateTime
  reason     String?
  active     Boolean  @default(true)

  approver AppUser @relation("DelegationFrom", fields: [approverId], references: [id], onDelete: Cascade)
  delegate AppUser @relation("DelegationTo", fields: [delegateId], references: [id], onDelete: Cascade)
}

// ============ ACTIVITY TRAIL ============

model ActivityLog {
  id                String   @id @default(cuid())
  actorType         String   @default("user") // user|system
  appUserId         String?
  employeeId        String?
  personnelActionId String?
  action            String // Created|Updated|Deleted|Submitted|Approved|Rejected|Processed|Cancelled
  entity            String // Employee|PersonnelAction|OrgUnit|...
  entityId          String?
  detail            String?
  createdAt         DateTime @default(now())

  appUser         AppUser?         @relation(fields: [appUserId], references: [id])
  employee        Employee?        @relation(fields: [employeeId], references: [id])
  personnelAction PersonnelAction? @relation(fields: [personnelActionId], references: [id])
}

// ============ TIME ATTENDANCE (ref: ANALISA-ATTENDANCE.md) ============

// Master tipe hari — padanan "Day Type": bentuk hari kerja
// (jam masuk/keluar, istirahat, toleransi) atau hari libur.
model WorkDayType {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  color                 String   @default("#99CCFF")
  category              String   @default("Workday") // Workday|Off|Holiday — kategori hari utk multiplier lembur
  timeIn                String? // "08:00" — null utk hari off/libur
  timeOut               String?
  nextDay               Boolean  @default(false) // shift lintas hari (mis. 22:00-06:00)
  breakMinutes          Int      @default(0)
  breakPaid             Boolean  @default(false)
  normalMinutes         Int      @default(0) // jam kerja normal per hari
  toleranceLateMinutes  Int      @default(0) // toleransi keterlambatan
  toleranceEarlyMinutes Int      @default(0) // toleransi pulang cepat
  flexible              Boolean  @default(false) // jam fleksibel — total jam dinormalkan
  needOvertimeOrder     Boolean  @default(true) // lembur wajib punya work order
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  scheduleDays       WorkScheduleDay[]
  dailyRecords       AttendanceDaily[]
  overtimeOrders     OvertimeOrder[]
  workoffPermissions WorkOffPermission[]
}

// Master jadwal kerja — padanan "Work Schedule": cycle berisi day type.
model WorkSchedule {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  cycleDays Int      @default(7) // panjang cycle (umumnya 7 hari)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days        WorkScheduleDay[]
  assignments ScheduleAssignment[]
}

// Baris cycle jadwal: sequence ke-N memakai day type tertentu.
model WorkScheduleDay {
  id         String @id @default(cuid())
  scheduleId String
  sequence   Int
  dayTypeId  String

  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayType  WorkDayType  @relation(fields: [dayTypeId], references: [id])

  @@unique([scheduleId, sequence])
}

// Penugasan jadwal per karyawan — padanan "Employee Schedule Assignment".
model ScheduleAssignment {
  id               String    @id @default(cuid())
  employeeId       String
  scheduleId       String
  anchorMonday     DateTime // Senin pertama cycle (anchor rotasi)
  anchorSequence   Int       @default(1) // sequence yang jatuh pada anchorMonday
  clockingRequired Boolean   @default(true) // false = non-clocking (jam dianggap normal)
  validFrom        DateTime  @default(now())
  validTo          DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule WorkSchedule @relation(fields: [scheduleId], references: [id])

  @@index([employeeId, validTo])
}

// Log presensi mentah — clock in/out manual/web (siap diperluas mesin & mobile).
model AttendanceClockLog {
  id         String   @id @default(cuid())
  employeeId String
  timestamp  DateTime
  direction  String   @default("IN") // IN|OUT
  source     String   @default("Manual") // Manual|Web|Mobile|Machine
  note       String?
  // T7-ESS: posisi clock via web/mobile (opsional — geolocation presensi).
  latitude   Float?
  longitude  Float?
  // Task 100 F1 (G13/G22/G30): bukti & verifikasi identitas saat clock —
  // selfieUrl = path relatif storage foto selfie; deviceId = fingerprint
  // perangkat klien; faceVerified = hasil perbandingan VLM vs foto referensi;
  // anomalyNotes = flag ringkas dipisah koma (mis. "speed", "dupgeo",
  // "qr-verified", "vlm-unavailable") utk deteksi anomali G27.
  selfieUrl    String?
  deviceId     String?
  faceVerified Boolean?
  anomalyNotes String?
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, timestamp])
  @@index([timestamp])
}

// Rekap harian per karyawan — padanan "Employee Clocking" hasil kalkulasi:
// hour buckets per kategori (menit) + status turunan utk UI.
model AttendanceDaily {
  id              String    @id @default(cuid())
  employeeId      String
  workDate        DateTime
  dayTypeId       String?
  state           String    @default("Prepared") // Prepared|Calculated|Revised
  status          String    @default("Present") // Present|Late|Absent|Off|Holiday|WorkOff|OnLeave
  presence        Int       @default(0) // 1 = hadir tercatat clocking
  checkIn         DateTime?
  checkOut        DateTime?
  lateMinutes     Int       @default(0)
  earlyMinutes    Int       @default(0)
  workMinutes     Int       @default(0) // total jam kerja tercatat
  normalMinutes   Int       @default(0) // jam kerja normal diakui
  absenceMinutes  Int       @default(0) // jam absen tak dibayar (lewat toleransi)
  overtimeMinutes Int       @default(0) // lembur terverifikasi (dari work order)
  // T5-TA-FIX (D-7): klasifikasi izin/cuti berbayar eksplisit — diisi regen dari
  // WorkOffPermission.paid (status WorkOff) / LeaveType.paid (status OnLeave);
  // recapPeriod membaca kolom ini (fallback notes utk baris lama belum ter-regen).
  paidFlag        Boolean?
  revised         Boolean   @default(false)
  revisedBy       String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayType  WorkDayType? @relation(fields: [dayTypeId], references: [id])

  @@unique([employeeId, workDate])
  @@index([workDate])
}

// Perintah lembur — padanan "Employee Overtime Work Order": Plan → Actual → Verified.
model OvertimeOrder {
  id              String    @id @default(cuid())
  orderNo         String    @unique // OT-2026-001
  employeeId      String
  overtimeDate    DateTime
  timeFrom        DateTime
  timeTo          DateTime
  planMinutes     Int       @default(0)
  actualMinutes   Int       @default(0)
  verifiedMinutes Int       @default(0) // jam lembur dibayar
  dayCategory     String    @default("Weekday") // Weekday|Weekend|Holiday — kategori multiplier
  rateMultiplier  Float     @default(1.5)
  calculationTime Boolean   @default(true) // true = actual dihitung dari clocking
  letterNo        String?
  reason          String?
  status          String    @default("Pending") // Pending|Approved|Rejected|Cancelled|Paid
  approverId      String?
  decidedAt       DateTime?
  decisionNote    String?
  paidRunNo       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDayType   WorkDayType? @relation(fields: [workDayTypeId], references: [id])
  workDayTypeId String?

  @@index([employeeId, overtimeDate])
  @@index([status])
}

// Izin tidak masuk — padanan "Employee Work Off Permission".
model WorkOffPermission {
  id           String    @id @default(cuid())
  docNo        String    @unique // WO-2026-001
  employeeId   String
  dateFrom     DateTime
  dateTo       DateTime
  allDay       Boolean   @default(true)
  timeFrom     String? // "08:00" bila setengah hari
  timeTo       String?
  dayTypeId    String?
  paid         Boolean   @default(true) // dibayar (gaji tetap masuk utk hari tsb)
  deductLeave  Boolean   @default(true) // potong saldo cuti
  recurrence   String?
  reason       String?
  documentNote String?
  status       String    @default("Pending") // Pending|Approved|Rejected|Cancelled
  approverId   String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayType  WorkDayType? @relation(fields: [dayTypeId], references: [id])

  @@index([employeeId, dateFrom])
  @@index([status])
}

// Pengaturan absensi singleton per tenant — padanan "Overtime Specified" +
// "User Defined Rounding" + kebijakan transfer ke payroll.
model AttendanceRule {
  id                               String   @id @default(cuid())
  roundingMinutes                  Int      @default(5) // pembulatan menit clocking ke kelipatan
  minOvertimeMinutes               Int      @default(30) // minimum menit agar dihitung lembur
  overtimeRoundingMinutes          Int      @default(30) // pembulatan jam lembur ke kelipatan
  // T15-CHAIN-EXT: cap lembur PP 35/2021 — maksimal jam per hari (default 4)
  // + cap opsional per bulan (null/0 = tanpa cap bulanan). Divalidasi saat
  // submit & approve perintah lembur (total per karyawan per tanggal/bulan).
  maxOvertimeHours                 Int      @default(4)
  maxOvertimeHoursMonthly          Int? // null/0 = tanpa cap bulanan
  nonClockingPolicy                String   @default("AssumeNormal") // AssumeNormal|ByHours|ByDays
  // peta komponen payroll (kode WageComponent — padanan "Overtime Specified")
  overtimeComponentCode            String   @default("LEMBUR")
  lateDeductionComponentCode       String   @default("TLATE")
  absenceDeductionComponentCode    String   @default("TABS")
  attendanceAllowanceComponentCode String   @default("TKEHADIRAN")
  attendanceAllowanceAmount        Float    @default(0) // tunjangan kehadiran penuh-hadir per bulan
  lateDeductionPerHour             Float    @default(0) // 0 = proporsional upah per jam (1/173)
  absenceDeductionPerDay           Float    @default(0) // 0 = 1/25 upah bulanan
  // 27-a P0 — geofencing presensi: Off = abaikan koordinat; Warn = catat
  // peringatan tapi clock tetap sah; Strict = tolak clock di luar radius.
  geofenceMode                     String   @default("Off") // Off|Warn|Strict
  // Task 100 F1 (G18) — geofence MULTI-SITE: cocokkan jarak ke SEMUA WorkLocation
  // aktif berlat/long (yang terdekat menang), bukan hanya lokasi karyawan.
  geofenceMultiSite                Boolean  @default(false)
  // Task 100 F1 (G13) — selfie saat clock: off = tak diminta; warn = tanpa foto
  // tetap jalan (flag); required = tolak clock tanpa foto.
  selfieMode                       String   @default("off") // off|warn|required
  // Task 100 F1 (G30) — verifikasi wajah (VLM z-ai) bila selfie dikirim:
  // off|warn (lanjut + flag bila beda)|strict (tolak clock bila beda orang).
  faceVerifyMode                   String   @default("off") // off|warn|strict
  // Task 100 F1 (G14) — mode cap lembur: PP35 = 4 j/hari + 18 j/mgg (Ps.26,
  // default); KEPMEN102 = Kepmen 102/2004 (3 j/hari + 14 j/mgg); CUSTOM =
  // pakai otCapDayHours/otCapWeekHours (null → fallback PP35).
  otCapMode                        String   @default("PP35") // PP35|KEPMEN102|CUSTOM
  otCapDayHours                    Int? // CUSTOM — cap harian (jam)
  otCapWeekHours                   Int? // CUSTOM — cap mingguan (jam)
  // AUD-OT (PP 35/2021 Pasal 31) — model minggu kerja perusahaan: 5 hari × 8
  // jam atau 6 hari × (7+40/6). Menentukan TABEL RATE upah lembur pada hari
  // istirahat mingguan / libur resmi (Ps.31 ayat (2) vs ayat (3)).
  otWorkweekDays                   Int      @default(5) // 5|6
  // AUD-OT (PP 35/2021 Pasal 32 ayat (3)) — dasar perhitungan upah lembur:
  // BASE = gaji pokok saja (default, kompatibel); BASE_FIXED = gaji pokok +
  // tunjangan tetap (100% upah sesuai statuta) — komponen dihitung dari
  // otBasisComponentCodes (Fixed amount / formula linear BASE_SALARY*k).
  otBasisMode                      String   @default("BASE") // BASE|BASE_FIXED
  otBasisComponentCodes            String? // "TJAB,TKEL,TTRANS,TMAKAN" (koma)
  // Task 100 F1 (G23) — fatigue rules: maks shift malam berturut-turut +
  // jeda istirahat minimum antar hari kerja (jam). 0 = nonaktif.
  fatigueMaxConsecutiveNights      Int      @default(4)
  fatigueMinRestHours              Int      @default(12)
  // Task 100 F1 (G16/G8-device) — API key perangkat presensi (device punch,
  // agen D): "ovdev_{slug}_{hex48}"; dibuat op regenDeviceKey (GET disembunyikan).
  deviceApiKey                    String?
  // Task 100 F1 (G29) — ambang burnout: rata-rata jam lembur per bulan (3 bulan
  // rolling) yang menghasilkan flag pada laporan anomali.
  burnoutOtHoursMonthly            Int      @default(40)
  updatedAt                        DateTime @updatedAt
}

// Task 100 F1 (G26) — open shift marketplace: posting shift kosong pada
// tanggal tertentu (jadwal + day type) utk diklaim karyawan sukarela.
model OpenShiftPost {
  id          String   @id @default(cuid())
  workDate    DateTime
  scheduleId  String
  dayTypeId   String
  orgUnitName String?
  slots       Int      @default(1)
  filled      Int      @default(0)
  status      String   @default("Open") // Open|Filled|Closed|Cancelled
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())

  claims OpenShiftClaim[]

  @@index([workDate])
  @@index([status])
}

// Task 100 F1 (G26) — pengajuan klaim open shift oleh karyawan (1 klaim
// aktif per karyawan per post; diputus admin: Pending→Approved|Rejected).
model OpenShiftClaim {
  id         String    @id @default(cuid())
  postId     String
  employeeId String
  status     String    @default("Pending") // Pending|Approved|Rejected
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  post     OpenShiftPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([postId, employeeId])
}

// T9-HOLIDAY — kalender hari libur (nasional/bersama/perusahaan). Overlay engine:
// tanggal yang terdaftar menang atas cycle jadwal → day type efektif kategori
// "Holiday" (multiplier lembur PP 35 2×/3×/4×, hari kerja cuti melewati hari libur).
model HolidayDate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  name      String
  kind      String   @default("National") // National|Joint(cuti bersama)|Company
  createdAt DateTime @default(now())

  @@unique([date, name]) // idempoten seed/import (ON CONFLICT DO NOTHING per date+name)
  @@index([date])
  @@index([kind])
}

// ============ LEAVE (Modul Cuti — padanan Leave Administration) ============

// Master jenis cuti — padanan "Leave Type" (LeaveTypeDetail.jsp, 40+ atribut
// diringkas ke atribut inti yang dipakai kalkulasi RekanKerja).
model LeaveType {
  id             String   @id @default(cuid())
  code           String   @unique // CT-THN, CT-NIKAH, CT-BESAR...
  name           String
  description    String?
  unit           String   @default("DAY") // DAY|MONTH — satuan saldo (Day(s)/Month(s))
  entitlement    Float    @default(0) // hak per periode
  maxPerRequest  Float    @default(0) // 0 = sama dengan entitlement
  paid           Boolean  @default(true) // cuti dibayar (absen berbayar → TA tidak memotong)
  cashable       Boolean  @default(false) // saldo bisa diuangkan (encashment → payroll)
  periodMode     String   @default("CALENDAR") // CALENDAR (1 Jan–31 Des) | ANNIVERSARY (per tgl join)
  prorateMonthly Boolean  @default(false) // earned akumulasi bulan berlalu × hak/12
  carryOverMax   Float    @default(0) // batas saldo bawa periode lalu (0 = tidak boleh bawa)
  waitingMonths  Int      @default(0) // masa kerja minimum sebelum cuti bisa diambil
  allowAdvance   Boolean  @default(false) // boleh saldo minus (advance leave)
  allowHalfDay   Boolean  @default(true) // boleh setengah hari (sesi AM/PM)
  needDocs       Boolean  @default(false) // perlu dokumen pendukung
  // Task 99 — policy engine v2 ringan (audit Leave G10, benchmark BreezeLeave):
  // notice period, batas hari kerja berturut lintas permintaan, dan periode
  // sibuk (blackout) per jenis cuti. 0/kosong = tanpa batas (kompatibilitas penuh).
  noticeDays         Int    @default(0) // minimal hari pemberitahuan sebelum tanggal mulai
  maxConsecutiveDays Float  @default(0) // batas hari kerja BERTURUT termasuk permintaan berdampingan (0 = bebas)
  blackoutDates      String @default("[]") // JSON [{from:"YYYY-MM-DD", to:"YYYY-MM-DD", note?}] — periode sibuk
  active         Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  balances    LeaveBalance[]
  requests    LeaveRequest[]
  encashments LeaveEncashment[]
  massLeaves  MassLeave[]
  rules       LeaveTypeRule[]
}

// Task 33 — ATURAN DIFERENSIASI ENTITLEMENT CUTI per parameter karyawan
// (pola sama dgn WageComponentRule Task 32; katalog parameter + matcher
// bersama di shared/lib/parameter-rules.ts).
//   · actionType: SetDays (hak = X hari) | AddDays (+/- X) | Multiply (× X)
//   · Evaluasi: priority ASC → rule pertama yang cocok menang; tanpa
//     kecocokan → entitlement dasar jenis cuti.
model LeaveTypeRule {
  id          String    @id @default(cuid())
  leaveTypeId String
  name        String
  priority    Int       @default(100)
  conditions  String    @default("[]") // JSON array kondisi (AND)
  actionType  String    @default("SetDays") // SetDays|AddDays|Multiply
  days        Float     @default(0)
  notes       String?
  active      Boolean   @default(true)
  validFrom   DateTime  @default(now())
  validTo     DateTime?
  createdAt   DateTime  @default(now())

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
}

// Saldo cuti per karyawan×jenis×tahun — padanan "Employee Leave Information".
// Kolom statis: (a) carriedOver, (c) adjustment, (e) cashed.
// (b) earned / (f) taken / (g) appliedNotTaken dihitung dinamis dari tanggal &
// request berstatus Approved/MassLeave — formula saldo:
//   balance = (a + b + c) − (d forfeited + e + f + g)
model LeaveBalance {
  id          String   @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  carriedOver Float    @default(0) // (a) saldo bawa dari periode lalu
  adjustment  Float    @default(0) // (c) penyesuaian manual/massal (±)
  cashed      Float    @default(0) // (e) hari yang diuangkan (encashment approved)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([year])
}

// Permintaan cuti — padanan "Leave Request" (form auto-compute) + baris hasil
// Mass Leave (status MassLeave, langsung efektif).
model LeaveRequest {
  id                 String    @id @default(cuid())
  docNo              String    @unique // LR-2026-001
  employeeId         String
  leaveTypeId        String
  year               Int // periode saldo yang dipakai
  requestDate        DateTime  @default(now())
  dateFrom           DateTime
  sessionFrom        String    @default("AM") // AM|PM — sesi mulai
  dateTo             DateTime
  sessionTo          String    @default("PM") // AM|PM — sesi selesai
  workingDays        Float     @default(0) // hari kerja terpakai (auto dari jadwal TA)
  balanceAtRequest   Float     @default(0) // saldo saat diajukan
  remainingAtRequest Float     @default(0) // saldo sesudah (bisa minus = advance)
  backToWorkDate     DateTime? // hari kerja pertama setelah cuti (auto)
  status             String    @default("Submitted") // Submitted|Approved|Rejected|Cancelled|MassLeave
  source             String    @default("Admin") // Admin|ESS|MassLeave
  reason             String?
  note               String?
  decidedById        String?
  decidedAt          DateTime?
  decisionNote       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, dateFrom])
  @@index([status])
  @@index([year])
}

// Uang pengganti cuti — padanan "Leave Encashment" + "Employee Leave Cashable".
// Approved → cashed bertambah; Transferred/Paid setelah masuk payroll run.
model LeaveEncashment {
  id               String    @id @default(cuid())
  docNo            String    @unique // LE-2026-001
  employeeId       String
  leaveTypeId      String
  year             Int
  requestDate      DateTime  @default(now())
  paymentDate      DateTime?
  days             Float     @default(0) // hari diuangkan
  amount           String    @default("0") // estimasi upah (hari × upah harian) (M-8)
  status           String    @default("Submitted") // Submitted|Approved|Rejected|Cancelled|Transferred|Paid
  periodCode       String? // period payroll target ( saat transfer)
  transferredRunNo String?
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([status])
  @@index([employeeId])
}

// Cuti massal per organisasi — padanan "Mass Leave" (SKB cuti bersama):
// generate baris LeaveRequest status MassLeave per karyawan pada rentang tanggal.
model MassLeave {
  id                String   @id @default(cuid())
  docNo             String   @unique // ML-2026-001
  leaveTypeId       String
  letterNo          String?
  dateFrom          DateTime
  dateTo            DateTime
  amount            Float    @default(1) // hari per tanggal per karyawan
  orgUnitName       String? // kosong = seluruh karyawan
  includeSubOrg     Boolean  @default(true)
  excludeNonWorking Boolean  @default(true) // lewati hari off/libur
  excludeConflicted Boolean  @default(true) // lewati yang sudah punya cuti
  note              String?
  generated         Int      @default(0) // jumlah karyawan ter-generate
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
}

// ============ TRAVEL ADMINISTRATION (ref: ANALISA-TRAVEL.md — 12 halaman) ============

// Zona wilayah perjalanan — padanan "Domestic Zone Definition" (LOCAL/JAWA BARAT/ASIA/OTHERS).
model TravelZone {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  overseas  Boolean  @default(false) // zona luar negeri → expense O-*
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destinations TravelDestination[]
}

// Task 98 (F1-1/F1-2) — tarif kota acuan SBI (PMK 32/2025) untuk estimasi
// perjalanan + per-diem otomatis: uang harian per hari trip + plafon hotel
// per malam. Nilai IDR (luar negeri = konversi kurs, lihat kolom note).
// Dipakai estimateTrip() di form pengajuan + saran baris ALLOWANCE klaim.
model TravelCityRate {
  id           String   @id @default(cuid())
  city         String   @unique
  country      String   @default("Indonesia")
  overseas     Boolean  @default(false)
  zoneCode     String? // zona master (LOCAL/JABAR/ASIA/…) — info tampilan
  uangHarian   Float    @default(0) // per HARI trip (acuan PMK 32/2025)
  plafonHotel  Float    @default(0) // per MALAM menginap
  note         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Template perjalanan — padanan "Travel Administration Template" (ClaimTmpl.jsp):
// settlementDay = batas hari settlement setelah kembali (default: 14).
model TravelTemplate {
  id               String   @id @default(cuid())
  code             String   @unique // TRAVEL|TRAVEL-LOCAL|TRAVEL-OVERSEAS|...
  name             String
  isDefault        Boolean  @default(false)
  description      String?
  settlementDay    Int      @default(14)
  settlementMethod String   @default("Kas") // Kas|Payroll
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requests TravelRequest[]
  claims   TravelClaim[]
}

// Jenis biaya + aturan — padanan "Travel Expense Definition" + "Definition Rules"
// (ExpenseDefinition.jsp + ExpenseDefinitionDesc.jsp): limit nominal, akun Debit/Kredit,
// komponen upah kompensasi (interface payroll "Compensation Wage").
model TravelExpenseType {
  id            String   @id @default(cuid())
  code          String   @unique // L-HOTEL|O-HOTEL|L-POCKET|E-GIFT|L-BBM|ADVANCE
  name          String
  kind          String   @default("GENERAL") // GENERAL|ALLOWANCE|MILEAGE|ENTERTAINMENT
  description   String?
  needDocs      Boolean  @default(false)
  // Rules (ExpenseDefinitionDesc):
  limitAmount   Float    @default(0) // 0 = tanpa limit nominal
  unlimited     Boolean  @default(false)
  currency      String   @default("IDR")
  compWageCode  String? // wage code kompensasi (padanan Compensation Wage)
  debitAccount  String? // akun beban (Expense Chart of Account)
  creditAccount String? // akun lawan (kas/utang)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rules TravelExpenseTypeRule[]
}

// Task 33 — ATURAN DIFERENSIASI LIMIT JENIS BIAYA TRAVEL per parameter
// karyawan (cth. limit hotel lebih tinggi utk manajemen senior).
//   · actionType: SetLimit | AddLimit | Multiply terhadap limitAmount.
model TravelExpenseTypeRule {
  id                  String    @id @default(cuid())
  travelExpenseTypeId String
  name                String
  priority            Int       @default(100)
  conditions          String    @default("[]")
  actionType          String    @default("SetLimit") // SetLimit|AddLimit|Multiply
  amount              Float     @default(0)
  notes               String?
  active              Boolean   @default(true)
  validFrom           DateTime  @default(now())
  validTo             DateTime?
  createdAt           DateTime  @default(now())

  travelExpenseType TravelExpenseType @relation(fields: [travelExpenseTypeId], references: [id], onDelete: Cascade)

  @@index([travelExpenseTypeId, active])
}

// Budget travel tahunan — padanan "Travel Budget" (TravelPeriod.jsp):
// total terpakai dihitung dari klaim Transferred; over-budget = warning (bukan blokir),
// sesuai perilaku nyata MII (2024: used > budget tetap diproses).
model TravelBudget {
  id          String   @id @default(cuid())
  year        Int      @unique
  startDate   DateTime
  endDate     DateTime
  currency    String   @default("IDR")
  totalBudget String   @default("0") // M-8
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items TravelBudgetItem[]
}

// Rincian budget per cost center — padanan detail "Budget Per Cost Center".
model TravelBudgetItem {
  id         String  @id @default(cuid())
  budgetId   String
  costCenter String
  amount     String  @default("0") // M-8
  note       String?

  budget TravelBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

// Permintaan perjalanan dinas — padanan "Travel Request" (TravelRequest.jsp):
// header + destinasi multi-kaki + uang muka (cash advance).
model TravelRequest {
  id               String    @id @default(cuid())
  docNo            String    @unique // TR-2026-001
  employeeId       String
  requestDate      DateTime  @default(now())
  dateFrom         DateTime
  dateTo           DateTime
  templateId       String
  costCenter       String?
  purpose          String
  remark           String?
  status           String    @default("Submitted") // Submitted|Approved|Rejected|Cancelled
  claimRequestedAt DateTime? // saat klaim pertama dibuat (padanan Is Claim Requested Yet)
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template     TravelTemplate      @relation(fields: [templateId], references: [id])
  destinations TravelDestination[]
  advances     TravelAdvance[]
  claims       TravelClaim[]

  // Task 98 (F0-7/B11) — index-sweep travel (dilewati index-sweep Task 42).
  @@index([employeeId])
  @@index([status])
  @@index([requestDate])
  @@index([status, employeeId])
}

// Kaki perjalanan — padanan "Travel Request/Claim Destination":
// kota + tanggal + zona + negara + flag overseas (menentukan expense L-*/O-*).
model TravelDestination {
  id        String   @id @default(cuid())
  requestId String
  seq       Int      @default(1)
  dateFrom  DateTime
  dateTo    DateTime
  city      String
  country   String   @default("Indonesia")
  zoneId    String?
  overseas  Boolean  @default(false)
  note      String?

  request TravelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  zone    TravelZone?   @relation(fields: [zoneId], references: [id])

  @@index([requestId])
}

// Uang muka perjalanan — padanan "Cash Advance" (request); dicairkan saat
// request disetujui final (status Given/givenAt), dibatalkan saat request
// ditolak/dibatalkan (Void); diselesaikan saat klaim settlement.
model TravelAdvance {
  id        String    @id @default(cuid())
  requestId String
  amount    String    @default("0") // M-8
  note      String?
  // M-3/B5 (T3-TRAVEL) lifecycle advance: Requested (request diajukan, belum
  // dicairkan) → Given (request disetujui final, givenAt terisi) → Void
  // (request ditolak/dibatalkan). Legacy rows default "Given".
  status    String    @default("Given")
  givenAt   DateTime?

  request TravelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([status])
}

// Klaim / settlement — padanan "Travel & Entertainment Settlement" (TravelClaim.jsp).
// Formula (T3-TRAVEL, fix B1/B2 double-count):
//   totalReimbursement = Σ baris biaya + exchangeLoss − otherCompanyExp
//   payableEmployee (b, UTRP) = max(0, totalReimbursement − advance)
//   payableCompany (c, TRVSTLIN) = max(0, advance − totalReimbursement)
//   totalSettlement = totalReimbursement (gross, sebanding total beban & jurnal)
// Status final "Transferred"/"Paid" setelah masuk payroll run (wage UTRP/TRVSTLIN).
model TravelClaim {
  id               String    @id @default(cuid())
  docNo            String    @unique // CL-2026-001
  requestId        String? // klaim mandiri tanpa request diperbolehkan
  employeeId       String
  claimDate        DateTime  @default(now())
  templateId       String
  costCenter       String?
  purpose          String?
  remark           String?
  status           String    @default("Submitted") // Submitted|Approved|Rejected|Cancelled|Transferred|Paid
  otherCompanyExp  String    @default("0") // (a) biaya dibayar pihak lain (kontra — tidak dibayar ke karyawan) (M-8)
  exchangeLoss     String    @default("0") // (a) rugi selisih kurs (M-8)
  payableEmployee  String    @default("0") // (b) dibayar ke karyawan (M-8)
  payableCompany   String    @default("0") // (c) dikembalikan ke perusahaan (M-8)
  totalSettlement  String    @default("0") // gross settlement = rincian + rugi kurs − (a) (M-8)
  settlementMethod String    @default("Kas")
  voucherNo        String?
  journalNo        String? // terisi saat approve → posting jurnal
  journalDate      DateTime?
  periodCode       String? // period payroll target saat transfer
  transferredRunNo String?
  paidRunNo        String?
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  request  TravelRequest?       @relation(fields: [requestId], references: [id])
  template TravelTemplate       @relation(fields: [templateId], references: [id])
  expenses TravelClaimExpense[]

  // Task 98 (F0-7/B11) — index-sweep travel.
  @@index([employeeId])
  @@index([status])
  @@index([requestId])
  @@index([periodCode])
  @@index([status, periodCode])
}

// Baris biaya klaim — padanan 4 tab (General Expense / Allowance / Mileage /
// Entertainment Expense + Guest) menjadi satu tabel dengan kind + limit check per jenis.
model TravelClaimExpense {
  id          String    @id @default(cuid())
  claimId     String
  expenseCode String
  kind        String    @default("GENERAL")
  expenseDate DateTime?
  description String?
  amount      String    @default("0") // M-8
  qty         Float     @default(1) // unit (hari utk allowance, km utk mileage)
  guestName   String? // Entertainment Guest — nama tamu/relasi
  overLimit   Boolean   @default(false) // amount > limit jenis (warning, tetap boleh)

  claim TravelClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([expenseCode])
}

// ============ MEDICAL BENEFIT (ref: ANALISA-MEDICAL.md) ============

// Jenis benefit medis — padanan "Medical Benefit Type" (MedicalBenefitTypeDetail.jsp,
// ±60 atribut → atribut kunci). Kebijakan limit: UNLIMITED | NOMINAL |
// FACTOR (× gaji pokok) | WAGE_COMPONENT. Kebijakan saldo tak terpakai akhir period:
// FORFEITED (hangus) | CASH (dibayar tunai via wage code → payroll UMC) | CARRY.
model MedicalBenefitType {
  id               String   @id @default(cuid())
  code             String   @unique // RAWAT_INAP
  name             String
  description      String?
  active           Boolean  @default(true)
  needReceipt      Boolean  @default(true)
  // W3-1 (fix G-2 BPA-medical): nomor surat rujukan dokter/RS wajib pada
  // pengajuan klaim jenis ini (pad letter_no — praktik rawat inap).
  needLetter       Boolean  @default(false)
  // limit benefit karyawan
  limitRule        String   @default("NOMINAL") // UNLIMITED|NOMINAL|FACTOR|WAGE_COMPONENT
  limitValue       Float    @default(0) // nominal (NOMINAL) atau faktor gaji (FACTOR)
  wageCode         String? // komponen upah dasar hitungan (WAGE_COMPONENT / info)
  // frekuensi klaim per period — W1-8 (fix M-5): EVERY_X_YEARS = freqValue tahun
  // berjalan (klaim diterima hanya bila tidak ada klaim dalam X tahun terakhir;
  // pad "Max Claim sekali dalam setiap X tahun" — Year Period).
  freqUnlimited    Boolean  @default(false)
  freqValue        Int      @default(0)
  freqPeriod       String   @default("YEAR") // MEDICAL|WORK|YEAR|EVERY_X_YEARS
  // pembayaran: company vs asuransi
  pctCompany       Int      @default(100)
  pctInsurance     Int      @default(0)
  insuranceCompany String?
  // saldo tak terpakai
  unusedRule       String   @default("FORFEITED") // FORFEITED|CASH|CARRY
  cashWageCode     String? // wage code jika CASH (padanan cash_wage_code)
  maxCarryOver     Float    @default(0)
  // kebijakan dependent (pasangan/anak)
  dependentEnabled Boolean  @default(true)
  maxDependents    Int      @default(2)
  maxChildAge      Int      @default(21)
  depLimitRule     String   @default("SHARED") // SHARED|TOTAL_SEPARATE|EACH
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  balances    MedicalBalance[]
  claims      MedicalClaim[]
  adjustments MedicalAdjustment[]
  rules       MedicalBenefitTypeRule[]
}

// Task 33 — ATURAN DIFERENSIASI PLAFON BENEFIT MEDIS per parameter karyawan.
//   · actionType: SetLimit | AddLimit | Multiply terhadap plafon hasil
//     kebijakan limitRule (NOMINAL/FACTOR/WAGE_COMPONENT).
model MedicalBenefitTypeRule {
  id                   String    @id @default(cuid())
  medicalBenefitTypeId String
  name                 String
  priority             Int       @default(100)
  conditions           String    @default("[]")
  actionType           String    @default("SetLimit") // SetLimit|AddLimit|Multiply
  amount               Float     @default(0)
  notes                String?
  active               Boolean   @default(true)
  validFrom            DateTime  @default(now())
  validTo              DateTime?
  createdAt            DateTime  @default(now())

  medicalBenefitType MedicalBenefitType @relation(fields: [medicalBenefitTypeId], references: [id], onDelete: Cascade)
}

// Rumah sakit & perusahaan asuransi — padanan Hospital.jsp + InsuranceCompany.jsp
// (2 halaman struktur identik → 1 model dengan kind).
model MedicalProvider {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  kind      String   @default("HOSPITAL") // HOSPITAL|INSURANCE
  city      String?
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  claimLines MedicalClaimLine[]
}

// Saldo medis karyawan per tahun × jenis — padanan "Employee Medical Information"
// (MedicalBenefitInformation.jsp + MyMedicalBenefitInformation.jsp ESS):
// Benefit Limit = kebijakan jenis dihitung saat generate (factor × gaji aktif);
// adjustment ± (Medical Adjustment), initialUsed saldo dibawa dari tahun lalu,
// used bertambah saat klaim Settled. Sisa = benefit + adjustment − used.
model MedicalBalance {
  id               String   @id @default(cuid())
  employeeId       String
  typeId           String
  year             Int
  benefitAmount    String   @default("0") // limit karyawan (dari kebijakan jenis) (M-8)
  adjustmentAmount String   @default("0") // penyesuaian karyawan (±) (M-8)
  initialUsed      String   @default("0") // used dibawa dari period lalu (Initial) (M-8)
  usedAmount       String   @default("0") // klaim karyawan settled (M-8)
  depBenefitAmount String   @default("0") // limit dependent (SHARED → 0) (M-8)
  depAdjustment    String   @default("0") // M-8
  depUsed          String   @default("0") // M-8
  carriedOver      String   @default("0") // sisa tahun lalu (kebijakan CARRY) (M-8)
  prorateFactor    Float?   // W1-8 — snapshot faktor prorata masa kerja saat saldo digenerate (null = 1.0)
  generatedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type     MedicalBenefitType @relation(fields: [typeId], references: [id])

  @@unique([employeeId, typeId, year])
  @@index([year])
}

// Klaim medis — padanan "Medical Claim" (MedicalBenefitClaim.jsp).
// Status: Draft(Prepared) → Submitted → Approved → Settled; Rejected/Cancelled.
// Snapshot saldo saat klaim (padanan Max Benefit/Used/Balance di header).
// Settled → jurnal otomatis + used saldo bertambah; jurnal dibuang bila dibatalkan.
model MedicalClaim {
  id             String    @id @default(cuid())
  docNo          String    @unique // MC-2026-001
  employeeId     String
  typeId         String
  year           Int
  claimDate      DateTime  @default(now())
  letterNo       String? // surat rujukan dokter
  state          String    @default("Draft") // Draft|Submitted|Approved|Rejected|Cancelled|Settled
  forDependent   Boolean   @default(false) // klaim untuk anggota keluarga
  // W1-8 — faktor prorata masa kerja yang dipakai menghitung plafon klaim ini
  // (1.0 = penuh; < 1 = prorata hari aktif/th — jejak audit kalkulasi plafon).
  prorateFactor  Float?
  maxBenefitAt   String    @default("0") // snapshot limit saat ajukan (M-8)
  usedAt         String    @default("0") // snapshot used saat ajukan (M-8)
  totalBill      String    @default("0") // Total Amount on Bill (M-8)
  totalReimburse String    @default("0") // Total Reimbursement Amount (M-8)
  totalApproved  String    @default("0") // Total Approved Amount (M-8)
  totalNonRe     String    @default("0") // Total Non Reimbursement (M-8)
  statusLog      Json      @default("[]") // [{state,at,by,note}] — padanan Status Log
  settleDate     DateTime?
  journalNo      String? // jurnal settlement (posting saat Settle)
  journalDate    DateTime?
  periodCode     String? // period payroll target saat transfer UMC terkait
  paidRunNo      String?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  settledById    String?
  // W4-1 (fix G-3 BPA-medical) — pelacakan piutang asuransi (padanan
  // "Paid By Insurance %"): jurnal settle memecah bagian asuransi ke piutang
  // 13xx; kolom ini mengelola siklusnya NONE → SUBMITTED → PAID / WRITTEN_OFF.
  insState       String    @default("NONE") // NONE|SUBMITTED|PAID|WRITTEN_OFF
  insRefNo       String?   // nomor klaim pada asuransi
  insAmount      String    @default("0") // snapshot piutang saat settle (terenkripsi)
  insSubmittedAt DateTime?
  insPaidAt      DateTime?
  insPaidAmount  String?   // nilai yang dibayarkan asuransi (terenkripsi)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type     MedicalBenefitType @relation(fields: [typeId], references: [id])
  lines    MedicalClaimLine[]
  // W1-4 — storno: klaim pembalik menunjuk klaim aslinya (1:1 — klaim settled
  // hanya boleh di-storno sekali; klaim pembalik snapshot −totalApproved).
  reversalOf    MedicalClaim?  @relation("MedicalStorno", fields: [reversalOfId], references: [id])
  reversalOfId  String?  @unique
  reversedBy    MedicalClaim?  @relation("MedicalStorno")

  @@index([state])
  @@index([year, typeId])
  // M-15 (audit 42): daftar klaim per karyawan (ESS claims, claimPoolAvailability,
  // generateSettleJournal) — dulu Seq Scan.
  @@index([employeeId])
}

// Baris perawatan — padanan tab "Claim Information" + wizard ESS:
// siapa dirawat, diagnosa, tanggal, CK (occupational injury), kwitansi, dokter,
// rumah sakit, jumlah tagihan/reimburse/approved/non-reimburse.
model MedicalClaimLine {
  id                 String    @id @default(cuid())
  claimId            String
  treatedName        String // nama yang dirawat (karyawan/dependent)
  treatment          String? // diagnosa / jenis perawatan
  treatmentDate      DateTime?
  receiptNo          String?
  physician          String?
  hospital           String?
  note               String?
  occupationalInjury Boolean   @default(false) // kecelakaan/penyakit kerja
  billAmount         String    @default("0") // M-8
  reimburseAmount    String    @default("0") // M-8
  approvedAmount     String    @default("0") // M-8
  nonReAmount        String    @default("0") // M-8
  currency           String    @default("IDR")
  // W1-6 (fix M-3) — rumah sakit/klinik dari master MedicalProvider (kind
  // HOSPITAL) — validasi aktif saat submit; `hospital` tetap snapshot nama.
  providerId         String?

  claim   MedicalClaim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  provider MedicalProvider? @relation(fields: [providerId], references: [id])

  @@index([providerId])

  // M-15 (audit 42): dedupe kwitansi lintas klaim saat submit klaim medis
  // (medical-service.ts: findMany receiptNo IN [...] + claim.employeeId) —
  // dulu Seq Scan seluruh baris perawatan.
  @@index([receiptNo])
}

// Penyesuaian saldo — padanan "Medical Adjustment" (MedicalBenefitAdjustment.jsp):
// ± amount utk karyawan atau dependent, dengan approval Approve|Reject|Cancel.
model MedicalAdjustment {
  id             String    @id @default(cuid())
  docNo          String    @unique // MA-2026-001
  employeeId     String
  typeId         String
  year           Int
  forDependent   Boolean   @default(false)
  amount         String // + tambah / − kurangi (M-8)
  adjustmentDate DateTime  @default(now())
  note           String?
  state          String    @default("Submitted") // Submitted|Approved|Rejected|Cancelled
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type     MedicalBenefitType @relation(fields: [typeId], references: [id])

  @@index([state])
}

// ============ PUBLIC API & WEBHOOK (T18-API) ============

// Kunci API per tenant untuk REST API publik (header x-api-key).
// Kunci asli TIDAK PERNAH disimpan — hanya hash SHA-256; prefix (12 karakter
// pertama) dipakai display + identitas aktor audit "apikey:{prefix}".
model ApiKey {
  id         String    @id @default(cuid())
  name       String // label kunci (mis. "Integrasi Absensi")
  prefix     String // 12 karakter pertama kunci — display
  keyHash    String    @unique // SHA-256 hex kunci penuh
  scopes     String    @default("employees") // csv: employees,leave,payroll
  lastUsedAt DateTime? // diperbarui verifyApiKey (fire-and-forget)
  createdAt  DateTime  @default(now())
  revokedAt  DateTime? // null = aktif; terisi = kunci dicabut (401)
}

// Endpoint webhook per tenant — POST otomatis saat event HRIS terjadi
// (leave/payroll/workoff). Tanda tangan HMAC-SHA256(secret, body) dikirim
// pada header X-RekanKerja-Signature supaya penerima bisa memverifikasi asal.
model Webhook {
  id        String   @id @default(cuid())
  url       String // endpoint https://… penerima
  events    String // csv: leave.submitted,leave.approved,payroll.confirmed,payroll.paid,workoff.approved
  secret    String // secret HMAC (auto-generate, bisa diganti)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  logs WebhookLog[]
}

// Riwayat pengiriman webhook — housekeeping: maks 500 baris per tenant
// (terlama dihapus saat dispatch menulis baris baru melampaui batas).
// T41-M14 (retry/backoff): status kini pending|delivered|failed|dead —
// kegagalan kirim dijadwalkan ulang (nextRetryAt) dengan backoff
// 5m→30m→2h→6h→24h maks 5 percobaan (percobaan ke-5 gagal → dead).
// Baris lama pra-migrasi memakai nilai legacy Sent/Failed (tanpa retry —
// nextRetryAt NULL tidak pernah diambil job webhook-retry).
model WebhookLog {
  id             String    @id @default(cuid())
  webhookId      String
  event          String
  payload        String // body JSON persis yang dikirim (utk audit/verifikasi & retry)
  status         String    @default("delivered") // delivered | failed | dead (+ pending, legacy Sent)
  responseStatus Int? // HTTP status penerima (null bila tak sampai/timeout)
  error          String?
  attempts       Int       @default(1) // total percobaan kirim (dispatch + retry), maks 5
  nextRetryAt    DateTime? // jadwal retry berikutnya (null = tidak dijadwalkan)
  lastError      String? // pesan galat percobaan terakhir (kolom error = percobaan pertama)
  createdAt      DateTime  @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([webhookId, createdAt])
}

// ============ TEMPLATE SURAT & DOKUMEN SURAT (HR letters) ============
// Template surat resmi perusahaan — bisa DIEDIT per tenant agar sesuai
// template surat perusahaan masing-masing. Dipakai untuk:
//   · Disciplinary  → surat teguran / surat peringatan (SP)
//   · PersonnelAction → surat keputusan per jenis aksi (promosi, mutasi, PHK, dst.)
// Isi template memakai placeholder {{token}} yang diganti data aktual saat
// surat diterbitkan. Surat terbit disimpan sebagai SNAPSHOT (LetterDocument)
// supaya audit tetap utuh meski template kemudian diedit.

model LetterTemplate {
  id             String   @id @default(cuid())
  key            String   @unique // DISC_VERBAL | DISC_WRITTEN | DISC_FINAL | PA_PROMOTION | ...
  category       String // Disciplinary | PersonnelAction
  name           String
  description    String?
  subject        String? // perihal surat (opsional)
  body           String // isi surat — teks + {{placeholder}}
  signatoryName  String? // nama penanda tangan (kosong = garis tanda tangan)
  signatoryTitle String // jabatan penanda tangan
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LetterDocument {
  id                   String   @id @default(cuid())
  refNo                String   @unique // 001/HR-DIS/X/2026
  templateKey          String
  category             String // Disciplinary | PersonnelAction
  employeeId           String
  personnelActionId    String? // dokumen PA sumber (tanpa FK — snapshot audit)
  disciplinaryRecordId String? // catatan disiplin sumber (tanpa FK — snapshot audit)
  subject              String?
  body                 String // snapshot isi surat SUDAH dirender (utk audit & cetak ulang)
  metaJson             String? // konteks saat terbit (nama template, versi, dsb.)
  issuedAt             DateTime @default(now())
  createdById          String? // AppUser id penerbit (plain — trail saja)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, category])
  @@index([personnelActionId])
}

// ============ PERMINTAAN SURAT (ESS → HR) ============
// Karyawan meminta surat layanan dari ESS (SK Keterangan Kerja, SK Gaji,
// SK Pengalaman Kerja, Referensi, Perjanjian Kerja). HR memutuskan:
// setujui → terbitkan LetterDocument (PDF terkirim ke ESS) / tolak dgn alasan.
model LetterRequest {
  id               String    @id @default(cuid())
  reqNo            String    @unique // REQ-SURAT-0001
  employeeId       String
  templateKey      String // EMP_SK_KERJA | EMP_SK_GAJI | ...
  purpose          String? // keperluan (kredit, visa, KPR, asuransi, dll.)
  notes            String? // catatan tambahan karyawan
  status           String    @default("Pending") // Pending|Approved|Rejected|Issued
  decidedById      String? // AppUser id pemutus (plain — trail saja)
  decidedAt        DateTime?
  rejectReason     String?
  letterDocumentId String? // LetterDocument hasil terbitkan (plain — snapshot audit)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
  @@index([status, createdAt])
}

// ============ OFFBOARDING (proses karyawan keluar) ============
// Checklist proses keluar karyawan — terhubung ke PersonnelAction
// Resignation/Termination/Retirement (dibuat otomatis saat PA diproses,
// atau manual). Mencakup clearance lintas divisi + exit interview.

model Offboarding {
  id                String    @id @default(cuid())
  employeeId        String
  personnelActionId String? // PA sumber (plain string — tampilan dokNo)
  lastDay           DateTime?
  reason            String?
  status            String    @default("Open") // Open|Completed|Cancelled
  exitInterviewJson String? // {reason, nextPlan, feedback, satisfaction, notes}
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id])
  tasks    OffboardingTask[]

  @@index([employeeId])
  @@index([status])
}

model OffboardingTask {
  id            String    @id @default(cuid())
  offboardingId String
  seq           Int       @default(0)
  title         String
  owner         String? // IT | HR | Finance | Supervisor | GA | Payroll
  status        String    @default("Pending") // Pending|Done|Na
  completedAt   DateTime?
  completedById String? // AppUser id (plain)
  completedVia  String? // "app" | "email:<dept>" — sumber centang (Task 65)
  notes         String?

  offboarding Offboarding @relation(fields: [offboardingId], references: [id], onDelete: Cascade)

  @@index([offboardingId])
}

// ====================================================================
// ============ WAVE 27/28 — gap audit domain-first (GAP-ANALYSIS-DEEP) ============
// ====================================================================

// ---- Task 65: Onboarding checklist — proses penyambutan karyawan baru ----
// Mirror Offboarding: dibuat OTOMATIS saat karyawan baru dibuat (wizard) atau
// manual oleh HR. Checklist per bagian (IT/GA/Finance/HR/Supervisor) — tiap
// bagian menerima EMAIL berisi daftar tugasnya + link checklist yang hanya
// mengizinkan mencentang tugas bagian itu sendiri (token HMAC per bagian).
model Onboarding {
  id          String    @id @default(cuid())
  employeeId  String
  startDate   DateTime?
  note        String?
  status      String    @default("Open") // Open|Completed|Cancelled
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee         @relation(fields: [employeeId], references: [id])
  tasks    OnboardingTask[]

  @@index([employeeId])
  @@index([status])
}

model OnboardingTask {
  id            String    @id @default(cuid())
  onboardingId  String
  seq           Int       @default(0)
  title         String
  owner         String? // IT | HR | Finance | Supervisor | GA
  status        String    @default("Pending") // Pending|Done|Na
  completedAt   DateTime?
  completedById String? // AppUser id (plain)
  completedVia  String? // "app" | "email:<tokenPrefix>" — jejak sumber centang
  notes         String?

  onboarding Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([onboardingId])
}

// ---- 27-a P0: import log mesin absen (sidik jari/face) ----
// Audit batch import — file log mentah mesin dibaca, didedupe, ditulis ke
// AttendanceClockLog (source "Machine"). Batch menyimpan ringkasan hasil
// agar import ulang file yang sama terlihat (idempotensi per baris tetap
// dicek ulang saat import — baris duplikat dilewati).
model MachineImportBatch {
  id               String    @id @default(cuid())
  fileName         String
  rowCount         Int       @default(0) // baris valid terbaca dari file
  inserted         Int       @default(0) // log baru ditulis
  skipped          Int       @default(0) // duplikat / tidak valid / karyawan tak dikenal
  unknownEmployees String? // ringkasan ID tak dikenal
  dateFrom         DateTime?
  dateTo           DateTime?
  importedById     String? // AppUser id (plain — pola OffboardingTask)
  importedAt       DateTime  @default(now())

  @@index([importedAt])
}

// ---- 27-f P1: pengumuman perusahaan (broadcast ESS) ----
model Announcement {
  id          String    @id @default(cuid())
  code        String    @unique // PGM-0001
  title       String
  body        String
  category    String    @default("Umum") // Umum|Kebijakan|Event|Darurat
  pinned      Boolean   @default(false)
  publishedAt DateTime? // null = draft (belum terlihat ESS)
  expiresAt   DateTime? // lewat tanggal = tidak tampil ESS (arsip otomatis)
  createdById String? // AppUser id (plain)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reads AnnouncementRead[]

  @@index([publishedAt])
}

// Pelacakan dibaca — 1 baris per karyawan per pengumuman (tombol "Saya sudah
// baca" / buka detail di ESS).
model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  employeeId     String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([announcementId, employeeId])
  @@index([employeeId])
}

// ---- 27-b P1: aset karyawan / inventaris ----
model Asset {
  id           String    @id @default(cuid())
  code         String    @unique // AST-0001
  name         String
  category     String    @default("Lainnya") // Elektronik|Kendaraan|Seragam|Alat Kerja|Furniture|Lainnya
  serialNumber String?
  notes        String?
  purchaseDate DateTime?
  value        Float? // nilai perolehan (Rp)
  status       String    @default("Available") // Available|Assigned|Maintenance|Retired|Lost
  location     String? // lokasi penyimpanan / kantor
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignments AssetAssignment[]

  @@index([category])
  @@index([status])
}

// Riwayat penugasan aset — assignment aktif = returnedAt null. Pengembalian
// mencatat kondisi (Good/Damaged/Lost) — kondisi Lost tercatat utk klaim
// clearance offboarding.
model AssetAssignment {
  id              String    @id @default(cuid())
  assetId         String
  employeeId      String
  assignedAt      DateTime  @default(now())
  dueAt           DateTime? // tenggat pengembalian (mis. seragam masa kontrak)
  returnedAt      DateTime?
  returnCondition String? // Good|Damaged|Lost
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  asset    Asset    @relation(fields: [assetId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([assetId])
}

// ---- 27-g P1: tukar shift self-service ----
// Karyawan A meminta bertukar shift tanggal D dengan karyawan B. Approval
// admin (menu attendance:shift-swap op approve) → dibuat assignment override
// 1-hari validFrom=validTo=D utk kedua pihak (salinan jadwal pasangan —
// engine resolveDayType memilih assignment validFrom terbaru → override menang).
model ShiftSwapRequest {
  id                  String    @id @default(cuid())
  code                String    @unique // TSK-0001
  requesterId         String
  targetId            String
  swapDate            DateTime // tanggal yang ditukar
  requesterScheduleId String? // snapshot jadwal requester saat ajukan
  targetScheduleId    String? // snapshot jadwal target
  reason              String?
  status              String    @default("Pending") // Pending|Approved|Rejected|Cancelled|Done
  decidedById         String? // AppUser id (plain)
  decidedAt           DateTime?
  decisionNote        String?
  appliedAssignment1  String? // id override requester (audit)
  appliedAssignment2  String? // id override target (audit)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  requester Employee @relation("SwapRequester", fields: [requesterId], references: [id])
  target    Employee @relation("SwapTarget", fields: [targetId], references: [id])

  @@index([status])
  @@index([requesterId])
  @@index([targetId])
}

// ---- 28-a P2: notifikasi WhatsApp (pattern EmailConfig/Template/Log) ----
model WaConfig {
  id     String  @id @default(cuid())
  active Boolean @default(false) // master switch — default MATI (butuh token provider)

  provider String @default("Fonnte") // Fonnte|Wablas|Custom
  endpoint String @default("") // URL kirim (Custom / override default provider)
  token    String @default("") // API token provider — TIDAK pernah dikirim ke klien (masked)
  sender   String @default("") // label pengirim / nomor sender (mis. "RekanKerja HRIS")

  lastTestOk      Boolean?
  lastTestAt      DateTime?
  lastTestMessage String?

  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Template pesan WA per EVENT — isi placeholder {{nama}} {{docNo}} dst.
model WaTemplate {
  id     String  @id @default(cuid())
  event  String  @unique // leave.submitted | payslip.sent | announcement.published | ...
  label  String
  active Boolean @default(true)
  body   String // teks pesan (placeholder; maks ±1000 char WhatsApp)

  updatedAt DateTime @updatedAt
}

// Audit trail pengiriman WA — tab "Riwayat Kirim".
model WaLog {
  id        String   @id @default(cuid())
  event     String
  toPhone   String
  body      String? // preview pesan terkirim
  status    String // Sent|Failed|Skipped
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event])
}

// ---- 45-a: MONEY VAULT — gerbang visibilitas nilai uang terenkripsi ----
// Kata sandi vault HANYA dipegang admin workspace: PBKDF2(salt) → KEK untuk
// men-WRAP kunci data tenant (32 byte, key yang sama dengan field-crypto).
// Status "open" yang otoritatif ada di MEMORI proses (money-vault.ts —
// openKeys per schema); kolom openUntil/openByUserId di sini hanya
// INFORMATIF (diagnostik/audit — restart server = vault terkunci otomatis).
// SATU baris per schema (dijaga di kode: findFirst; >1 baris → pakai pertama).
model MoneyVault {
  id           String    @id @default(cuid())
  salt         String // hex 32 karakter (16 byte) — input PBKDF2
  verifier     String // "vrf:v1:<hex>" = HMAC(verifierKey, "onevity-money-vault")
  wrappedKey   String // "vlt:v1:…" = AES-256-GCM(kek, dataKey) — SALINAN PEMULIHAN
  dataKey      String? // hex 64 — kunci enkripsi data perusahaan (enc:v2); null = baris pra-Task 47
  openUntil    DateTime? // INFORMATIF saja — status open sebenarnya di memori
  openByUserId String? // platform user id pembuka terakhir (informatif)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Hak LIHAT nilai uang TANPA tahu sandi vault — diberikan/ditarik admin
// (sandi vault tidak pernah menyebar). AKTIF saat revokedAt IS NULL.
// userId = PLATFORM user id (User.id milik membership workspace ini).
model MoneyViewGrant {
  id        String    @id @default(cuid())
  userId    String    @unique // platform user id (unique per schema tenant)
  grantedBy String // platform user id pemberi hak
  grantedAt DateTime  @default(now())
  revokedAt DateTime? // null = AKTIF
}

// ---- 28-b P2: report builder kustom ----
// Definisi laporan tersimpan: entity (katalog whitelisted server-side),
// field terpilih + filter. Dijalankan ulang kapan pun + ekspor CSV/XLSX.
model CustomReport {
  id          String   @id @default(cuid())
  code        String   @unique // RPT-KUSTOM-0001
  name        String
  description String?
  entity      String // employees|payroll_lines|attendance|leave_requests|travel_claims|medical_claims
  fieldsJson  String // ["fullName","employeeNo",...] — field whitelisted katalog
  filtersJson String? // [{field,op,value}] ops: eq|neq|in|contains|gt|gte|lt|lte|empty|notEmpty
  createdById String? // AppUser id (plain)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entity])
}

// ============ Task 52-f — WHISTLEBLOWING / TPKS (UU 12/2022 Ps.22-24) ============
// Kanal pelaporan pelanggaran & kekerasan seksual di tempat kerja. Mode ANONIM:
// identitas pelapor TIDAK disimpan (reporterEmployeeId null, tidak ada AppUser
// link, ActivityLog tanpa actor user) — pelapor login cukup utk terautentikasi
// sebagai anggota organisasi, identitasnya dibuang sebelum persist. Laporan
// non-anonim opsional (kontak ditinggalkan utk tindak lanjut).
// Status: Baru → Diterima → Investigasi → Selesai | Ditutup (ditutup tanpa
// tindak lanjut — dicatat alasan). Kategori mengikuti TPKS + pelanggaran lain.
model WhistleblowReport {
  id                 String    @id @default(cuid())
  ticketNo           String    @unique // WB-2026-001
  category           String // KEKERASAN_SEKSUAL|PELECEHAN|BULLYING|RETALIASI|FRAUD|KESELAMATAN|LAINNYA
  channel            String    @default("ESS") // ESS (aplikasi) | ANONIM (form anonim)
  description        String // kronologi pelaporan (bebas)
  incidentDate       DateTime? // tanggal kejadian
  location           String? // lokasi kejadian
  involvedHint       String? // pihak terlibat (deskriptif — bukan data master)
  anonymous          Boolean   @default(true) // true → identitas pelapor TIDAK disimpan
  reporterEmployeeId String? // null bila anonim (dibuang saat submit)
  reporterContact    String? // kontak opsional utk tindak lanjut (anonim boleh)
  status             String    @default("Baru") // Baru|Diterima|Investigasi|Selesai|Ditutup
  assignedToId       String? // AppUser penangan (plain string, tanpa FK)
  followUpNote       String? // catatan tindak lanjut per ganti status
  resolutionNote     String? // hasil akhir (Selesai/Ditutup)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
}

// ============ E-SIGN INTERNAL (Task 80) ============
// Tanda tangan elektronik internal — bukti kriptografis di atas aksi approve:
//   • SignatureKey     — pasangan kunci per pengguna (privat dibungkus dataKey
//                        Money Vault, tak pernah dikirim ke klien)
//   • SignatureRecord  — jejak tanda tangan: docHash SHA-256, signature
//                        RSA-PSS base64, identitas + konteks, hash-chain per
//                        tenant (ownHash = SHA-256(prevHash + record)) —
//                        manipulasi historis terdeteksi saat verifikasi rantai.
// Faktor tanda tangan: PIN personal (bcrypt, terpisah password login) / OTP
// email 6 digit (5 menit, 3 percobaan). Halaman verifikasi publik /v/[id].
model SignatureKey {
  id                  String    @id @default(cuid())
  appUserId           String    @unique
  publicKey           String    // PEM SPKI RSA-2048
  encryptedPrivateKey String    // PEM PKCS8 dienkripsi field-crypto tenant
  algorithm           String    @default("RSA-PSS-SHA256")
  status              String    @default("Active") // Active | Revoked
  pinHash             String?   // bcrypt PIN tanda tangan (terpisah password login)
  pinSetAt            DateTime?
  createdAt           DateTime  @default(now())
  rotatedAt           DateTime?
}

model SignatureRecord {
  id              String   @id @default(cuid())
  docType         String // LetterDocument | PersonnelAction | PayrollRun | …
  docId           String
  docRef          String // nomor dokumen human-readable (refNo / docNo)
  docHash         String // hex SHA-256(snapshot + metadata)
  snapshotJson    String   @default("{}") // snapshot identitas dokumen saat ttd
  signature       String // base64 RSA-PSS over docHash
  algorithm       String   @default("RSA-PSS-SHA256")
  signerAppUserId String
  signerName      String // snapshot nama saat ttd
  signerRole      String? // snapshot peran (AppUser.role / platform role)
  signedAt        DateTime @default(now())
  signerIp        String?
  signerUa        String?
  // hash-chain per tenant — urutkan by createdAt; first record prevHash = GENESIS
  prevHash        String
  ownHash         String

  @@index([docType, docId])
  @@index([signerAppUserId])
  @@index([signedAt])
}

// Challenge tanda tangan — PIN/OTP 6 digit (hash scrypt, bukan plaintext),
// 5 menit, maks 3 percobaan, satu pemakaian. Baris lama dibuang lazy.
model SignatureChallenge {
  id          String   @id @default(cuid())
  appUserId   String
  docType     String
  docId       String
  codeHash    String // scrypt$ salt$ hash
  purpose     String   @default("sign")
  attempts    Int      @default(0)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([appUserId, createdAt])
}

// ============ TASK 96 — AI ASSISTANT (chatbot pintar per-tenant) ============
// 4 tabel pendukung: konfigurasi provider AI per tenant (setiap perusahaan
// boleh pakai provider sendiri), basis pengetahuan (RAG), riwayat chat AI
// per pengguna×mode, dan pesan langsung antar pengguna (bawahan/atasan).
// Tanpa relasi FK ke AppUser — idem pola WhistleblowReport (kolom polos +
// index) supaya DDL idempoten lintas versi schema.

// Konfigurasi provider AI tenant (satu baris — singleton by convention).
//   provider "builtin" → LLM bawaan RekanKerja (z-ai-web-dev-sdk server-side).
//   provider "openai"  → endpoint OpenAI-compatible milik tenant sendiri
//                        (baseUrl + model + apiKey TERENKRIPSI enc:v1:t:…).
model AiProviderConfig {
  id        String   @id @default(cuid())
  provider  String   @default("builtin") // builtin | openai
  apiKey    String? // terenkripsi (enc:v1:t:… — field-crypto per-tenant)
  baseUrl   String? // mis. https://api.openai.com/v1
  model     String? // mis. gpt-4o-mini
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Basis pengetahuan AI (menu Pengaturan → Basis Pengetahuan) — dokumen
// aktif diinjeksi ke system prompt (RAG sederhana skor kata-kunci).
model AiKnowledgeDoc {
  id        String   @id @default(cuid())
  title     String
  content   String
  active    Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// Riwayat percakapan AI per AppUser × mode (assistant | hr_expert).
model AiChatMessage {
  id        String   @id @default(cuid())
  appUserId String
  mode      String   @default("assistant") // assistant | hr_expert
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([appUserId, mode, createdAt])
}

// Pesan langsung antar pengguna (bawahan ↔ atasan) — 1:1, tanpa thread.
model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

// ============ PEMBAYARAN BUKAN PEGAWAI (PMK 168/2023) ============
// Penerima "Bukan Pegawai" (Pasal 1 & 3(2) PMK 168/2023): tenaga ahli Pekerjaan
// Bebas (konsultan, akuntan, dokter, notaris, dsb.) dan pemberi jasa lain yang
// dibayar honorarium/komisi/fee — BUKAN gaji karyawan. PPh21 (Pasal 12(3) +
// 16(3) PMK 168/2023): DPP = 50% × bruto; pajak = tarif Pasal 17 UU PPh × DPP;
// KREDIT PAJAK penerima di SPT Tahunan (bukan pajak final — Lampiran PMK
// 168/2023 catatan contoh V) — tanpa PTKP, tanpa biaya jabatan, tanpa TER.
// Bukti potong dilaporkan sebagai bupot "Pembayaran kepada Pihak Lain"
// (Coretax), bukan 1721-A1.
model NonEmployeePartner {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  idType      String   @default("npwp") // npwp | nik | none
  idNumber    String? // NPWP 15/16 digit ATAU NIK 16 digit — terenkripsi (PII)
  address     String?
  serviceKind String   @default("Pekerjaan Bebas") // tenaga ahli/pemberi jasa/agen/dsb. (bebas isi)
  isCatering  Boolean  @default(false) // jasa katering: bruto TIDAK boleh dipotong komponen tenaga kerja/material (Pasal 12(4))
  bankName    String?
  bankAccount String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments NonEmployeePayment[]

  @@index([active, name])
}

// Satu pembayaran honor/fee → PPh21 dihitung service (DPP 50% × Pasal 17
// atas bruto setelah eksklusi Pasal 12(4)(b)) — kredit pajak penerima di SPT
// Tahunan. Nilai uang TERENKRIPSI (enc:v1:n) — dekripsi hanya di batas
// serializer (money-view).
model NonEmployeePayment {
  id              String    @id @default(cuid())
  docNo           String    @unique // BPNP-2026-0001 — dibuat server (max-scan per tahun, pola modul medical)
  partnerId       String
  description     String
  grossAmount     String // penghasilan bruto yang dibayarkan ke Bukan Pegawai — TERENKRIPSI (M-8)
  excludedNotes   String? // catatan komponen yang dikeluarkan dari bruto (tenaga kerja/material/pihak ketiga — Pasal 12(4)-(5))
  excludedAmount  String? // nilai komponen Pasal 12(4)(b) yang dikeluarkan dari bruto SEBELUM ×50% — TERENKRIPSI (M-8)
  dpp             String // = 50% × (grossAmount − excludedAmount) (snapshot hasil kalkulasi) — TERENKRIPSI (M-8)
  pph21           String // = tarif Pasal 17 × dpp (snapshot hasil kalkulasi) — TERENKRIPSI (M-8)
  netAmount       String // = grossAmount − pph21 — TERENKRIPSI (M-8)
  paymentDate     DateTime
  taxYear         Int // tahun pajak (dari paymentDate)
  taxMonth        Int // masa pajak 1-12 (dari paymentDate) — kunci ledger bukti potong
  status          String    @default("Draft") // Draft | Paid | Cancelled
  paidAt          DateTime?
  createdBy       String? // nama aktor
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  partner NonEmployeePartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([partnerId, paymentDate])
  @@index([taxYear, taxMonth])
  @@index([status])
}

// ============================================================================
// RECRUITMENT — F0 Fondasi Modul & Master
// (DEVELOPMENT-PLAN-RECRUITMENT.md §7 F0; basis ANALISA-RECRUITMENT.md §7.2)
// Master rekrutmen per tenant — konvensi proyek: cuid PK, code unik, tanpa
// tipe list primitif, active + sortOrder untuk pengurutan stabil.
// SelectionProcess = katalog tahap seleksi (padanan Standard Selection
// Process §2.6) — per-tenant, dapat diedit (config-over-code P6).
// ============================================================================

// Metode rekrutmen (padanan RecruitmentMethodDesc: Internal Job
