// Tahap seleksi standar (padanan Standard Selection Process §2.6):
// katalog per-tenant — urutan (processOrder), SLA (slaDays), tipe hasil
// (Quantitative/Qualitative), nilai minimal lulus, berlaku utk kandidat
// internal/eksternal, perlu acknowledgement. Seed default F0: Interview HR
// → Psikotes (manual) → Interview User → Offering Salary → Medical Check Up.
model SelectionProcess {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  description         String?
  mandatory           Boolean  @default(true)
  resultType          String   @default("Qualitative") // Quantitative | Qualitative
  appliesInternal     Boolean  @default(true)
  appliesExternal     Boolean  @default(true)
  minResultPass       Float?
  processOrder        Int      @default(1)
  slaDays             Int?
  needAcknowledgement Boolean  @default(false)
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // F3-REC — langkah per kandidat + template scorecard yang terikat tahap ini
  steps             CandidateSelectionStep[]
  scorecardTemplates ScorecardTemplate[]      @relation("ProcessScorecardTemplates")
}

// ============ RECRUITMENT — F1: PERMINTAAN KARYAWAN (PR) ============
// DEVELOPMENT-PLAN-RECRUITMENT.md §7 F1 + §4.3 — state machine EKSPLISIT
// (padanan PersonnelRequisition.jsp, diperkaya HRX A3):
//   Draft ──apply──► Submitted ──approval──► Approved | Rejected
//   Draft ──cancel──► Cancelled
//   Submitted ──cancel──► Cancelled (chain ikut dibatalkan)
//   Approved ──hold/resume──► OnHold ──► Approved
//   Approved|OnHold ──close──► Closed (batal rekrutmen pasca-approval)
//   Approved ──(F2: lowongan terpenuhi sistem)──► Fulfilled
//   Rejected/Cancelled/Closed/Fulfilled = terminal — ajukan ulang lewat
//   "Duplikat" (PR baru, jejak chain lama tetap utuh).
model PersonnelRequisition {
  id                      String    @id @default(cuid())
  prNo                    String    @unique // PR-2026-0001 (docNo prefix-tahun-seq)
  requestDate             DateTime  @default(now())
  requestedById           String // Employee pengaju (default: pembuat)
  positionId              String? // posisi yang diminta
  jobId                   String?
  orgUnitId               String?
  companyOfficeId         String?
  requiredNo              Int       @default(1)
  employmentStatus        String    @default("Permanent") // Permanent|Contract|Probation|Outsourcing
  preferredSource         String? // Internal|External|Any
  earliestDate            DateTime? // jendela kebutuhan — paling awal
  latestDate              DateTime? // paling lambat
  recruitmentOfficerId    String? // Employee owner proses rekrutmen
  reason                  String? // alasan kebutuhan
  miscSpec                String? // spesifikasi lain
  additionalQualification String? // kualifikasi tambahan
  salaryBudget            String? // TERENKRIPSI vault uang (enc:v1:n:…) — decrypt hanya di batas serializer
  autoPostOpening          Boolean   @default(false) // auto buat JobOpening saat Approved (dipakai F2)
  slaTargetDays           Int? // target hari penyelesaian (HRX A3)
  replacedEmployeeId      String? // PR penggantian (attrition) — karyawan yang digantikan
  // F6-REC — rubrik skor AI no-code per PR (HRX B2): JSON string
  // [{name, weight, guide}] — snapshot disalin ke CandidateAiScore.rubricJson
  // saat generate; bobot dinormalisasi service. Null = pakai rubrik default.
  rubricJson              String? // [{name, weight, guide}] — bobot 0–1 relatif
  // PLAN-LINK — tautan EKSPLISIT PR→rencana MPP (RecruitmentPlan) yang dilayaninya.
  // Null = PR ad-hoc / akan di-match otomatis oleh rekonsiliasi (posisi+kantor+
  // scope tahun) di planning-service. Validasi: hanya rencana berstatus Applied.
  planId                   String?
  status                  String    @default("Draft") // Draft|Submitted|Approved|Rejected|OnHold|Fulfilled|Closed|Cancelled
  decisionNote            String? // catatan keputusan approver (reject/close)
  submittedAt             DateTime?
  decidedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  requestedBy        Employee       @relation("PrRequester", fields: [requestedById], references: [id])
  plan               RecruitmentPlan? @relation("PlanPrs", fields: [planId], references: [id])
  position           Position?      @relation("PrPosition", fields: [positionId], references: [id])
  job                Job?           @relation("PrJob", fields: [jobId], references: [id])
  orgUnit            OrgUnit?       @relation("PrOrgUnit", fields: [orgUnitId], references: [id])
  companyOffice      CompanyOffice? @relation("PrOffice", fields: [companyOfficeId], references: [id])
  recruitmentOfficer Employee?      @relation("PrOfficer", fields: [recruitmentOfficerId], references: [id])
  replacedEmployee   Employee?      @relation("PrReplacement", fields: [replacedEmployeeId], references: [id])

  // F2-REC — slot lowongan yang melayani PR ini
  openings           JobOpening[]   @relation("PrOpenings")

  // F3-REC — kandidat yang dinominasikan ke PR ini
  candidates         JobCandidate[] @relation("PrCandidates")

  // F4-REC — offer & pengangkatan dari PR ini
  offers             CandidateOffer[]       @relation("PrOffers")
  appointments       CandidateAppointment[] @relation("PrAppointments")

  @@index([status, requestDate])
  @@index([requestedById])
  @@index([planId])
}

// ============================================================================
// RECRUITMENT — F2: LOWONGAN, PELAMAR & TALENT POOL + FORM PUBLIK
// (DEVELOPMENT-PLAN-RECRUITMENT.md §7 F2 + §4.2/§4.3 analisa)
//
// Rantai: JobOpportunity (JO — iklan) 1—N JobOpening (slot per PR, unik per
// [JO,PR]) + JobOpeningMethod (kanal + biaya terencana/aktual per JO).
// Applicant = talent pool (PII terenkripsi field-crypto; uang vault) →
// ApplicantApplication multi-lamar (unik per [pelamar, slot]).
// PublicApplication = staging form publik anonim (D1: verifikasi manual →
// "di-upload" jadi Applicant) + ApplicantConsent (UU PDP granular/versioned).
//
// Konvensi uang (§4.1):
//   • salaryMin/salaryMax JobOpening = RENTANG GAJI IKLAN — publik by design
//     (ditampilkan di portal karir tanpa login) → kolom Int polos.
//   • plannedCost/actualCost JobOpeningMethod + Applicant.expectedSalary =
//     data kompensasi/budget internal-pribadi → TERENKRIPSI vault uang
//     (enc:v1:n:…), decrypt hanya di batas serializer (W28: tak pernah di
//     where/sort SQL).
//   • Kolom turunan Applicant (highestEduLevel/highestGpa/totalExpMonths)
//     di-maintain service agar query builder talent pool bisa filter
//     server-side tanpa membongkar enkripsi.
// ============================================================================

// Iklan lowongan (padanan JobOpportunity §2.4): refNo JO-YYYY-NNNN,
// status Draft|Posted|Closed|Obsolete; berisi N slot (per PR) + kanal biaya.
model JobOpportunity {
  id             String    @id @default(cuid())
  refNo          String    @unique // JO-2026-0001 (docNo prefix-tahun-seq)
  title          String // judul iklan (default: posisi slot pertama — editable)
  preparedById   String? // Employee penyusun (null = sistem/auto-post)
  datePrepared   DateTime  @default(now())
  status         String    @default("Draft") // Draft|Posted|Closed|Obsolete
  datePosted     DateTime? // saat mulai tampil publik
  content        String? // isi iklan (ringkasan tugas/kualifikasi)
  contactPerson  String? // kontak HR yang ditampilkan
  lastAcceptDate DateTime? // batas akhir penerimaan lamaran
  // F5-REC — jendela internal-first (opsional per JO): sebelum tanggal ini
  // lowongan HANYA terlihat & bisa dilamar karyawan (ESS Lowongan Internal),
  // belum tayang di portal publik; internalOnly = khusus internal selamanya.
  internalOnly       Boolean   @default(false)
  internalFirstUntil DateTime?
  createdAt         DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  preparedBy Employee?          @relation("JoPreparer", fields: [preparedById], references: [id])
  openings   JobOpening[]
  methods    JobOpeningMethod[]

  @@index([status])
  @@index([datePosted])
}

// Slot lowongan per PR (padanan JobOpening): satu PR bisa dilayani
// banyak JO, satu JO bisa menampung banyak slot PR (unik per pasangan).
model JobOpening {
  id                String    @id @default(cuid())
  jobOpportunityId  String
  prId              String
  titleToShow       String // judul yang ditampilkan di slot
  workLocationId    String?
  salaryMin         Int? // rentang gaji IKLAN (publik by design — bukan data pribadi)
  salaryMax         Int?
  currency          String    @default("IDR")
  salaryUnit        String    @default("Monthly")
  jobDescSummary    String? // ringkasan tugas (tampil publik)
  jobSpecSummary    String? // ringkasan kualifikasi (tampil publik)
  status            String    @default("Open") // Open|Fulfilled|Closed
  postedAt          DateTime? // kapan slot mulai tampil di portal publik
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  jobOpportunity    JobOpportunity         @relation(fields: [jobOpportunityId], references: [id])
  pr                PersonnelRequisition    @relation("PrOpenings", fields: [prId], references: [id])
  workLocation      WorkLocation?          @relation("OpeningLocation", fields: [workLocationId], references: [id])
  applications      ApplicantApplication[]
  publicApplications PublicApplication[]

  // F5-REC — lamaran karyawan internal (ESS) ke slot ini
  empApplications   EmpJobApplication[]    @relation("EmpJobApplications")

  // F4-REC — offer yang terikat slot ini (guidance rentang gaji iklan)
  offers            CandidateOffer[]       @relation("OpeningOffers")

  // F6-REC — pertanyaan knockout per slot (HRX B3)
  knockouts         KnockoutQuestion[]     @relation("OpeningKnockouts")

  @@unique([jobOpportunityId, prId])
  @@index([prId])
  @@index([status])
}

// Kanal publikasi + biaya per JO (padanan JobOpeningMethod): metode,
// media iklan, agency, pos biaya, planned/actual (vault uang).
model JobOpeningMethod {
  id                String    @id @default(cuid())
  jobOpportunityId  String
  methodId          String // RecruitmentMethod master
  adMediaTypeId     String?
  agencyId          String?
  costItemId        String? // RecruitmentCostItem
  plannedCost       String? // TERENKRIPSI vault uang (enc:v1:n:…) — decrypt di serializer
  actualCost        String? // idem
  datePosted        DateTime?
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  jobOpportunity JobOpportunity        @relation(fields: [jobOpportunityId], references: [id], onDelete: Cascade)
  method         RecruitmentMethod     @relation("MethodJoOpening", fields: [methodId], references: [id])
  adMediaType    AdMediaType?          @relation("AdMediaJoOpening", fields: [adMediaTypeId], references: [id])
  agency         EmploymentAgency?     @relation("AgencyJoOpening", fields: [agencyId], references: [id])
  costItem       RecruitmentCostItem?  @relation("CostItemJoOpening", fields: [costItemId], references: [id])

  @@index([jobOpportunityId])
}

// Pelamar / talent pool (padanan Applicant §2.5 + HRX C4-lite).
// PII (email/phone/address/city/placeOfBirth/identityNo) TERENKRIPSI
// field-crypto; expectedSalary vault uang — decrypt di batas serializer API.
// Kolom turunan (highestEduLevel/highestGpa/totalExpMonths) dihitung ulang
// service saat education/experience berubah — agar query talent pool tetap
// server-side (W28).
model Applicant {
  id                 String    @id @default(cuid())
  applicantNo        String    @unique // APP-26-00001 (docNo prefix-tahun(2)-seq(5))
  firstName          String
  middleName         String?
  lastName           String?
  displayName        String? // nama tampilan (opsional)
  status             String    @default("Active") // Active|Rejected|Outdated|Employed
  blacklist          Boolean   @default(false)
  blacklistNote      String? // alasan blacklist — WAJIB (guard service)
  blacklistAt        DateTime?
  blacklistById      String?
  suspend            Boolean   @default(false)
  suspendNote        String? // alasan suspend — WAJIB
  suspendUntil       DateTime?
  dateApplied        DateTime  @default(now()) // masuk talent pool
  dateAvailable      DateTime? // tanggal siap mulai bekerja
  expectedSalary     String? // TERENKRIPSI vault uang (enc:v1:n:…)
  currency           String    @default("IDR")
  salaryUnit         String    @default("Monthly")
  keepOnFileMonths   Int       @default(12)
  keepOnFileUntil    DateTime? // dateApplied + months — scheduler auto-Outdated
  source             String? // Advertisement|Agency|Referral|Web|Internal|Other
  adMediaTypeId      String?
  agencyId           String?
  institutionName    String? // institusi sumber (kampus/vendor)
  referralEmployeeId String? // Employee perujuk (pencatatan referral)
  // PII — TERENKRIPSI field-crypto (enc:v1:t:…)
  email              String?
  phone              String?
  address            String?
  city               String?
  placeOfBirth       String?
  identityNo         String? // no. KTP — terenkripsi
  birthDate          DateTime? // polos (konvensi Employee.birthDate — filter umur)
  gender             String? // L|P
  maritalStatus      String?
  notes              String?
  // kolom turunan (dihitung service — lihat header model)
  highestEduLevel    String? // level tertinggi: SMP|SMA|SMK|D3|S1|S2|S3|PROF
  highestGpa         Float? // IPK pada level tertinggi
  totalExpMonths     Int       @default(0) // Σ bulan pengalaman kerja
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  adMediaType      AdMediaType?      @relation("ApplicantAdMedia", fields: [adMediaTypeId], references: [id])
  agency           EmploymentAgency? @relation("ApplicantAgency", fields: [agencyId], references: [id])
  referralEmployee Employee?         @relation("ApplicantReferrer", fields: [referralEmployeeId], references: [id])
  educations       ApplicantEducation[]
  experiences      ApplicantExperience[]
  skills           ApplicantSkill[]
  documents        ApplicantDocument[]
  applications     ApplicantApplication[]
  consents         ApplicantConsent[]
  // F3-REC — kandidat PR yang bersumber dari pelamar ini
  candidates       JobCandidate[]     @relation("ApplicantCandidates")
  // F6-REC — hasil parsing CV (AI/manual/simulated) milik pelamar ini
  cvParses         CvParseResult[]    @relation("ApplicantCvParses")
  // F9-REC — permintaan subjek data (UU PDP) milik pelamar ini
  dsrRequests      DataSubjectRequest[] @relation("ApplicantDsr")

  @@index([status])
  @@index([keepOnFileUntil])
  @@index([source])
}

// Riwayat pendidikan pelamar (padanan ApplicantEducation).
model ApplicantEducation {
  id             String   @id @default(cuid())
  applicantId    String
  level          String // SMP|SMA|SMK|D3|S1|S2|S3|PROF
  fieldOfStudy   String?
  institution    String?
  graduationYear Int?
  gpa            Float? // skala 0–4
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
}

// Riwayat pengalaman kerja pelamar (padanan ApplicantExperience).
model ApplicantExperience {
  id          String   @id @default(cuid())
  applicantId String
  company     String?
  position    String?
  field       String?
  startYear   Int?
  endYear     Int? // null = sekarang
  months      Int? // durasi bulan baris ini (Σ → Applicant.totalExpMonths)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
}

// Keahlian pelamar (link ke master Skill — F0).
model ApplicantSkill {
  id          String   @id @default(cuid())
  applicantId String
  skillId     String // Skill master
  level       String? // Beginner|Intermediate|Advanced|Expert
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  skill     Skill     @relation("ApplicantSkillMaster", fields: [skillId], references: [id])

  @@index([applicantId])
  @@index([skillId])
}

// Checklist dokumen pelamar (padanan ApplicantDocument — pattern
// EmployeeDocument: file via Attachment + MIME whitelist + magic number).
model ApplicantDocument {
  id                 String   @id @default(cuid())
  applicantId        String
  requiredDocumentId String? // checklist RequiredDocument (CV & KTP wajib)
  title              String
  verified           Boolean  @default(false) // diverifikasi HR (pre-employment F4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  applicant        Applicant          @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  requiredDocument RequiredDocument?  @relation("ApplicantRequiredDoc", fields: [requiredDocumentId], references: [id])
  attachmentId     String?
  attachment       Attachment?        @relation("ApplicantDocAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([applicantId])
}

// Multi-lamaran: satu pelamar bisa melamar banyak slot (padanan
// ApplicantApplication — unik per pasangan [pelamar, slot]).
model ApplicantApplication {
  id                String   @id @default(cuid())
  applicantId       String
  jobOpeningId      String
  dateApplied       DateTime @default(now())
  status            String   @default("Received") // Received|Screening|Rejected|Hired
  sourceNote        String?
  rejectionLetterNo String? // F4: surat penolakan
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  applicant  Applicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  jobOpening JobOpening @relation(fields: [jobOpeningId], references: [id])

  // F6-REC — jawaban pertanyaan knockout lamaran ini
  answers    ApplicationAnswer[] @relation("ApplicationAnswers")

  @@unique([applicantId, jobOpeningId])
  @@index([jobOpeningId])
}

// Staging form publik anonim (HRX I1/C1-lite — padanan ApplicantWeb;
// keputusan D1: form minimal → verifikasi manual HR "Upload" ke talent pool).
// payloadJson = JSON isian form dengan field PII TERENKRIPSI per-field.
model PublicApplication {
  id            String    @id @default(cuid())
  jobOpeningId  String? // null = lamaran umum (tanpa slot)
  status        String    @default("Pending") // Pending|Verified|Rejected|Spam
  payloadJson   String // seluruh isian form (PII dienkripsi per-field)
  cvFileName    String? // jejak cepat (file fisik di Attachment)
  cvStoragePath String?
  ipHash        String? // rate-limit & audit (SHA-256 salted — bukan IP mentah)
  submittedAt   DateTime  @default(now())
  verifiedById   String? // Employee verifikator
  verifiedAt     DateTime?
  rejectNote    String? // alasan tolak (staging)
  consentId     String? // → ApplicantConsent (channel public-form)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  jobOpening JobOpening? @relation(fields: [jobOpeningId], references: [id])
  verifiedBy Employee?  @relation("PaVerifier", fields: [verifiedById], references: [id])

  @@index([status, submittedAt])
}

// Consent UU PDP granular & versioned (HRX I1): setiap pengumpulan PII
// pelamar dicatat — public-form | manual (input HR). purpose mis.
// "recruitment" (proses lamaran aktif) / "talent-pool" (simpan utk masa
// depan). withdrawal = withdrawnAt (F9 retention).
model ApplicantConsent {
  id          String    @id @default(cuid())
  applicantId String? // null selagi masih staging (PublicApplication)
  purpose     String
  version     String // versi teks consent (mis. "2026-01")
  grantedAt   DateTime  @default(now())
  withdrawnAt DateTime?
  channel     String // public-form|manual
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applicant Applicant? @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId, purpose])
}

// ============================================================================
// RECRUITMENT — F3: KANDIDAT & PROSES SELEKSI TERSTRUKTUR
// (DEVELOPMENT-PLAN-RECRUITMENT.md §7 F3 + §4.2/§4.3 — §2.6
//  EvaluationProcess/EvaluationProcessPerCandidate + HRX D1/D2/D3/D6)
//
// Rantai: JobCandidate (per PR; Applicant eksternal ATAU Employee internal)
//   → CandidateSelectionStep (per tahap master, urut seqNo = processOrder):
//     Planned → [Acknowledged] → Performed → Passed|Failed (continueProcess)
//   → CandidateScorecard + ScorecardItem (rubrik 1–5 anchored per evaluator;
//     feedback wajib sebelum naik tahap; divergensi panel >2 dihitung saat
//     baca — HRX D2).
// Surat undangan: RecruitmentLetter (snapshot + nomor NNN/HR-RC/x/2026) —
// terikat KANDIDAT (LetterDocument terikat Employee; pelamar eksternal bukan
// employee). Template tetap di LetterTemplate (kategori "Recruitment") dan
// render/PDF memakai mesin surat (renderLetterBody + letterPdfBuffer).
// Hasil tes eksternal (psikotes/medis — keputusan §3.10: catat manual):
// Attachment entityType "recruitment-step-report" + kolom ringkas di step.
// ============================================================================

// Kandidat PR — pelamar talent pool (eksternal) ATAU employee (internal:
// mutasi/promosi — HRX A4). fullName = snapshot saat transfer (tampilan
// board/list cepat; identitas penuh tetap lewat relasi Applicant/Employee).
model JobCandidate {
  id            String   @id @default(cuid())
  prId          String
  applicantId   String? // eksternal → Applicant talent pool
  employeeId    String? // internal → Employee (mutasi/promosi)
  source        String   @default("External") // Internal|External
  status        String   @default("Nominated") // Nominated|InProcess|Passed|Failed|Withdrawn|Hired (F4: diangkat → karyawan)
  fullName      String // snapshot nama saat dinominasikan
  nominatedById String? // Employee pencatat (null = sistem/import)
  nominatedAt   DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pr            PersonnelRequisition    @relation("PrCandidates", fields: [prId], references: [id])
  applicant     Applicant?             @relation("ApplicantCandidates", fields: [applicantId], references: [id])
  employee      Employee?              @relation("CandidateInternalEmployee", fields: [employeeId], references: [id])
  nominatedBy  Employee?              @relation("CandidateNominator", fields: [nominatedById], references: [id])
  selectionSteps CandidateSelectionStep[]
  scorecards     CandidateScorecard[]
  letters        RecruitmentLetter[]

  // F4-REC — offer & pengangkatan kandidat ini (1 kandidat bisa punya
  // beberapa offer historis; pengangkatan 1:1 dengan offer via offerId unik)
  offers         CandidateOffer[]       @relation("CandidateOffers")
  appointments   CandidateAppointment[] @relation("CandidateAppointments")

  // F5-REC — lamaran internal ESS yang menominasikan kandidat ini
  // (satu kandidat bisa dirujuk >1 lamaran slot berbeda dari PR yang sama)
  empApplications EmpJobApplication[] @relation("EmpJobApplicationCandidate")

  // F6-REC — skor AI explainable (HRX B2) — histori generate per kandidat
  aiScores         CandidateAiScore[]  @relation("CandidateAiScores")

  @@unique([prId, applicantId]) // 1 pelamar 1 PR (employee internal bebas)
  @@index([prId, status])
  @@index([employeeId])
}

// Satu tahap seleksi per kandidat (padanan EvaluationProcessPerCandidate
// — plan/due + ack + performed + hasil Quantitative|Qualitative +
// pass/fail + continueProcess). dueDate = batas SLA (plan + slaDays master,
// boleh di-override manual).
model CandidateSelectionStep {
  id                 String    @id @default(cuid())
  candidateId        String
  selectionProcessId String
  seqNo              Int // urutan jalannya proses (dari processOrder master)
  planDate           DateTime? // jadwal pelaksanaan (undangan)
  dueDate            DateTime? // batas SLA tahap
  acknowledgedAt     DateTime? // needAcknowledgement → ack kandidat/ESS
  performedById      String? // Employee evaluator pelaksana
  performedAt        DateTime?
  status             String    @default("Planned") // Planned|Acknowledged|Performed|Passed|Failed|Cancelled
  score              Float? // hasil Quantitative (dibanding minResultPass)
  result             String? // hasil Qualitative / indeks teks
  comment            String?
  continueProcess    Boolean   @default(true) // gagal tapi lanjut (keputusan HR)
  reportFileName     String? // nama file laporan tes eksternal (Attachment)
  letterNo           String? // nomor surat undangan terakhir (display cepat)
  // B6-BL — link meeting video-call tahap seleksi (kompromi micro §1 dok
  // backlog: video interview platform penuh di-defer). Placeholder
  // {{linkMeeting}} di email/WA undangan selection.scheduled/reminder.
  meetingUrl         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  candidate        JobCandidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  selectionProcess SelectionProcess @relation(fields: [selectionProcessId], references: [id])
  performedBy      Employee?         @relation("StepPerformer", fields: [performedById], references: [id])
  scorecards       CandidateScorecard[]
  letters          RecruitmentLetter[]

  @@unique([candidateId, selectionProcessId, seqNo])
  @@index([candidateId, status])
  @@index([status, dueDate]) // monitor SLA overdue + reminder scheduler
}

// Template rubrik penilaian per tahap (HRX D2 — structured scorecards).
// selectionProcessId null = template umum (dipakai semua tahap).
model ScorecardTemplate {
  id                 String   @id @default(cuid())
  name               String
  selectionProcessId String?
  description        String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  selectionProcess SelectionProcess?    @relation("ProcessScorecardTemplates", fields: [selectionProcessId], references: [id])
  competencies     ScorecardCompetency[]
  scorecards       CandidateScorecard[]

  @@index([active])
}

// Rubrik kompetensi 1–5 anchored (anchorsJson = [{value,label,guide}…]).
model ScorecardCompetency {
  id          String  @id @default(cuid())
  templateId  String
  name        String
  description String?
  weight      Float   @default(1)
  anchorsJson String?
  orderNo     Int     @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template ScorecardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    ScorecardItem[]

  @@index([templateId, orderNo])
}

// Pengisian scorecard per kandidat per tahap per evaluator (unik). Draft =
// submittedAt null; feedback wajib sebelum tahap bisa naik (dipaksa service).
model CandidateScorecard {
  id              String    @id @default(cuid())
  candidateId     String
  selectionStepId String
  templateId      String
  evaluatorId     String // Employee
  submittedAt     DateTime?
  recommendation  String? // StrongHire|Hire|NoHire|StrongNoHire
  overallComment  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  candidate      JobCandidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  selectionStep  CandidateSelectionStep @relation(fields: [selectionStepId], references: [id], onDelete: Cascade)
  template       ScorecardTemplate     @relation(fields: [templateId], references: [id])
  evaluator      Employee              @relation("ScorecardEvaluator", fields: [evaluatorId], references: [id])
  items          ScorecardItem[]

  @@unique([selectionStepId, evaluatorId])
}

// Skor per kompetensi (1–5) — satu baris per pasangan scorecard×kompetensi.
model ScorecardItem {
  id           String   @id @default(cuid())
  scorecardId  String
  competencyId String
  score        Int // 1–5
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scorecard  CandidateScorecard  @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  competency ScorecardCompetency @relation(fields: [competencyId], references: [id])

  @@unique([scorecardId, competencyId])
}

// Surat rekrutmen (undangan seleksi; nanti hasil/offer) — snapshot seperti
// LetterDocument tapi terikat KANDIDAT (pelamar eksternal bukan Employee).
// letterNo NNN/HR-RC/{romawi}/{tahun} per tahun (pola letter-service).
model RecruitmentLetter {
  id              String   @id @default(cuid())
  letterNo        String   @unique
  kind            String // Invitation (F3) | Offer | Appointment | Rejection (F4)
  templateKey     String
  candidateId     String
  selectionStepId String?
  subject         String?
  body            String // snapshot hasil render (audit & cetak ulang)
  metaJson        String?
  issuedAt        DateTime @default(now())
  createdById     String? // Employee penerbit (jejak)

  candidate     JobCandidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  selectionStep CandidateSelectionStep? @relation(fields: [selectionStepId], references: [id])

  // F7-REC — permintaan e-sign kandidat utk surat ini (offer/pengangkatan)
  esignRequests EsignRequest[]        @relation("EsignLetter")

  @@index([candidateId, issuedAt])
  @@index([kind, issuedAt])
}

// ============================================================================
// RECRUITMENT — F4: OFFER & APPOINTMENT + INTEGRASI ONBOARDING
// (DEVELOPMENT-PLAN-RECRUITMENT.md §7 F4 + §3.5 HRX E1/E3/H1/H2)
//
// Rantai: JobCandidate (Passed / tahap Offering) → CandidateOffer (nomor
// OFF-YYYY-NNNN, gaji final TERENKRIPSI vault, tanggal mulai, expiry timer +
// reminder scheduler, status Draft→PendingApproval→Sent→Viewed→Accepted|
// Declined|Expired; counter dicatat sebagai note — versi awal HRX E3) →
// CandidateAppointment (penempatan prefill dari PR boleh override + surat
// pengangkatan + surat penolakan batch ke kandidat lain di PR yang sama) →
// tombol "Lanjutkan ke Onboarding" → Employee + EmployeeAssignment dibuat
// via createEmployeeWithAssignment (tanpa double-entry) + Onboarding
// checklist → backlink employeeId/onboardingId + Applicant.status=Employed +
// PR→Fulfilled saat jumlah appointed ≥ requiredNo.
//
// Konvensi uang (§4.1): CandidateOffer.salary = data kompensasi internal-pribadi
// → TERENKRIPSI vault uang (enc:v1:n:…), decrypt HANYA di batas serializer API
// (moneyVisible gating) — tidak pernah di where/sort SQL.
// ============================================================================

// Offer kepada kandidat (HRX E1 — offer builder + guidance vs rentang gaji
// slot JO; HRX E3 — tracking sent→viewed→accepted/declined/expired).
model CandidateOffer {
  id           String    @id @default(cuid())
  offerNo      String    @unique // OFF-2026-0001 (docNo prefix-tahun-seq)
  prId         String
  candidateId  String // JobCandidate
  jobOpeningId String? // slot JO (guidance rentang gaji iklan)
  salary       String? // TERENKRIPSI vault uang (enc:v1:n:…) — decrypt di serializer
  currency     String    @default("IDR")
  salaryUnit   String    @default("Monthly")
  startDate    DateTime? // tanggal mulai kerja ditawarkan
  expiryDate   DateTime? // timer kedaluwarsa (HRX E3 — reminder scheduler)
  status       String    @default("Draft") // Draft|PendingApproval|Sent|Viewed|Accepted|Declined|Expired
  letterNo     String? // surat penawaran REC_OFFER (letter engine)
  note         String? // termasuk catatan counter (HRX E3 versi awal)
  sentAt       DateTime?
  respondedAt  DateTime?
  appointedAt  DateTime? // ditandai saat CandidateAppointment dibuat
  createdById  String? // Employee pembuat (jejak)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  pr          PersonnelRequisition  @relation("PrOffers", fields: [prId], references: [id])
  candidate   JobCandidate         @relation("CandidateOffers", fields: [candidateId], references: [id])
  jobOpening  JobOpening?          @relation("OpeningOffers", fields: [jobOpeningId], references: [id])
  createdBy   Employee?            @relation("OfferCreator", fields: [createdById], references: [id])
  appointment CandidateAppointment?

  // F7-REC — permintaan e-sign kandidat utk offer ini
  esignRequests EsignRequest[]     @relation("EsignOffer")

  @@index([status, expiryDate]) // monitor expiry + reminder scheduler
  @@index([prId])
  @@index([candidateId])
}

// Pengangkatan kandidat (dialog penempatan + surat REC_APPOINT + batch
// REC_REJECT ke kandidat lain di PR yang sama saat fulfilled). Lanjut ke
// onboarding membuat Employee + assignment + checklist (backlink di bawah).
model CandidateAppointment {
  id               String    @id @default(cuid())
  offerId          String    @unique // 1 offer 1 pengangkatan
  candidateId      String
  prId             String
  appointmentDate  DateTime // tanggal pengangkatan (prefill: offer.startDate)
  positionId       String? // penempatan — prefill dari PR, boleh override
  orgUnitId        String?
  companyOfficeId  String?
  workLocationId   String?
  supervisorId     String? // Employee atasan langsung
  gradeId          String?
  employmentStatus String    @default("Permanent") // prefill dari PR
  workShift        String    @default("Regular")
  letterNo         String? // surat pengangkatan REC_APPOINT
  employeeId       String? // F4 backlink: karyawan hasil onboarding
  onboardingId     String? // F4 backlink: proses Onboarding checklist
  status           String    @default("Appointed") // Appointed|Onboarded (Employee dibuat)
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  offer         CandidateOffer       @relation(fields: [offerId], references: [id])
  candidate     JobCandidate        @relation("CandidateAppointments", fields: [candidateId], references: [id])
  pr            PersonnelRequisition @relation("PrAppointments", fields: [prId], references: [id])
  position      Position?           @relation("ApptPosition", fields: [positionId], references: [id])
  orgUnit       OrgUnit?            @relation("ApptOrgUnit", fields: [orgUnitId], references: [id])
  companyOffice CompanyOffice?      @relation("ApptOffice", fields: [companyOfficeId], references: [id])
  workLocation  WorkLocation?       @relation("ApptLocation", fields: [workLocationId], references: [id])
  supervisor    Employee?          @relation("ApptSupervisor", fields: [supervisorId], references: [id])
  employee      Employee?          @relation("ApptEmployee", fields: [employeeId], references: [id])

  @@index([prId])
  @@index([employeeId])
}

// ============================================================================
// RECRUITMENT — F5: ESS, RENCANA & ANGGARAN, DEMOGRAFI
// (DEVELOPMENT-PLAN-RECRUITMENT.md §7 F5 + analisa §2.1/§2.2/§2.10)
//
// RecruitmentPlan (ringkas): baris per [period, seqNo, posisi, kantor] dengan
// formula a–h — (a) target awal, (b) penyesuaian, (c)=(a)+(b) total
// target, (d) jumlah karyawan awal (bisa di-sync headcount Employee aktif),
// (e) rekrut/masuk, (f) turnover/keluar, (g)=(d)+(e)−(f) hasil, (h)=(c)−(g)
// kebutuhan rekrut — c/g/h dihitung SERVICE saat baca (bukan kolom).
// Rekonsiliasi PR: requested/fulfilled/unfulfilled dari PersonnelRequisition
// + CandidateAppointment yang match posisi (+kantor). salaryBudget = uang
// TERENKRIPSI vault (enc:v1:n:…) — decrypt di serializer (moneyVisible).
// Status Draft|Applied (tombol Apply — Applied = dasar justifikasi PR).
// ============================================================================

model RecruitmentPlan {
  id              String    @id @default(cuid())
  period          String // label periode, mis. "2026" / "2026-Q1"
  seqNo           Int       @default(1) // urutan tampil per periode
  positionId      String? // posisi master (opsional — boleh posisi bebas)
  positionTitle   String // judul posisi (snapshot — match rekonsiliasi PR)
  companyOfficeId String? // kantor (opsional — filter headcount & rekonsiliasi)
  targetA         Int       @default(0) // (a) target headcount awal
  adjustB         Int       @default(0) // (b) penyesuaian (+/−)
  empD            Int       @default(0) // (d) jumlah karyawan awal — sync headcount
  inE             Int       @default(0) // (e) rekrut / transfer masuk
  outF            Int       @default(0) // (f) turnover / transfer keluar
  salaryBudget    String? // TERENKRIPSI vault uang — total anggaran upah
  basePeriod      String? // periode basis pembanding
  status          String    @default("Draft") // Draft|Applied
  note            String?
  appliedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  position      Position?      @relation("PlanPosition", fields: [positionId], references: [id])
  companyOffice CompanyOffice? @relation("PlanOffice", fields: [companyOfficeId], references: [id])

  // PLAN-LINK — PR yang secara eksplisit melayani rencana ini
  prs           PersonnelRequisition[] @relation("PlanPrs")

  @@index([period])
  @@index([status])
}

// Anggaran rekrutmen per periode (§2.2): total + penyesuaian (vault);
// realisasi (used) TIDAK disimpan — dihitung agregat dari actualCost
// JobOpeningMethod pada JO periode tsb (ringkas dua level: per JO + per PR
// di dalam JO — lihat planning-service getBudget).
model RecruitmentBudget {
  id          String   @id @default(cuid())
  period      String   @unique // "2026"
  totalBudget String // TERENKRIPSI vault uang (enc:v1:n:…)
  adjust      String? // TERENKRIPSI vault uang — penyesuaian (+/−)
  currency    String   @default("IDR")
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Lamaran karyawan internal ke slot lowongan (MyEmpAppliedJob-
// Opportunity §2.10): jejak ESS apply → JobCandidate source Internal (jalur
// F3 — steps otomatis); withdraw menandai tarik diri + kandidat Withdrawn.
model EmpJobApplication {
  id           String    @id @default(cuid())
  employeeId   String
  jobOpeningId String
  candidateId  String? // JobCandidate hasil nominasi internal (reuse bila ada)
  appliedAt    DateTime  @default(now())
  withdrawnAt  DateTime? // null = lamaran aktif
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee    Employee       @relation("EmpJobApplied", fields: [employeeId], references: [id])
  jobOpening  JobOpening     @relation("EmpJobApplications", fields: [jobOpeningId], references: [id])
  candidate   JobCandidate? @relation("EmpJobApplicationCandidate", fields: [candidateId], references: [id])

  @@unique([employeeId, jobOpeningId])
  @@index([employeeId])
  @@index([jobOpeningId])
}

// ============================================================================
// RECRUITMENT — F6: AI INTELLIGENCE (DEVELOPMENT-PLAN-RECRUITMENT.md §7 F6 +
// §4.3 — HRX Modul B; semua explainable per P2 + fallback manual D7)
//
// Aturan §2.4 mengikat: semua panggilan AI WAJIB lewat ai-provider.ts
// (aiComplete); mode hasil selalu eksplisit "ai"|"simulated" (D7 — tidak
// pernah memalsukan); skor = REKOMENDASI, keputusan tetap manusia.
//
// • KnockoutQuestion (B3): pertanyaan objektif per slot lowongan — dievaluasi
//   saat apply (form publik/portal); jawaban ApplicationAnswer (per lamaran).
// • CvParseResult (B1): hasil parsing CV → fieldsJson {field:{value,
//   confidence}} + verifikasi manusia (verifiedBy/At) → pre-fill form
//   pelamar (UI F6).
// • CandidateAiScore (B2): skor 0–100 + factorsJson [{factor, weight,
//   contribution, evidence}] — snapshot rubrik saat generate (rubricJson di
//   PersonnelRequisition — no-code per PR).
// ============================================================================

// Pertanyaan knockout per slot (HRX B3 — hanya pertanyaan OBJEKTIF, mis.
// "Bersedia ditempatkan di Bandung?"). Gagal knockout = auto-disposition
// (staging Rejected/auto + surat penolakan ramah + audit — service F6).
model KnockoutQuestion {
  id            String    @id @default(cuid())
  jobOpeningId String
  question      String
  expectedValue String // jawaban yang diharapkan (string/bool "Ya"/"Tidak")
  mode          String    @default("Equals") // Equals|Contains|NotEquals
  active        Boolean   @default(true)
  orderNo       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobOpening JobOpening        @relation("OpeningKnockouts", fields: [jobOpeningId], references: [id], onDelete: Cascade)
  answers    ApplicationAnswer[] @relation("KnockoutAnswers")

  @@index([jobOpeningId])
}

// Jawaban pertanyaan knockout per lamaran (disimpan utk audit — HRX B3).
model ApplicationAnswer {
  id            String    @id @default(cuid())
  applicationId String
  questionId    String
  answer        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application ApplicantApplication @relation("ApplicationAnswers", fields: [applicationId], references: [id], onDelete: Cascade)
  question    KnockoutQuestion     @relation("KnockoutAnswers", fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
}

// Hasil parsing CV (HRX B1) — mode: "ai" (model nyata via ai-provider),
// "simulated" (ekstraksi heuristik regex — berlabel), "manual" (input tangan).
// fieldsJson: {fullName:{value,confidence}, email:…, phone:…, city:…,
// birthDate:…, education:[…], experiences:[…], skills:[…], expectedSalary:…}.
// Human-verify: UI pre-fill form pelamar dari hasil ini; koreksi disimpan
// ulang (verifiedBy/verifiedAt menandai sudah dicek manusia).
model CvParseResult {
  id           String    @id @default(cuid())
  applicantId  String
  sourceKind   String // pdf|docx|txt|paste
  storagePath  String? // jejak file sumber (bila dari ApplicantDocument)
  fieldsJson   String
  mode         String // ai|manual|simulated
  model        String? // nama model (mode ai) — null utk simulated
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  applicant   Applicant  @relation("ApplicantCvParses", fields: [applicantId], references: [id], onDelete: Cascade)
  verifiedBy  Employee? @relation("CvParseVerifier", fields: [verifiedById], references: [id])

  @@index([applicantId])
}

// Skor AI explainable per kandidat (HRX B2) — histori; total 0–100.
// factorsJson: [{factor, weight, score, contribution, evidence}] — evidence
// = kutipan bukti dari CV/profil (P2: tidak ada black-box).
model CandidateAiScore {
  id            String   @id @default(cuid())
  candidateId   String
  rubricJson    String // snapshot rubrik saat generate ([{name,weight,guide}])
  total         Float
  factorsJson   String
  mode          String // ai|manual|simulated
  model         String?
  generatedAt   DateTime @default(now())
  generatedById String

  candidate   JobCandidate @relation("CandidateAiScores", fields: [candidateId], references: [id], onDelete: Cascade)
  generatedBy Employee    @relation("AiScoreGenerator", fields: [generatedById], references: [id])

  @@index([candidateId, generatedAt])
}

// ============================================================================
// RECRUITMENT — F7: OTOMASI, INTEGRASI & E-SIGN (DEVELOPMENT-PLAN-RECRUITMENT.md
// §7 F7 — HRX F1-lite/F3-lite/E2/H3; semua config-over-code P6)
//
// • WebhookEndpoint + WebhookDelivery: webhook outbound — HMAC-SHA256 +
//   idempotency key + retry backoff + DLQ (DB-backed queue, tanpa middleware
//   baru — pola §2.1). Event: pr.approved, application.received,
//   candidate.hired, offer.accepted (+ "*" semua).
// • NotificationPref: preferensi notifikasi per karyawan (in-app/email/digest
//   harian) — HRX F3 notification hub versi ringkas.
// • RecruitmentSetting: key-value konfigurasi otomasi rekrutmen (auto-reply,
//   auto-reminder, eskalasi SLA) + nanti aturan retensi F9 — config-over-code.
// • EsignRequest: e-sign RINGKAS utk KANDIDAT EKSTERNAL (HRX E2 — tanpa akun):
//   OTP email + typed signature + hash PDF tamper-evident + audit. Halaman
//   tanda tangan di PORTAL KANDIDAT (aplikasi terpisah — Amandemen 1 §2.0),
//   API publik aplikasi utama sebagai backend. (Karyawan internal tetap pakai
//   mesin SignatureRecord RSA-PSS Task 80 — berbeda alur.)
// ============================================================================

// Endpoint webhook outbound per tenant.
model WebhookEndpoint {
  id         String   @id @default(cuid())
  url        String // https://hooks.example.com/rk
  eventsJson String // ["pr.approved","offer.accepted","*"]
  secretEnc  String // TERENKRIPSI field-crypto — HMAC secret (jangan plaintext)
  active     Boolean  @default(true)
  note       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([active])
}

// Antrean kirim (DB-backed queue + retry + DLQ). status: Pending|Success|Failed|Dead.
model WebhookDelivery {
  id          String    @id @default(cuid())
  endpointId  String
  event       String // pr.approved | application.received | candidate.hired | offer.accepted
  payloadJson String
  status      String    @default("Pending")
  attempts    Int       @default(0)
  nextRetryAt DateTime? // null = segera; backoff 5m/30m/2h/8h/24j lalu Dead
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
}

// Preferensi notifikasi per karyawan (hub ringkas F7).
model NotificationPref {
  id         String   @id @default(cuid())
  employeeId String   @unique
  inApp      Boolean  @default(true)
  email      Boolean  @default(true)
  digest     Boolean  @default(false) // ringkasan harian (07:00)
  updatedAt  DateTime @updatedAt

  employee Employee @relation("NotificationPrefEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
}

// Konfigurasi rekrutmen key-value (otomasi F7 + retensi F9). Default dibaca
// service bila baris tidak ada (auto.reply.public-application=true dsb.).
model RecruitmentSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Permintaan tanda tangan kandidat eksternal (e-sign ringkas).
model EsignRequest {
  id             String    @id @default(cuid())
  token          String    @unique // token URL portal /sign/<token> (random 32 byte)
  letterId       String? // RecruitmentLetter (surat offer/pengangkatan)
  offerId        String? // CandidateOffer (jejak cepat)
  purpose        String // offer|appointment
  signerName     String // nama kandidat (harus diketik persis saat menandatangani)
  signerEmailEnc String // TERENKRIPSI — tujuan OTP
  status         String    @default("Pending") // Pending|Signed|Expired|Cancelled
  otpHash        String // hash OTP (scrypt — pola challenge Task 80)
  otpExpiresAt   DateTime
  typedName      String? // nama yang diketik kandidat (bukti typed signature)
  pdfSha256      String? // hash PDF surat saat ttd — tamper-evident baseline
  requestedById  String
  signedAt       DateTime?
  expiresAt      DateTime // masa berlaku link (default 7 hari)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  letter       RecruitmentLetter? @relation("EsignLetter", fields: [letterId], references: [id], onDelete: SetNull)
  offer        CandidateOffer?   @relation("EsignOffer", fields: [offerId], references: [id], onDelete: SetNull)
  requestedBy  Employee         @relation("EsignRequester", fields: [requestedById], references: [id])

  @@index([status])
}

// ============================================================================
// RECRUITMENT — F8: ANALYTICS & PREDIKTIF (DEVELOPMENT-PLAN-RECRUITMENT.md
// §7 F8 — HRX G; A2/B7 antarmuka MetricSnapshot disiapkan, ML = backlog)
//
// • MetricSnapshot: nilai metrik per periode (YYYY | YYYY-MM | YYYY-Q) +
//   dimsJson ({"office":"BDG","source":"Referral"}) — fondasi historis untuk
//   proyeksi & (kelak) ML. Di-upsert job scheduler harian (unique per
//   metric+period+dims) — pola §2.1 tanpa middleware baru.
// • SavedReportView: "saved views" laporan rekrutmen (G3) — filter tersimpan
//   per user + opsi jadwal ringkasan mingguan via email (ringkas).
// ============================================================================

model MetricSnapshot {
  id          String   @id @default(cuid())
  metric      String // time_to_fill | offer_acceptance_rate | interview_pass_rate | source_effectiveness | requisition_aging | cost_per_hire | ...
  period      String // "2026" | "2026-10" | "2026-Q4"
  dimsJson    String? // {"position":"Accountant","source":"Referral"}
  value       Float
  computedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([metric, period, dimsJson])
  @@index([metric, period])
}

// Tampilan laporan tersimpan (G3) — milik karyawan (ownerId).
model SavedReportView {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  view        String // reports|applicants|selection|...
  filtersJson String // parameter filter (pr, periode, sumber, dst.)
  schedule    String    @default("none") // none|weekly — ringkasan email mingguan
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner Employee @relation("SavedReportViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// ============================================================================
// RECRUITMENT — F9: COMPLIANCE HARDENING UU PDP (DEVELOPMENT-PLAN-RECRUITMENT.md
// §7 F9 — HRX I; No. 27/2022)
//
// • DataSubjectRequest (DSR): permintaan subjek data pelamar — akses /
//   ekspor / hapus — dengan SLA (dueAt 7 hari), penanganan ter-audit, dan
//   resultNote berisi jejak paket/tindakan.
// • Consent ledger & retensi memakai model yang sudah ada: ApplicantConsent
//   (withdrawal = withdrawnAt — F2) + RecruitmentSetting (retention.*) — F7.
// ============================================================================

model DataSubjectRequest {
  id          String    @id @default(cuid())
  // F9-REC: DSR pelamar (applicantId) — P9-PERF: DSR KARYAWAN (employeeId,
  // data kinerja §7.3 UU PDP). SALAH SATU terisi; keduanya null = data rusak.
  applicantId String?
  employeeId  String?
  type        String // Access | Export | Erase — pelamar (F9) & karyawan data kinerja (P9 §7.3)
  status      String    @default("New") // New | InProgress | Completed | Rejected
  note        String? // permintaan/klarifikasi dari pelamar/karyawan (via HR)
  dueAt       DateTime // SLA (default +7 hari)
  handledById String? // Employee penangan
  handledAt   DateTime?
  resultNote  String? // ringkasan tindakan (paket diunduh / data dianonimkan / alasan tolak)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applicant Applicant? @relation("ApplicantDsr", fields: [applicantId], references: [id], onDelete: Cascade)
  employee  Employee? @relation("EmployeeDsr", fields: [employeeId], references: [id], onDelete: SetNull)
  handledBy Employee? @relation("DsrHandler", fields: [handledById], references: [id])

  @@index([status, dueAt])
  @@index([applicantId])
  @@index([employeeId])
}

// ============================================================================
// PERFORMANCE — P0 Fondasi Modul & Master
// (DEVELOPMENT-PLAN-PERFORMANCE.md §15 — 20 model; AM1+AM2+AM3 termuat:
// versioning pustaka KpiDefinition/Competency §18.9, provenance salinan
// §18.2, kolom AI-assist §18.11, snapshot manager §8-10, bukti tarikan
// otomatis autoValueJson §16/§18.6)
// Konvensi: cuid PK, enum String + komentar daftar nilai, uang nominal =
// String vault terenkripsi (enc:v1:…), relasi eksplisit bernama, @@index
// pada semua FK + filter utama.
// ============================================================================

// ===== MASTER (P0) =====
model PerformanceSetting {
  id             String   @id @default(cuid())
  docPrefixes    String   @default("PER|PRB|PIP|MER") // penomoran per jenis dokumen
  defWeights     String   @default("70|20|10") // wKPI|wKomp|wCore default
  appealDays     Int      @default(7) // jendela banding setelah publikasi
  retentionYears Int      @default(5) // retensi arsip hasil
  // B1-BL (D-BL2) — mode OKR kuartalan per-tenant, default OFF.
  okrEnabled     Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model KpiDefinition {
  // pustaka KPI per tenant (starter pack BSC ±40 di-seed P0)
  id             String    @id @default(cuid())
  code           String
  name           String
  category       String // Financial | Customer | InternalProcess | LearningGrowth (BSC §3.4)
  polarity       String // Higher | Lower | Boolean
  unit            String // "%|Rp|hari|unit|…"
  dataSource      String    @default("Manual") // Manual | Attendance | Payroll | Recruitment | Leave
  sourceKey      String? // binding data otomatis, mis. "attendance_presence_pct"
  description    String?
  active         Boolean   @default(true)
  // AM2 §18.9 — versioning pustaka: ubah definisi tahun ini tanpa merusak
  // data tahun lalu (lapis-2 di atas snapshot baris penilaian)
  versionNo      Int       @default(1) // 1, 2, 3 … per code
  effectiveYear  Int // tahun mulai berlaku versi ini
  status         String    @default("Active") // Active | Superseded | Archived
  supersededById String? // id versi pengganti (jejak)
  changeNote     String? // catatan apa yang berubah (audit HR)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  appraisalKpis AppraisalKpi[]

  @@unique([code, versionNo])
  @@index([category, active])
  @@index([status])
}

model Competency {
  // kompetensi + deskriptor 5 level (anchor perilaku anti-halo §8)
  id             String    @id @default(cuid())
  code           String
  name           String
  kind           String // CoreValue | Managerial | Technical
  levelsJson     String // [{level:1..5, label, descriptor}] — deskriptor perilaku per level
  active         Boolean   @default(true)
  // AM2 §18.9 — versioning pustaka (sama seperti KpiDefinition)
  versionNo      Int       @default(1)
  effectiveYear  Int
  status         String    @default("Active") // Active | Superseded | Archived
  supersededById String?
  changeNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  appraisalCompScores AppraisalCompetencyScore[]
  feedback360Answers  Feedback360Answer[]

  @@unique([code, versionNo])
  @@index([kind, active])
  @@index([status])
}

model RatingScale {
  // skala konversi skor→rating (dapat dikustom per tenant)
  id        String  @id @default(cuid())
  value     Int     @unique // 1..5
  labelId   String // "Sangat Baik"
  labelEn   String // "Outstanding"
  minScore  Float   @unique // 90|80|70|60|0
  color     String // emerald|… (token warna UI)
  guideline String? // panduan deskriptor kapan diberikan
}

model PerformanceTemplate {
  // template bobot & komponen per kelompok jabatan
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  weightsJson String // {kpi:70, competency:20, core:10}
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PerformanceTemplateItem[]
}

model PerformanceTemplateItem {
  id         String  @id @default(cuid())
  templateId String
  kind       String // Kpi | Competency
  refId      String // KpiDefinition.id | Competency.id
  weight     Float // bobot dalam komponennya; Σ per kind = 100
  template   PerformanceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  // refId POLIMORFIK (kind menentukan target: KpiDefinition | Competency) —
  // FK DB tunggal tidak mungkin; integritas dijaga service layer (pola seragam
  // dengan referensi dokumen lintas-modul).

  @@index([templateId])
}

// ===== SIKLUS & PENILAIAN (P1–P4) =====
model PerformanceCycle {
  id          String    @id @default(cuid())
  code        String    @unique // PER-2026 (tahunan) / PER-2026-H1
  name        String
  cycleType   String    @default("Annual") // Annual | MidYearOnly | OffCycle
  periodStart DateTime
  periodEnd   DateTime
  // jendela fase (digerbangkan; null = fase dilewati)
  goalStart   DateTime?
  goalEnd     DateTime?
  midStart    DateTime?
  midEnd      DateTime?
  selfStart   DateTime?
  selfEnd     DateTime?
  mgrStart    DateTime?
  mgrEnd      DateTime?
  calibStart  DateTime?
  calibEnd    DateTime?
  publishAt   DateTime?
  weightsJson String // override bobot default untuk siklus ini
  feedback360 Boolean   @default(false) // aktifkan 360 pada siklus ini
  status      String    @default("Draft") // Draft|GoalSetting|Ongoing|Assessment|Calibration|Published|Closed
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  appraisals AppraisalRecord[]
  sessions   CalibrationSession[]
  probations ProbationEvaluation[]

  @@index([status, periodEnd])
}

model AppraisalRecord {
  // 1 baris per karyawan per siklus (peserta)
  id              String    @id @default(cuid())
  docNo           String    @unique // PER-2026-0001
  cycleId         String
  employeeId      String
  managerId       String? // snapshot atasan penilai saat enroll (§8-10)
  templateId      String?
  goalsCopiedFrom String? // AM1 §18.2 — kode siklus sumber salinan KPI (chip UI)
  // skor — semua null sampai fase terkait; dihitung server (§16)
  kpiTotalWeight Float?
  selfScore       Float?
  managerScore    Float?
  finalScore      Float? // pasca kalibrasi
  finalRating     Int? // 1..5
  potentialBand   Int? // 1..3 (isi saat kalibrasi — bahan 9-box)
  status          String    @default("Enrolled")
  // Enrolled|GoalProposed|GoalApproved|Ongoing|SelfDone|ManagerDone|Calibrating|Finalized|Published|Appealed|Closed
  acknowledgedAt  DateTime?
  appealNote     String?
  appealStatus   String? // Submitted|Rejected|Adjusted|Withdrawn
  appealDecidedBy String?
  appealDecidedAt DateTime?
  // P9-PERF — retensi arsip (§37; job perf-retention-scan menandai data melewati
  // jendela retensi; PENGHAPUSAN PERMANEN TIDAK OTOMATIS — keputusan eksplisit HR).
  archivedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cycle        PerformanceCycle @relation(fields: [cycleId], references: [id])
  employee     Employee         @relation("PerfEmployee", fields: [employeeId], references: [id])
  manager      Employee?        @relation("PerfManager", fields: [managerId], references: [id])
  kpis         AppraisalKpi[]
  comps        AppraisalCompetencyScore[]
  checkins     CheckIn[]
  f360         Feedback360[]
  calibrations CalibrationDecision[]
  merit        MeritRecommendation?
  pips         PipPlan[]

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([cycleId, status])
}

model AppraisalKpi {
  // KPI yang dinilai utk satu appraisal — SNAPSHOT definisi (§18.9 lapis-1)
  id            String   @id @default(cuid())
  appraisalId   String
  kpiDefId      String? // dari pustaka ATAU free-text (usulan karyawan)
  title         String
  polarity      String
  unit          String
  thresholdMin  Float? // ambang gagal (F)
  target        Float // target (T)
  stretchValue  Float? // opsional — skor bisa sampai 120
  weight        Float // Σ per appraisal = 100
  isCritical    Boolean  @default(false) // gagal Boolean kritis = otomatis rating ≤2 (§4.5)
  dataSource    String   @default("Manual")
  autoValueJson String? // hasil tarikan otomatis (sumber+periode+nilai) — bukti
  midActual     Float? // checkpoint tengah tahun (progress)
  finalActual   Float?
  evidenceJson  String? // [{type:"attachment",id}|{type:"note",text}] — bukti per KPI
  proposedBy    String   @default("Manager") // Manager|Employee (mode MBO §3.2)
  // AM1 §18.2 — provenance baris (jejak salin antar-periode)
  origin        String   @default("Fresh") // Fresh|Template|CopiedFromCycle|EmployeeProposal
  copiedFromId  String? // id AppraisalKpi sumber (bila origin=CopiedFromCycle)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appraisal  AppraisalRecord @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  kpiDef     KpiDefinition? @relation(fields: [kpiDefId], references: [id])

  @@index([appraisalId])
}

model AppraisalCompetencyScore {
  // nilai kompetensi oleh penilai (bukan 360)
  id            String  @id @default(cuid())
  appraisalId   String
  competencyId  String
  score         Int // 1..5 (dinilai saat fase manager; self saat fase self)
  selfScore     Int?
  comment       String?
  // AM3 §18.11 — ulasan & flag AI assist (audit internal)
  selfComment    String? // ulasan self-assessment per kompetensi (bisa disusun AI dari poin)
  aiAssisted     Boolean @default(false) // komentar atasan disusun dgn bantuan AI lalu diedit
  selfAiAssisted Boolean @default(false) // flag utk selfComment

  appraisal   AppraisalRecord @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  competency  Competency      @relation(fields: [competencyId], references: [id])

  @@unique([appraisalId, competencyId])
}

model CheckIn {
  // 1-on-1 terdokumentasi (fase Do §2)
  id             String   @id @default(cuid())
  appraisalId    String
  heldAt         DateTime
  agenda         String?
  notesJson      String // {wins:[], blockers:[], next:[]} — ringkas & terstruktur
  managerComment String?
  nextCheckInAt  DateTime?
  status         String   @default("Planned") // Planned|Held|Missed
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appraisal AppraisalRecord @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  @@index([appraisalId, heldAt])
}

model Feedback360 {
  // undangan reviewer 360 (opsional per siklus)
  id           String    @id @default(cuid())
  appraisalId  String
  reviewerId   String // Employee id
  reviewerType String // Peer|Subordinate|CrossTeam|Upward
  status       String    @default("Invited") // Invited|Submitted|Declined|Expired
  dueAt        DateTime?
  submittedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appraisal AppraisalRecord     @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  reviewer Employee             @relation("PerfReviewer", fields: [reviewerId], references: [id])
  answers   Feedback360Answer[]

  @@unique([appraisalId, reviewerId, reviewerType])
}

model Feedback360Answer {
  id            String  @id @default(cuid())
  feedbackId    String
  competencyId  String
  score         Int // 1..5
  comment       String? // ditampilkan HANYA ter-agregasi ≥3 reviewer (§37)
  aiAssisted    Boolean @default(false) // AM3 §18.11 — anonimitas 360 tetap utuh
  // B2-BL (D-BL7/D-BL9) — moderasi bias: flag menempel pada ANSWER (anonimitas
  // reviewer utuh). flaggedJson = [{category, phrase}]; moderated:
  // Pending|Approved|Redacted (NULL = legacy pra-B2 / bersih → dianggap Approved)
  flaggedJson   String?
  moderated     String?

  feedback    Feedback360 @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  competency Competency  @relation(fields: [competencyId], references: [id])

  @@index([feedbackId, competencyId])
  @@index([moderated])
}

model CalibrationSession {
  // forum penyetaraan standar antar atasan
  id              String   @id @default(cuid())
  cycleId         String
  orgUnitId       String? // lingkup diskusi
  heldAt          DateTime
  participantsJson String // [employeeId…] hadir
  chairId         String? // ketua (kepala unit)
  notes           String?
  createdAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cycle     PerformanceCycle      @relation(fields: [cycleId], references: [id])
  decisions CalibrationDecision[]

  @@index([cycleId])
}

model CalibrationDecision {
  // SETIAP perubahan hasil ter-audit (§7.2)
  id            String   @id @default(cuid())
  sessionId     String
  appraisalId   String
  oldScore      Float?
  newScore      Float?
  oldRating     Int?
  newRating     Int?
  potentialBand Int? // isi/ubah 9-box band di sini
  reason        String // WAJIB — alasan kalibrasi
  decidedBy     String
  decidedAt     DateTime  @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session    CalibrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  appraisal  AppraisalRecord  @relation(fields: [appraisalId], references: [id])

  @@index([appraisalId])
}

// ===== KONSEKUENSI (P5–P7) =====
model MeritMatrix {
  // matriks rating → % bonus & % kenaikan
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  gridJson  String // {5:{bonusMonths:2,raisePct:[8,12]},3:{…},…} + catatan kebijakan
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recommendations MeritRecommendation[]
}

model MeritRecommendation {
  // usulan per karyawan pasca-publikasi
  id                String    @id @default(cuid())
  docNo             String    @unique // MER-2026-0001
  appraisalId       String    @unique
  matrixId          String?
  bonusMonths       Float?
  bonusAmount       String? // VAULT terenkripsi (enc:v1:…)
  raisePct          Float?
  raiseAmount       String? // VAULT
  note              String?
  status            String    @default("Draft") // Draft|Submitted|Approved|Rejected|Applied|Cancelled
  personnelActionId String? // PA SalaryAdjustment/Promotion yang digulirkan
  appliedRunNo      String? // PayrollRun yang menyerap (bukti penerapan)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  appraisal  AppraisalRecord @relation(fields: [appraisalId], references: [id])
  matrix     MeritMatrix?    @relation(fields: [matrixId], references: [id])
}

model PipPlan {
  // Program Perbaikan Kinerja 30/60/90
  id           String    @id @default(cuid())
  docNo        String    @unique // PIP-2026-0001
  employeeId   String
  appraisalId  String? // asal (rating ≤2) — bisa null (kasus khusus)
  startDate    DateTime
  endDate      DateTime // 1–3 bulan (register §23 D7)
  targetsJson  String // [{title, metric, target, weight}] — mini-KPI PIP
  reviewerId   String // atasan pembina
  hrAdvisorId  String?
  status       String    @default("Draft") // Draft|Active|Extended|Recovered|NotRecovered|Cancelled
  outcomeNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee    Employee         @relation("PipEmployee", fields: [employeeId], references: [id])
  appraisal   AppraisalRecord? @relation(fields: [appraisalId], references: [id])
  reviewer    Employee        @relation("PipReviewer", fields: [reviewerId], references: [id])
  checkpoints PipCheckpoint[]

  @@index([employeeId, status])
}

model PipCheckpoint {
  // evaluasi berkala PIP
  id              String    @id @default(cuid())
  pipId           String
  seq             Int // 1..3 (≈30/60/90 hari)
  dueDate         DateTime
  achievementPct  Float?
  notes           String?
  status          String    @default("Pending") // Pending|Reviewed
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pip PipPlan @relation(fields: [pipId], references: [id], onDelete: Cascade)

  @@unique([pipId, seq])
}

model ProbationEvaluation {
  // evaluasi masa percobaan (dari onboarding)
  id                String    @id @default(cuid())
  docNo             String    @unique // PRB-2026-0001
  employeeId        String
  onboardingId      String? // otomatis saat hire dari rekrutmen
  cycleId           String? // siklus penilaian tempat dia terdaftar
  dueDate           DateTime // H+3bln joinDate (maks! §7.1)
  criteriaJson      String // kriteria ringkas [{title, weight}] + kompetensi terpilih
  managerScore      Float?
  hrNote            String?
  recommendation    String? // Confirm|Extend|Terminate
  decisionDate      DateTime?
  personnelActionId String? // PA yang digulirkan (ChangeStatus/ExtendProbation/Termination)
  status            String    @default("Open") // Open|Assessed|Recommended|Decided|Cancelled
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee  Employee          @relation("ProbEmployee", fields: [employeeId], references: [id])
  cycle     PerformanceCycle? @relation(fields: [cycleId], references: [id])

  @@index([employeeId, status])
  @@index([dueDate])
}

// B1-BL — OKR kuartalan (DEVELOPMENT-PLAN-BACKLOG.md D-BL1…D-BL5): alat
// transparansi tujuan TERPISAH dari mesin penilaian — TIDAK menyentuh
// AppraisalRecord/skor/rating/merit (D-BL1). Ritme kuartalan "YYYY-Qn"
// (D-BL2), per-tenant default OFF via PerformanceSetting.okrEnabled.
model OkrObjective {
  id              String    @id @default(cuid())
  quarter         String // "2026-Q1" — ^\d{4}-Q[1-4]$ (kuartal, bukan siklus tahunan)
  title           String
  ownerEmployeeId String // pemilik objective (karyawan)
  alignToId       String? // pohon dukungan — align ke objective lain (1 level cukup)
  status          String    @default("Draft") // Draft|Posted|Closed (D-BL3)
  weight          Int       @default(100) // Σ KR weight = 100 per objective (D-BL5)
  closedScore     Float? // skor final 0.00–1.00 saat Closed (server otoritatif — D-BL5)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner         Employee        @relation("OkrOwner", fields: [ownerEmployeeId], references: [id])
  alignParent   OkrObjective?   @relation("OkrAlign", fields: [alignToId], references: [id], onDelete: SetNull)
  alignChildren OkrObjective[]  @relation("OkrAlign")
  keyResults    OkrKeyResult[]

  @@index([quarter, status])
  @@index([ownerEmployeeId])
}

model OkrKeyResult {
  id          String    @id @default(cuid())
  objectiveId String
  title       String
  unit        String // "%|Rp|hari|unit|…"
  polarity    String    @default("HigherIsBetter") // HigherIsBetter|LowerIsBetter (D-BL5)
  baseline    Float
  target      Float
  current     Float     @default(0)
  weight      Int       @default(20) // Σ per objective = 100 (D-BL5)
  confidence  String    @default("Yellow") // Red|Yellow|Green — subjektif pemilik, beda dari skor
  note        String? // update progres ringan (bukan check-in formal)
  updatedById String? // pencatat progres terakhir (owner/HR)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  objective OkrObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  updatedBy Employee?    @relation("OkrUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([objectiveId])
}

// B4-BL — SUCCESSION PLANNING (DEVELOPMENT-PLAN-BACKLOG.md §4 B4; D-BL13…D-BL15):
// register peran kritis per Position + kandidat penerus. Kandidat di-seed dari
// penempatan 9-box siklus Published/Closed TERAKHIR per karyawan (finalRating ×
// potentialBand — D-BL13); readiness = keputusan MANUAL HR di atas saran sistem
// (ReadyNow|Ready1yr|Ready23yr|Development). suggested9Box = snapshot string
// saran saat kandidat ditambahkan (mis. "4/5 — Bintang"; label sel ID kanonik
// sama seperti laporan pf43); flightRisk = snapshot skor heuristik D-BL10 saat
// ditambahkan (refresh on-demand). devNotes = aksi pengembangan TEKS murni —
// BUKAN modul training (D-BL14).
model SuccessionPosition {
  id               String   @id @default(cuid())
  positionId       String   @unique
  critical         Boolean  @default(true)
  targetSuccessors Int      @default(2)
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  position   Position            @relation("SuccessionPosition", fields: [positionId], references: [id])
  candidates SuccessorCandidate[]
}

model SuccessorCandidate {
  id                   String   @id @default(cuid())
  successionPositionId String
  employeeId           String
  readiness            String // ReadyNow|Ready1yr|Ready23yr|Development (keputusan manual HR — D-BL13)
  suggested9Box        String? // snapshot saran saat ditambahkan (mis. "4/5 — Bintang")
  flightRisk           Float? // skor heuristik D-BL10 saat ditambahkan (refresh on-demand)
  devNotes             String? // aksi pengembangan — TEKS (D-BL14, BUKAN modul training)
  addedById            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  successionPosition SuccessionPosition @relation(fields: [successionPositionId], references: [id], onDelete: Cascade)
  employee           Employee           @relation("SuccessorEmployee", fields: [employeeId], references: [id])

  @@unique([successionPositionId, employeeId])
  @@index([employeeId])
}

// B5-BL — benchmark gaji pasar (DEVELOPMENT-PLAN-BACKLOG.md §4 B5; D-BL16/D-BL17).
// Data eksternal manual HR (impor survei XLSX ≤500 baris / CRUD): p25/p50/p75
// per tahun × sumber; kunci A = gradeCode (cocokkan grade assignment karyawan)
// ATAU kunci B = positionId (lebih spesifik — keduanya nullable tapi TEPAT
// SATU terisi; guard "kunci tunggal" di service). unique 3-kolom nullable
// berperilaku NULL-distinct di PG → guard duplikat null-aware 409 di SERVICE.
model SalaryBenchmark {
  id          String   @id @default(cuid())
  year        Int
  sourceLabel String // "Survei XX 2026" — sumber manual HR (D-BL16)
  gradeCode   String? // kunci A: cocokkan berdasar Grade
  positionId  String? // kunci B: cocokkan berdasar Position (lebih spesifik)
  currency    String   @default("IDR")
  p25         Float
  p50         Float
  p75         Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  position Position? @relation("SalaryBenchmarkPosition", fields: [positionId], references: [id])

  @@unique([year, sourceLabel, gradeCode, positionId])
  @@index([year, gradeCode])
}
