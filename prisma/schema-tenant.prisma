  name        String
  scope       String   @default("External") // Internal | External | Both
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // F2-REC — kanal biaya per JobOpportunity (JobOpeningMethod.method)
