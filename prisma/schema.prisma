// RekanKerja — PLATFORM schema (PostgreSQL, schema "public")
// Registry SaaS multi-tenant: data tenant (domain HRIS) TIDAK di sini —
// tiap tenant punya PostgreSQL schema sendiri (tenant_<slug>, didefinisikan
// di prisma/schema-tenant.prisma). File ini hanya data platform:
// tenant registry, user SaaS (login), dan membership role per tenant.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/platform"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DB_URL")
}

// ============ TENANT REGISTRY ============

model Tenant {
  id          String   @id @default(cuid())
  name        String // nama workspace/organisasi (bebas)
  companyCode String? // kode perusahaan (A-Z0-9) — diinput saat registrasi; dipakai prefix nomor karyawan & tampilan workspace
  slug        String   @unique // identitas pendek (subdomain-ready)
  schemaName  String   @unique // nama PostgreSQL schema, mis. tenant_nusantara
  plan        String   @default("trial") // trial | starter | growth | enterprise
  status      String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships UserTenant[]
}

// ============ SAAS USER (login platform, bukan AppUser domain) ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String // scrypt: salt+hash (node:crypto)
  isSuperadmin Boolean  @default(false)
  // Lockout login (Task 33): hitungan percobaan gagal + kunci sementara.
  // Batas & durasi dikonfigurasi per tenant (PasswordPolicy) — default 5x/15m.
  failedAttempts Int     @default(0)
  lockedUntil    DateTime?
  // Revokasi sesi server-side (T1-SECURITY): payload token membawa versi ini;
  // naikkan versi (logout / ganti sandi) → semua token lama otomatis invalid.
  sessionVersion Int     @default(0)
  // MFA TOTP (T17-MFA): secret base32 terenkripsi at-rest (AES-256-GCM, kunci
  // diturunkan dari SESSION_SECRET — lihat src/rekankerja/shared/lib/auth.ts) +
  // status aktif. Login 2-langkah: bila totpEnabled, password benar → token
  // MFA short-lived 5 menit; cookie hanya di-set setelah kode 6 digit benar.
  totpSecret    String?
  totpEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships UserTenant[]
}

model UserTenant {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("OWNER") // OWNER | ADMIN | HR | VIEWER
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
}

// ============ SUPPORT SERVICE — LAYANAN BERBAYAR (FEAT-SUPPORT-P5) ============
// Ketentuan layanan: Online Support adalah layanan ADD-ON berbayar yang
// diaktifkan per-tenant OLEH PEMILIK APLIKASI (PlatformAdmin) lewat
// modul Platform Admin. TIDAK ADA API tenant yang bisa mengubah tabel ini —
// tenant admin (OWNER/ADMIN membership) pun tidak bisa menyentuhnya.

/// IDENTITAS PEMILIK APLIKASI — realm MANDIRI di public schema (P5-SEC).
/// Sama sekali TIDAK terhubung dengan: User platform (dipakai login tenant
/// + membership UserTenant), maupun AppUser tenant. Pemilik aplikasi TIDAK
/// PERLU menjadi anggota tenant mana pun; kredensial & sesinya terpisah
/// penuh (lihat shared/lib/platform-session.ts). Pemisahan inilah yang
/// membuat akun tenant yang dikompromikan TIDAK PERNAH bisa mencapai konsol
/// platform — dan sebaliknya.
model PlatformAdmin {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  /// scrypt salt+hash — pola sama dgn User (hashPassword/verifyPassword auth.ts)
  passwordHash   String
  active         Boolean   @default(true)
  /// Lockout login (pola User): 5 percobaan gagal → kunci 15 menit.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  /// Revokasi sesi server-side: token membawa versi ini; logout menaikkan
  /// versi → semua cookie sesi platform lama otomatis tidak sah.
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Status aktivasi layanan support per tenant — sumber kebenaran gate.
model SupportEntitlement {
  id               String    @id @default(cuid())
  tenantId         String    @unique // → Tenant.id (tanpa relasi FK — biar simpel)
  /// INACTIVE (belum aktif/default) | TRIAL (uji coba) | ACTIVE (berlangganan) | SUSPENDED (ditangguhkan — tunggakan/denda)
  status           String    @default("INACTIVE")
  /// Kuota giliran AI per bulan kalender (0 = tanpa batas — kontrak enterprise)
  monthlyTurnQuota Int       @default(0)
  /// Catatan komersial pemilik aplikasi (nomor PO, tanggal invois, dsb.)
  notes            String?
  activatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Provider AI KHUSUS layanan support — milik platform, melayani SEMUA tenant
/// yang layanannya aktif. TERPISAH TOTAL dari provider AI per-tenant
/// (AiProviderConfig di schema tenant): kredensial tenant tidak pernah dipakai
/// untuk support, dan biaya support terpusat di platform ( satu tagihan).
/// Satu baris (findFirst) — konfigurasi global.
model SupportProviderConfig {
  id        String   @id @default(cuid())
  /// builtin (LLM bawaan RekanKerja — default) | openai (endpoint OpenAI-compatible milik platform)
  provider  String   @default("builtin")
  /// API key TERENKRIPSI at-rest AES-256-GCM (kunci dari SESSION_SECRET — pola TOTP auth.ts); format "v1:iv:tag:ct"
  apiKey    String?
  baseUrl   String?
  model     String?
  enabled   Boolean  @default(true)
  /// Harga provider utk estimasi biaya (USD per 1 juta token) — diisi pemilik aplikasi
  priceInPerM  Float  @default(0)
  priceOutPerM Float  @default(0)
  updatedAt DateTime @updatedAt
}

/// Log pemakaian SATU GILIRAN agent support (atribusi biaya & penagihan per
/// tenant). Satu baris per balasan AI yang selesai (bukan per panggilan LLM
/// internal — langkah ReAct diringkas llmSteps).
model SupportUsageLog {
  id        String   @id @default(cuid())
  tenantId  String
  ticketNo  String
  llmSteps  Int      @default(0) // jumlah panggilan LLM dalam giliran (1-14)
  tokensIn  Int      @default(0) // total token masuk (estimasi bila provider tak melaporkan)
  tokensOut Int      @default(0) // total token keluar
  provider  String   @default("builtin")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// FEAT-SUPPORT-P8 — setelan konsol platform (key-value sederhana, satu baris
/// per kunci). Dipakai antara lain fitur Sinkron Git: "github.autopush" =
/// "true" → setiap patch yang DISETUJUI langsung di-commit & di-push ke GitHub.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// FEAT-SUPPORT-P8 — riwayat sinkronisasi git (push/pull) oleh pemilik
/// aplikasi dari konsol platform, termasuk auto-push pasca-persetujuan
/// patch. Audit lengkap: aksi apa, cabang, pesan, hasil per-remote (token
/// kredensial SELALU dimask sebelum disimpan), oleh siapa, kapan.
model GithubSyncLog {
  id        String   @id @default(cuid())
  /// PUSH | PULL | AUTO_PUSH
  action    String
  /// OK | GAGAL
  status    String
  branch    String   @default("")
  /// pesan commit (push) / nama remote (pull)
  message   String   @default("")
  /// ringkasan hasil per-remote / pesan error (sudah dimask)
  detail    String   @default("")
  byName    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// FEAT-SUPPORT-P7.1 — notifikasi ke konsol pemilik aplikasi (feed "Bug &
/// Patch"). Pemicu: agent mengonfirmasi BUG prioritas TINGGI/KRITIS, atau
/// agent mengajukan usulan patch (MENUNGGU keputusan). Ditulis best-effort
/// dari giliran agent (kegagalan TIDAK boleh menggagalkan balasan AI).
model PlatformAlert {
  id         String    @id @default(cuid())
  /// BUG_CONFIRMED | PATCH_PROPOSED
  type       String
  tenantId   String
  tenantName String
  ticketNo   String
  /// "<tenantId>:<ticketId>" — kunci dedup alert yang belum dibaca
  ticketRef  String
  subject    String
  priority   String    @default("")
  message    String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([readAt])
  @@index([ticketRef])
}
