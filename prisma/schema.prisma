// RekanKerja — PLATFORM schema (PostgreSQL, schema "public")
// Registry SaaS multi-tenant: data tenant (domain HRIS) TIDAK di sini —
// tiap tenant punya PostgreSQL schema sendiri (tenant_<slug>, didefinisikan
// di prisma/schema-tenant.prisma). File ini hanya data platform:
// tenant registry, user SaaS (login), dan membership role per tenant.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/platform"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DB_URL")
}

// ============ TENANT REGISTRY ============

model Tenant {
  id          String   @id @default(cuid())
  name        String // nama workspace/organisasi (bebas)
  companyCode String? // kode perusahaan (A-Z0-9) — diinput saat registrasi; dipakai prefix nomor karyawan & tampilan workspace
  slug        String   @unique // identitas pendek (subdomain-ready)
  schemaName  String   @unique // nama PostgreSQL schema, mis. tenant_nusantara
  plan        String   @default("trial") // trial | starter | growth | enterprise
  status      String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships UserTenant[]
}

// ============ SAAS USER (login platform, bukan AppUser domain) ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String // scrypt: salt+hash (node:crypto)
  isSuperadmin Boolean  @default(false)
  // Lockout login (Task 33): hitungan percobaan gagal + kunci sementara.
  // Batas & durasi dikonfigurasi per tenant (PasswordPolicy) — default 5x/15m.
  failedAttempts Int     @default(0)
  lockedUntil    DateTime?
  // Revokasi sesi server-side (T1-SECURITY): payload token membawa versi ini;
  // naikkan versi (logout / ganti sandi) → semua token lama otomatis invalid.
  sessionVersion Int     @default(0)
  // MFA TOTP (T17-MFA): secret base32 terenkripsi at-rest (AES-256-GCM, kunci
  // diturunkan dari SESSION_SECRET — lihat src/rekankerja/shared/lib/auth.ts) +
  // status aktif. Login 2-langkah: bila totpEnabled, password benar → token
  // MFA short-lived 5 menit; cookie hanya di-set setelah kode 6 digit benar.
  totpSecret    String?
  totpEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships UserTenant[]
}

model UserTenant {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("OWNER") // OWNER | ADMIN | HR | VIEWER
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
}
